<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>M64Valvetrain</AssemblyName>
    <RootNamespace>M64Valvetrain</RootNamespace>
    <!-- Same convention as ShortBlock.csproj and the station's
         /opt/m64-source/HeadVoxels.csproj: resolve the PicoGK kernel from a
         local checkout, overridable. Inside picogk-station this resolves to
         /upstream/PicoGK/PicoGK.csproj. -->
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">/upstream</UpstreamRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(UpstreamRoot)/PicoGK/PicoGK.csproj" />
  </ItemGroup>
</Project>
