<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PicoGK993Batch</AssemblyName>
    <RootNamespace>PicoGK993Batch</RootNamespace>
    <!-- Same convention as ShortBlock.csproj and HeadVoxels.csproj: resolve the
         pinned PicoGK kernel from a local checkout, overridable. -->
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">/upstream</UpstreamRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <ProjectReference Include="$(UpstreamRoot)/PicoGK/PicoGK.csproj" />
  </ItemGroup>
</Project>
