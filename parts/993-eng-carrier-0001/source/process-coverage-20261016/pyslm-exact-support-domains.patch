+def _triangulate_exact_projected_domain(polygon, maximum_area):
+    """Preserve all rings; conformingly split only triangle interiors to the existing area limit."""
+    vertices, faces = trimesh.creation.triangulate_polygon(polygon, engine='earcut')
+    vertices, inverse = np.unique(vertices, axis=0, return_inverse=True)
+    faces = inverse[faces]
+    used = np.unique(faces)
+    remap = np.full(len(vertices), -1, dtype=np.int64)
+    remap[used] = np.arange(len(used))
+    vertices, faces = vertices[used], remap[faces]
+    original_vertices = vertices.copy()
+    refinements = 0
+    while True:
+        points = vertices[faces]
+        areas = np.abs(np.cross(points[:, 1] - points[:, 0], points[:, 2] - points[:, 0])) / 2
+        large = areas > maximum_area
+        if not np.any(large):
+            break
+        old = faces[large]
+        indices = np.arange(len(vertices), len(vertices) + len(old))
+        vertices = np.vstack([vertices, vertices[old].mean(axis=1)])
+        children = np.stack([np.column_stack([old[:, 0], old[:, 1], indices]),
+                             np.column_stack([old[:, 1], old[:, 2], indices]),
+                             np.column_stack([old[:, 2], old[:, 0], indices])], axis=1).reshape(-1, 3)
+        faces = np.vstack([faces[~large], children])
+        refinements += 1
+        if len(faces) > 2000000:
+            raise ValueError("Projected-domain triangulation exceeded its face budget")
+    triangles = shapely.polygons(vertices[faces])
+    triangulated_area = float(shapely.area(triangles).sum())
+    difference_area = polygon.symmetric_difference(shapely.ops.unary_union(triangles)).area
+    tolerance = 64 * np.finfo(float).eps * max(1.0, polygon.area) * max(1, len(faces))
+    if (abs(triangulated_area - polygon.area) > tolerance or difference_area > tolerance or
+            not np.array_equal(vertices[:len(original_vertices)], original_vertices)):
+        raise ValueError("Projected-domain triangulation changed the exact polygon")
+    receipt = dict(engine='mapbox-earcut then conforming interior-centroid subdivisions',
+                   vertices=len(vertices), triangles=len(faces), source_polygon_area_mm2=polygon.area,
+                   triangulated_area_mm2=triangulated_area, symmetric_difference_area_mm2=difference_area,
+                   numerical_area_tolerance_mm2=tolerance, max_triangle_area_mm2=float(areas.max()),
+                   area_limit_mm2=maximum_area, refinement_steps=refinements,
+                   original_vertices_unchanged=True, boundary_vertex_displacement_mm=0.0)
+    return (vertices, faces), receipt
+
