+def _boolean64(meshA, meshB, operation):
+    """Use Manifold's native double-precision interface; preserve input coordinates."""
+    import manifold3d
+    solids = [manifold3d.Manifold(manifold3d.Mesh64(
+        vert_properties=np.array(mesh.vertices, dtype=np.float64, order='C', copy=True),
+        tri_verts=np.array(mesh.faces, dtype=np.uint64, order='C', copy=True))) for mesh in (meshA, meshB)]
+    if any(solid.status() != manifold3d.Error.NoError for solid in solids):
+        raise ValueError("Manifold Mesh64 rejected a Boolean input")
+    result = {'union': lambda: solids[0] + solids[1],
+              'intersection': lambda: solids[0] ^ solids[1],
+              'difference': lambda: solids[0] - solids[1]}[operation]()
+    if result.status() != manifold3d.Error.NoError:
+        raise ValueError("Manifold Mesh64 Boolean failed")
+    mesh = result.to_mesh64()
+    return trimesh.Trimesh(vertices=mesh.vert_properties[:, :3], faces=mesh.tri_verts, process=False)
