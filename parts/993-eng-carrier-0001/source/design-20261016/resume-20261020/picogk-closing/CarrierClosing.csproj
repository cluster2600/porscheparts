<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PicoGK"><HintPath>$(PicoGKRuntime)/PicoGK.dll</HintPath></Reference>
    <Reference Include="SkiaSharp"><HintPath>$(PicoGKRuntime)/SkiaSharp.dll</HintPath></Reference>
    <None Include="$(PicoGKRuntime)/*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
