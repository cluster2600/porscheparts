<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LeapRoot Condition="'$(LeapRoot)' == ''">$(HOME)/Developer/PicoGK</LeapRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LeapRoot)/libraries/LEAP71_ShapeKernel/ShapeKernel/**/*.cs" />
    <Compile Include="$(LeapRoot)/libraries/LEAP71_LatticeLibrary/LatticeLibrary/**/*.cs" />
    <Reference Include="PicoGK"><HintPath>$(LeapRoot)/runtime/PicoGK.dll</HintPath></Reference>
    <Reference Include="SkiaSharp"><HintPath>$(LeapRoot)/runtime/SkiaSharp.dll</HintPath></Reference>
    <None Include="$(LeapRoot)/runtime/**/*.dylib" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
