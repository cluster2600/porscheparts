<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Compile items are listed explicitly below; net9.0 SDK default globbing
         would duplicate them (NETSDK1022, seen in picogk-station:qualified-final-20260928). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ChargeAir</AssemblyName>
    <RootNamespace>M64DigitalTwin.ChargeAir</RootNamespace>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">/upstream</UpstreamRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ChargeAirParameters.cs" />
    <Compile Include="ChargeAirGeometry.cs" />
    <ProjectReference Include="$(UpstreamRoot)/PicoGK/PicoGK.csproj" />
  </ItemGroup>
</Project>
