<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>PicoGKCatalog.Runner</StartupObject>
    <!-- Pinned PicoGK kernel from a local checkout (containers/m64-leap71/sources.lock). -->
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">/upstream</UpstreamRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../common/*.cs" />
    <Compile Include="*.cs" />
    <ProjectReference Include="$(UpstreamRoot)/PicoGK/PicoGK.csproj" />
  </ItemGroup>
</Project>