FoamFile
{
    format          ascii;
    class           dictionary;
    location        "system";
    object          fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    Phi
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-08;
        relTol          0.01;
    }
    p
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-08;
        relTol          0.01;
    }
    "(U|h|k|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.1;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 3;
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;
    residualControl
    {
        p               1e-05;
        U               1e-05;
        "(k|epsilon|h)" 1e-05;
    }
}

relaxationFactors
{
    fields
    {
        p               0.2;
        rho             0.005;
    }
    equations
    {
        U               0.2;
        h               0.02;
        "(k|epsilon)"   0.5;
    }
}


