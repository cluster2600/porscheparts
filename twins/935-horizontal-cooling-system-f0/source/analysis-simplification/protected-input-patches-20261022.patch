+using EdgeConstraints = Mesh::Property_map<Mesh::Edge_index, bool>;
+
+std::size_t protect_input_sampling(Mesh& mesh, EdgeConstraints constrained) {
+    std::vector<unsigned char> selected(num_vertices(mesh), 0);
+    std::size_t poor = 0;
+    for (auto face : faces(mesh)) {
+        auto h = halfedge(face, mesh);
+        const std::array<Mesh::Vertex_index, 3> v{source(h,mesh), target(h,mesh), target(next(h,mesh),mesh)};
+        if (triangle_quality(mesh.point(v[0]),mesh.point(v[1]),mesh.point(v[2])) < .05) {
+            ++poor;
+            for (auto vertex : v) selected[vertex.idx()] = 1;
+        }
+    }
+    if (!poor) return 0;
+    // Retain local input sampling around inherited poor facets before collapsing elsewhere.
+    for (int ring = 0; ring < 3; ++ring) {
+        auto expanded = selected;
+        for (auto edge : edges(mesh)) {
+            auto h = halfedge(edge, mesh);
+            const auto a = source(h,mesh).idx(), b = target(h,mesh).idx();
+            if (selected[a] || selected[b]) expanded[a] = expanded[b] = 1;
+        }
+        selected.swap(expanded);
+    }
+    for (auto edge : edges(mesh)) {
+        auto h = halfedge(edge, mesh);
+        if (selected[source(h,mesh).idx()] || selected[target(h,mesh).idx()])
+            put(constrained, edge, true);
+    }
+    return poor;
 }

