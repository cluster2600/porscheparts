<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="PicoGK">
      <HintPath>$(PicoGKAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequirePicoGK" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PicoGKAssembly)')" Text="Supply -p:PicoGKAssembly=/private/path/PicoGK.dll" />
  </Target>
</Project>
