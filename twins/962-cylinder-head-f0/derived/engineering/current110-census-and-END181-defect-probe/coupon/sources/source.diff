+        for _, _, gradients, weight in hex_rule([geometry[node] for node in conn]):
+            B = numpy.zeros((6,24), dtype=numpy.float64)
+            for a, (gx,gy,gz) in enumerate(gradients):
+                B[0,3*a] = gx; B[1,3*a+1] = gy; B[2,3*a+2] = gz
