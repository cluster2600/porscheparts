        "text": "                        audit.close(math.fsum(geometry[n][(j+1)%3]*v[(j+2)%3] - geometry[n][(j+2)%3]*v[(j+1)%3] for n, v in zip(sorted(active_nodes), force_rows)), 0., 'moment_Nm')"
