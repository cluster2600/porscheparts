+def expanded_from_prior(prior,first_seeds,first_cells,first_nodes,interior_tags,boundary_count):
+ """One explicit expansion of the reconstructed first star; never recursive."""
+ s=prior['complete_seed_star_census']
+ if (prior.get('status')!='direct_saved_file_readback_completed' or prior.get('bound_inputs_unchanged') is not True
+     or s.get('schema')!='962-complete-current-poor-seed-stars/v1'
+     or s.get('all_seed_stars_complete_including_initially_good_and_shared_cells') is not True
+     or first_seeds!=sorted(set(first_seeds)) or first_seeds!=s['movable_node_tags']
+     or interior_tags!=sorted(set(interior_tags))
+     or any(type(t) is not int or t<=boundary_count for t in interior_tags)):
+  raise ValueError('Exact prior complete-star proof and freshly classified interior tags required')
+ expected=s['complete_incident_tetrahedra'];nodes=s['unique_incident_nodes']
+ if (len(first_cells)!=len(expected) or len(first_nodes)!=len(nodes)
+     or [row[0] for row in first_cells]!=sorted(set(row[0] for row in first_cells))
+     or [row[0] for row in first_nodes]!=sorted(set(row[0] for row in first_nodes))):
+  raise ValueError('Complete ordered first-star cell/node rows required')
+ members=set();seeds=set(first_seeds)
+ for (tag,row,q),saved in zip(first_cells,expected):
+  if (type(tag) is not int or tag<=0 or len(row)!=4 or len(set(row))!=4
+      or any(type(t) is not int or t<=0 for t in row) or not seeds.intersection(row)
+      or type(q) not in (int,float) or not math.isfinite(q) or q<=0
+      or tag!=saved['tetrahedron_tag'] or row!=saved['node_tags'] or q!=saved['initial_native_SICN']):
+   raise ValueError('Reconstructed first-star oriented cells/native values differ from prior')
+  members.update(row)
+ if members!={row[0] for row in first_nodes}:raise ValueError('First-star coordinate union must be complete')
+ interior=set(interior_tags)
+ for (tag,xyz),saved in zip(first_nodes,nodes):
+  boundary=tag<=boundary_count
+  if (type(tag) is not int or tag<=0 or len(xyz)!=3
+      or any(type(x) not in (int,float) or not math.isfinite(x) for x in xyz)
+      or tag!=saved['node_tag'] or [float(x).hex() for x in xyz]!=saved['binary64_hex']
+      or saved['in_movable_seed_set'] is not (tag in seeds) or saved['source_boundary_tag'] is not boundary
+      or saved['freshly_proved_classification_scope']!=('below_dim3' if boundary else 'dim3')
+      or (not boundary and tag not in interior)):
+   raise ValueError('Reconstructed first-star coordinate bits/fresh classification differ')
+ expanded=sorted(members & interior)
+ saved_expanded=[row['node_tag'] for row in nodes if not row['source_boundary_tag']]
+ if expanded!=saved_expanded or not seeds<=set(expanded):raise ValueError('Exact prior interior union required')
+ return expanded
 
 
