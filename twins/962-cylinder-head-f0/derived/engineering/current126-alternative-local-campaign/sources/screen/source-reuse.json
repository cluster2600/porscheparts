      "new": " def test_exact31_cohort_excludes_rejections_held_and_stale_indices(self):\n  m=module();seeds=sorted(m.ALTERNATIVE_APICES+m.REJECTED_APICES+[m.HELD_APEX])\n  history=dict(prospective_alternative_pool={'apex_tags':list(m.ALTERNATIVE_APICES)},prior_history={'current_apices_with_prior_local_quality_rejection':list(m.REJECTED_APICES),'held_apex1393275_no_retry':True})\n  prior=sorted(m.REJECTED_APICES+[m.HELD_APEX]+list(range(3000000,3000047)))\n  manifest={'cases_in_increasing_apex_order':[{'apex':t} for t in prior]}\n  self.assertEqual(m.alternative_cohort(seeds,history,manifest),m.ALTERNATIVE_APICES)\n  for badseeds in [seeds[:-1],sorted(seeds+[1613031]),seeds[::-1]]:\n   with self.assertRaises(ValueError):m.alternative_cohort(badseeds,history,manifest)\n  bad=deepcopy(history);bad['prior_history']['held_apex1393275_no_retry']=False\n  with self.assertRaises(ValueError):m.alternative_cohort(seeds,bad,manifest)\n  bad=deepcopy(manifest);bad['cases_in_increasing_apex_order'][0]['apex']=m.ALTERNATIVE_APICES[0]\n  with self.assertRaises(ValueError):m.alternative_cohort(seeds,history,bad)\n  c=tiny_census();c['complete_seed_star_census']['complete_incident_tetrahedra'][0]['native_array_index']=2\n  with self.assertRaises(ValueError):m.census_rows(c,3,3)\n\n"
