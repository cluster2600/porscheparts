<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>PicoGKCatalog.Runner</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../parts/picogk-catalog/common/*.cs" />
    <Compile Include="../../../../parts/picogk-catalog/engine/*.cs" />
    <Reference Include="PicoGK"><HintPath>$(PicoGKBinaryRoot)/PicoGK.dll</HintPath></Reference>
    <Reference Include="SkiaSharp"><HintPath>$(PicoGKBinaryRoot)/SkiaSharp.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequirePinnedBinary" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PicoGKBinaryRoot)/PicoGK.dll')" Text="Set PicoGKBinaryRoot to the retained, hash-verified F0 runtime directory." />
  </Target>
</Project>
