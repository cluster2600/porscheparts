  "criteria": [
    {
      "id": "V01",
      "verdict": "conditional_macro_architecture",
      "finding": "Cell-only front/rear views identify a central cell. The assembly distinguishes separate nominal wheel cylinders and unattached front/rear reservations; these are not engineered modules."
    },
    {
      "id": "V02",
      "verdict": "conditional_macro_architecture",
      "finding": "Paired dished floor bays and four raised seat-support spans are visible in top/inside views. X350 and X900 expose different floor/support contours; support seating, restraint attachments and manufactured joint integrity are not established."
    },
    {
      "id": "V03",
      "verdict": "partial",
      "finding": "Tunnel shoulders and height change along the cell. Four transverse cuts and the Y0 cut expose an intended service volume, but finite sections and the 15 recorded void probes do not prove continuous usable clearance or donor linkage/driveline accommodation."
    },
    {
      "id": "V04",
      "verdict": "conditional_macro_architecture",
      "finding": "Deep varying sills have recessed entry returns, a flat lower silhouette and shaped ends. Literal cuts show their hollow profile. The two failed canonical closure-material observations remain unresolved; no sealed physical section is admitted."
    },
    {
      "id": "V05",
      "verdict": "conditional_macro_architecture",
      "finding": "The shaped scuttle/front wall and raked A-foot regions visibly meet the lower cell. The images do not establish laminate continuity or a qualified finite-area structural joint."
    },
    {
      "id": "V06",
      "verdict": "conditional_macro_architecture",
      "finding": "Raked upper sides, windshield header, B hoop and rear braces form readable intended paths into the lower architecture. Their carbon material, manufacturing route and mechanical coupling remain assumptions."
    },
    {
      "id": "V07",
      "verdict": "conditional_macro_architecture",
      "finding": "Raised rear shoulders and curved rear transition are visible in rear/inside views and X1750/Y0 cuts. No rear module, measured attachment or engineered load transfer is supplied."
    },
    {
      "id": "V08",
      "verdict": "conditional_nominal_package_only",
      "finding": "The corrected per-axle package is explicitly labelled and the complete cell is visible. Both source samplings and native bounds fit the declared static envelope. This does not establish native tyre clearance, continuous CAD clearance, loaded tyre size, travel, steering, axle-to-cell registration or fitment."
    },
    {
      "id": "V09",
      "verdict": "partial_native_quality_rejected",
      "finding": "The literal slices expose intended walls and voids but are thin contour diagnostics, not full wall/junction acceptance. All 36 collapsed native faces remain; the original STL also has 21 nonfinite facet normals. Native embedding, material continuity, both failed closure probes and continuous service clearance remain unresolved."
    },
    {
      "id": "V10",
      "verdict": "diagnostic_presentation_only",
      "finding": "All ten required roles are covered by eleven actual images. Corrected top/inside framing is complete, captions disclose the rejected quality state, and no production hardware is invented. These CPU VTK images may document an unqualified study; they do not fully pass the visual architecture contract or establish native Omniverse execution."
    }
  ],
