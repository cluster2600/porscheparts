#usda 1.0

over "Monocoque"
{
    over "Presentation"
    {
        over "Front"
        {
            float horizontalAperture = 36
            float verticalAperture = 22.5
        }
        over "Rear"
        {
            float horizontalAperture = 36
            float verticalAperture = 22.5
        }
        over "Orbit"
        {
            float horizontalAperture = 36
            float verticalAperture = 22.5
        }
        over "Interior"
        {
            float horizontalAperture = 36
            float verticalAperture = 22.5
            float focalLength = 32
        }
    }
}
