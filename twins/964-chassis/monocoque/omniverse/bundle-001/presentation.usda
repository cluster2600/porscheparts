def "Render"
{
    def RenderProduct "Front"
    {
        rel camera = </Monocoque/Presentation/Front>
        rel orderedVars = </Render/Front/LdrColor>
        uniform int2 resolution = (1600, 1000)

        def RenderVar "LdrColor"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "LdrColor"
        }
    }

    def RenderProduct "Rear"
    {
        rel camera = </Monocoque/Presentation/Rear>
