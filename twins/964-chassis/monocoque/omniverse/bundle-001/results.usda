        }

        def Scope "Bending" (
            customData = {
                string loadCase = '{"K": "force / mean deflection of the loaded skin (N/mm)", "K_cabin": "force / sag at mid-wheelbase below the chord between d 400 and 1950 mm (N/mm)", "axles_d_mm": [-25.5, 2246.5], "force_N": 2000.0, "load": "downward, by area on the sill skin within +/-100 mm of mid-wheelbase", "support_strip_half_mm": 40.0, "supports": "torsion.supports() patches within the strip, vertical; rear pinned along the car, one node per side; one node per axle across"}'
                string material = "assumed_equivalent_isotropic_CFRP_not_layered_failure_model"
                string sourceReport = "bending.json"
                string sourceSha256 = "931561862877d92029059d5174e013bc5d72b371b43ff1fabcfd293ca32421c2"
            }
        )
        {
            custom bool study:meshConverged = 0
            custom double[] study:stiffness = [6422, 8862, 8828]
            custom string study:units = "N/mm"
        }
    }
}

