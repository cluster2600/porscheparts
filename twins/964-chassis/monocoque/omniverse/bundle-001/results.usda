            int vehicleMassKgAssumed = 1200
        }
    )
    {
        def Scope "Torsion" (
            customData = {
                string loadCase = '{"clamp": "d 2050-2450, z 450-720, |y| > 0.8 W", "force_N": 1000.0, "loads": "d -200..150, z 470-640, |y| > 0.72 W"}'
