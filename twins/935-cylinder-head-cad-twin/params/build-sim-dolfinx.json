  "element": "8-node hexahedron, 2 x 2 x 2 integration points",
  "plasticity": "von Mises, linear isotropic hardening, radial return",
  "temperature_of_a_cell": "the mean of its nodal temperatures, as CalculiX uses for its linear elements",
  "birth": "a cell is added strain free at the displacements and temperature of that moment",
  "increments_per_step": 2,
  "newton_stops_at": "1e-8 of the largest out-of-balance force seen"
 },
 "linear_solvers": {
  "mumps": "LU factorisation at every Newton iteration",
  "blr": "Cholesky factorisation with block low-rank compression (tolerance 1e-6) at the start of every increment, kept as the preconditioner of conjugate gradients (relative tolerance 1e-10) and made again when one solve takes more than 25 iterations",
  "gamg": "conjugate gradients on smoothed-aggregation multigrid with the six rigid motions as near-null space"
 },
