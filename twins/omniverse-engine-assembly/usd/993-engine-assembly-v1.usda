#usda 1.0
(
    defaultPrim = "EngineAssembly"
    metersPerUnit = 0.001
    upAxis = "Z"
    doc = "M64/60 whole-engine research layout. Status: research layout, not fitment. Every prim is a real documented asset reference or a labelled box proxy. Positions are engine-local layout hypotheses, not measured or fitted positions. See assembly-engine-v1.json for BOM line references and citations."
)

def Xform "EngineAssembly" (
    kind = "assembly"
    custom string m64:status = "research_layout_not_fitment"
    custom string m64:bomSource = "twins/m64-engine-system/bom/m64-bom-v1.json"
    custom string m64:coordinateFrame = "Engine-local frame hypothesis: origin at crankcase centre on the crankshaft axis; +X toward the flywheel/transmission face; +Y toward the right cylinder bank (cylinders along +/-Y); +Z up. Consistent with the manual Z-up convention of twins/catalogue-parts/usd/ assets."
    custom string m64:layoutStatus = "layout-hypothesis-engine-local: no common engine metrology frame exists (BOM fidelity_note), so every position is an arrangement hypothesis for loadable visual review, not a measured or fitted position."
    custom string[] m64:bomLinesUnrepresented = [
        "M64B-CS-002",
        "M64B-CY-001"
    ]
    custom string m64:bomCoverageUnrepresentedReasons = "{\"M64B-CS-002\": \"Intermediate shaft gear / balance drive: no local evidence record (all evidence fields missing, BOM sources list empty); a zero-evidence prim would add clutter without information, so the line is declared unrepresented here instead of marked in the scene.\", \"M64B-CY-001\": \"Cylinder barrels are represented inside the Crankcase zone by the CrankcaseHalvesMarker volume (CC-001): bore 100 is sourced but the skirt/case interface and fin pitch are unknown (M64-ACQ-0004), so a separate marker would imply a cylinder/case datum that does not exist.\"}"
    custom string[] m64:limitations = [
        "research layout, not fitment: positions are engine-local arrangement hypotheses, no interface, clearance or collision is asserted",
        "every real asset reference resolves to an F1 documentary proxy mesh, not measured component geometry",
        "box proxies are bounding envelopes from vendor-declared or manual-registered data, not shapes",
        "no part in this scene is dimensionally accurate, fitted, tested, safe or released (BOM status line)",
        "envelope-unknown markers carry arbitrary sizes so zones stay visually present without overclaiming",
        "F0 research assembly work/... assets from assembly-f0.json (valves, internals, turbo envelopes) are missing locally and are represented here as envelope-unknown or BOM-cited proxies, not as references to missing files"
    ]
)
{
    def Scope "Crankcase" (
        kind = "group"
        custom string m64:zoneId = "M64-Z-CC"
        custom string m64:zoneCoverage = "proxy+envelope-unknown"
        custom string m64:zoneLabel = "crankcase, cylinders, front covers, fasteners"
    )
    {
    def Xform "CrankcaseHalvesMarker" (
        custom string[] m64:bomLines = ["M64B-CC-001"]
        custom string m64:fidelity = "F0_reference"
        custom string m64:assetKind = "envelope_unknown"
        custom string m64:envelopeStatus = "envelope-unknown"
        custom string m64:positionStatus = "layout-hypothesis-engine-local"
        custom string m64:zone = "M64-Z-CC"
        custom string m64:sourceCitation = "twins/m64-engine-system/bom/m64-bom-v1.json M64B-CC-001 (dims missing; case pitch unknown, M64-ACQ-0004)"
        custom string m64:redesignInterest = "low"
        custom string m64:note = "marker_size_arbitrary; through-bolt torques sourced, envelope missing"
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Mesh "ProxyBox"
        {
            uniform bool doubleSided = true
            float3[] extent = [(-280, -220, -200), (280, 220, 200)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
            color3f[] primvars:displayColor = [(0.549, 0.431, 0.314)] (interp = "constant")
            uniform token purpose = "proxy"
            uniform token subdivisionScheme = "none"
            point3f[] points = [
                (-280, -220, -200),
                (280, -220, -200),
                (280, 220, -200),
                (-280, 220, -200),
                (-280, -220, 200),
                (280, -220, 200),
                (280, 220, 200),
                (-280, 220, 200)
            ]
        }
    }

