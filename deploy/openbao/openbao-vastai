def component_factory_f41_attempt_label() -> str:
    """Return a collision-resistant label that correlates one paid create call."""
    return (
        f"{COMPONENT_FACTORY_F41_LABEL}-"
        f"{secrets.token_hex(COMPONENT_FACTORY_F41_ATTEMPT_TOKEN_BYTES)}"
    )


def is_component_factory_f41_attempt_label(label: object) -> bool:
    """Accept only labels emitted by component_factory_f41_attempt_label()."""
    if not isinstance(label, str):
        return False
    prefix = f"{COMPONENT_FACTORY_F41_LABEL}-"
    if not label.startswith(prefix):
        return False
    token = label[len(prefix) :]
    expected_length = COMPONENT_FACTORY_F41_ATTEMPT_TOKEN_BYTES * 2
    return len(token) == expected_length and all(
        character in "0123456789abcdef" for character in token
    )


def is_component_factory_f41_family_label(label: object) -> bool:
    """Recognize legacy and per-attempt F41 labels for duplicate prevention."""
    return label == COMPONENT_FACTORY_F41_LABEL or is_component_factory_f41_attempt_label(
        label
    )


