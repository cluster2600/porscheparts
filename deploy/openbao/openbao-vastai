def verify_wave_ssh_ready(api_key: str, instance_id: int) -> None:
    """Prove BatchMode SSH and the exact F39 smoke marker before success."""
    validate_approved_ssh_private_key()
    last_state = "unknown"
    for _ in range(WAVE_SSH_READY_ATTEMPTS):
        try:
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
        except SafeError:
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        raw_instance = result.get("instances")
        if not isinstance(raw_instance, dict):
            raise SafeError("Vast.ai returned invalid F39 SSH endpoint metadata")
        instance = safe_instance(raw_instance)
        last_state = str(instance.get("status") or "unknown")
        if last_state != "running":
            if last_state not in {"created", "loading"}:
                raise SafeError(
                    f"F39 instance left running state before SSH smoke verification: {last_state}"
                )
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        host = instance.get("ssh_host")
        port = finite_number(instance.get("ssh_port"))
        if (
            not isinstance(host, str)
            or not host
            or len(host) > 253
            or any(
                character
                not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.:-"
                for character in host
            )
            or port is None
            or not port.is_integer()
            or not 1 <= port <= 65535
        ):
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        command = [
            "ssh",
            "-T",
            "-i",
            str(SSH_PRIVATE_KEY_FILE),
            "-o",
            "BatchMode=yes",
            "-o",
            "IdentitiesOnly=yes",
            "-o",
            "ConnectionAttempts=1",
            "-o",
            "ConnectTimeout=5",
            "-o",
            "StrictHostKeyChecking=accept-new",
            "-o",
            "LogLevel=ERROR",
            "-p",
            str(int(port)),
            f"root@{host}",
            wave_remote_smoke_command(),
        ]
        try:
            completed = subprocess.run(
                command,
                check=False,
                capture_output=True,
                text=True,
                timeout=20,
            )
        except FileNotFoundError as exc:
            raise SafeError("OpenSSH client is unavailable for F39 verification") from exc
        except subprocess.SubprocessError:
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        if completed.returncode == 0 and completed.stdout.strip() == "F39_REMOTE_READY":
            return
        time.sleep(POLL_INTERVAL_SECONDS)
    raise SafeError(
        "F39 SSH /workspace/READY and smoke verification did not pass in time "
        f"(last state: {last_state}); do not treat the instance as ready"
