def verify_single_simready_instance(
    api_key: str, instance_id: int, attempt_label: str
) -> None:
    if not is_simready_attempt_label(attempt_label):
        raise SafeError("SimReady attempt label is invalid")
    appeared = False
    stable_snapshots = 0
    for _ in range(30):
        existing = [
            instance
            for instance in strict_instance_inventory(api_key)
            if is_simready_family_label(instance.get("label"))
        ]
        ids = sorted(
            instance.get("id")
            for instance in existing
            if instance.get("label") == attempt_label
        )
        if len(existing) == 1 and ids == [instance_id]:
            appeared = True
            stable_snapshots += 1
            if stable_snapshots >= SIMREADY_SINGLETON_STABILITY_SNAPSHOTS:
                return
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        if existing:
            raise SafeError("SimReady post-launch uniqueness verification failed")
        if appeared:
            raise SafeError("SimReady family changed during singleton stability window")
        time.sleep(1)
    raise SafeError("the new SimReady instance did not appear in the paginated instance list")


