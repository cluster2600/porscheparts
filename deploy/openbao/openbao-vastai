def validate_component_factory_f41_known_hosts(path: Path, instance_id: int) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError as exc:
        raise SafeError("F41 scoped known_hosts was not written by OpenSSH") from exc
    if (
        info.st_uid != os.getuid()
        or not stat.S_ISREG(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_size <= 0
        or info.st_size > 64 * 1024
    ):
        raise SafeError("F41 scoped known_hosts has unsafe metadata or size")
    alias = component_factory_f41_host_key_alias(instance_id)
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as exc:
        raise SafeError("F41 scoped known_hosts cannot be read safely") from exc
    matches = []
    for line in lines:
        fields = line.split()
        if len(fields) < 3 or fields[0].startswith(("#", "@")):
            continue
        if alias in fields[0].split(","):
            matches.append(fields)
    if len(matches) != 1:
        raise SafeError("F41 scoped known_hosts does not contain exactly one expected alias")


