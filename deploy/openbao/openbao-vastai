class SafeError(Exception):
    """An error that is safe to print without secret material."""


class SafeHttpError(SafeError):
    """An HTTP status that callers may handle without exposing response data."""

    def __init__(self, source: str, status_code: int, detail: str = "") -> None:
        super().__init__(f"{source} rejected the request with HTTP {status_code}{detail}")
        self.status_code = status_code


class ComponentFactoryF41ProbeTimeout(Exception):
    """The bounded F41 SSH probe exceeded its absolute deadline."""


class ComponentFactoryF41ProbeOutputLimit(Exception):
    """The bounded F41 SSH probe exceeded one fixed stream limit."""


class ComponentFactoryF41ProbeSpawnError(Exception):
    """The local OpenSSH process could not be started safely."""


class ComponentFactoryF41ProbeLocalIoError(Exception):
    """The local bounded drain failed before the SSH probe completed."""


class ComponentFactoryF41ProbeCleanupError(Exception):
    """The isolated SSH process group could not be proven terminated."""


def validate_private_file(path: Path) -> None:
    try:
        info = path.stat()
    except FileNotFoundError as exc:
        raise SafeError(f"missing bootstrap file: {path}") from exc
    if info.st_uid != os.getuid() or not stat.S_ISREG(info.st_mode):
        raise SafeError(f"bootstrap file has unsafe ownership or type: {path}")
    if stat.S_IMODE(info.st_mode) != 0o600:
        raise SafeError(f"bootstrap file must have mode 0600: {path}")
    if info.st_size <= 0 or info.st_size > 4096:
        raise SafeError(f"bootstrap file has an invalid size: {path}")


def validate_bootstrap_metadata() -> None:
    try:
        info = CONFIG_DIR.stat()
    except FileNotFoundError as exc:
        raise SafeError(f"missing bootstrap directory: {CONFIG_DIR}") from exc
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise SafeError(f"bootstrap directory must be owned by this user with mode 0700: {CONFIG_DIR}")
    validate_private_file(ROLE_ID_FILE)
    validate_private_file(SECRET_ID_FILE)
    validate_private_file(SECRET_PATH_FILE)


def read_bootstrap_value(path: Path) -> str:
    value = path.read_text(encoding="utf-8").strip()
    if not value or len(value) > 4096:
        raise SafeError(f"bootstrap value is invalid: {path}")
    return value


def decode_json(body: bytes, source: str) -> dict:
    if len(body) > MAX_RESPONSE_BYTES:
        raise SafeError(f"{source} returned an unexpectedly large response")
    try:
        value = json.loads(body)
    except json.JSONDecodeError as exc:
        raise SafeError(f"{source} returned invalid JSON") from exc
    if not isinstance(value, dict):
        raise SafeError(f"{source} returned invalid JSON")
    return value


def http_json(
    url: str,
    *,
    method: str = "GET",
    payload: dict | None = None,
    headers: dict[str, str] | None = None,
    source: str,
) -> dict:
    data = None if payload is None else json.dumps(payload, separators=(",", ":")).encode("utf-8")
    request_headers = {"Content-Type": "application/json"}
    request_headers.update(headers or {})
    request = urllib.request.Request(url, data=data, headers=request_headers, method=method)
    if not TLS_CA_FILE.is_file():
        raise SafeError(f"missing system CA bundle: {TLS_CA_FILE}")
    tls_context = ssl.create_default_context(cafile=str(TLS_CA_FILE))
    try:
        with urllib.request.urlopen(
            request,
            timeout=TIMEOUT_SECONDS,
            context=tls_context,
        ) as response:
            body = response.read(MAX_RESPONSE_BYTES + 1)
    except urllib.error.HTTPError as exc:
        detail = ""
        if source == "Vast.ai":
            try:
                error_body = exc.read(MAX_RESPONSE_BYTES + 1)
                error_value = decode_json(error_body, source)
                candidate = error_value.get("msg", error_value.get("detail", error_value.get("error")))
                if isinstance(candidate, str) and 0 < len(candidate) <= 300:
                    detail = f": {candidate}"
            except SafeError:
                pass
        raise SafeHttpError(source, exc.code, detail) from None
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise SafeError(f"{source} is unavailable") from exc
    return decode_json(body, source) if body else {}


def check_local_service() -> None:
    try:
        with socket.create_connection(("127.0.0.1", 8200), timeout=2):
            pass
    except OSError as exc:
        raise SafeError("OpenBao is not listening on 127.0.0.1:8200") from exc


def login() -> str:
    validate_bootstrap_metadata()
    check_local_service()
    result = http_json(
        f"{BAO_ADDR}/v1/{BAO_AUTH_PATH}",
        method="POST",
        payload={
            "role_id": read_bootstrap_value(ROLE_ID_FILE),
            "secret_id": read_bootstrap_value(SECRET_ID_FILE),
        },
        source="OpenBao",
    )
    token = result.get("auth", {}).get("client_token")
    if not isinstance(token, str) or not token:
        raise SafeError("OpenBao AppRole login did not return a session token")
    return token


def revoke_token(token: str) -> None:
    try:
        http_json(
            f"{BAO_ADDR}/v1/auth/token/revoke-self",
            method="POST",
            payload={},
            headers={"X-Vault-Token": token},
            source="OpenBao",
        )
    except SafeError:
        pass


def read_vast_key(token: str) -> str:
    secret_path = read_bootstrap_value(SECRET_PATH_FILE)
    if not secret_path.startswith("secrets/data/") or any(
        character not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-/"
        for character in secret_path
    ):
        raise SafeError("OpenBao Vast.ai API path is invalid")
    result = http_json(
        f"{BAO_ADDR}/v1/{secret_path}",
        headers={"X-Vault-Token": token},
        source="OpenBao",
    )
    payload = result.get("data", {}).get("data")
    if not isinstance(payload, dict):
        raise SafeError("OpenBao Vast.ai path is missing or empty")
    for field in ("VAST_API_KEY", "api_key"):
        value = payload.get(field)
        if isinstance(value, str) and value.strip():
            return value.strip()
    raise SafeError("OpenBao Vast.ai payload is missing the API key field")


def vast_request(
    api_key: str,
    path: str,
    *,
    method: str = "GET",
    payload: dict | None = None,
) -> dict:
    return http_json(
        f"{VAST_BASE}{path}",
        method=method,
        payload=payload,
        headers={"Authorization": f"Bearer {api_key}"},
        source="Vast.ai",
    )


def fetch_execution_result(url: str) -> str:
    parsed = urllib.parse.urlparse(url)
    allowed_paths = ("/vast.ai/instance_logs/", "/public.vast.ai/instance_logs/")
    if (
        parsed.scheme != "https"
        or parsed.hostname != "s3.amazonaws.com"
        or not parsed.path.startswith(allowed_paths)
    ):
        safe_prefix = "/".join(parsed.path.split("/")[:4])
        raise SafeError(
            "Vast.ai returned an unexpected execution result location: "
            f"{parsed.hostname or 'missing'}{safe_prefix}"
        )
    tls_context = ssl.create_default_context(cafile=str(TLS_CA_FILE))
    request = urllib.request.Request(url, method="GET")
    for _ in range(8):
        try:
            with urllib.request.urlopen(
                request,
                timeout=TIMEOUT_SECONDS,
                context=tls_context,
            ) as response:
                body = response.read(MAX_RESPONSE_BYTES + 1)
            if len(body) > MAX_RESPONSE_BYTES:
                raise SafeError("Vast.ai execution result is unexpectedly large")
            return body.decode("utf-8", errors="replace")
        except urllib.error.HTTPError as exc:
            if exc.code not in {403, 404}:
                raise SafeError(f"Vast.ai execution result returned HTTP {exc.code}") from None
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            raise SafeError("Vast.ai execution result is unavailable") from exc
        time.sleep(2)
    raise SafeError("Vast.ai execution result was not ready in time")


def list_instances(api_key: str, *, label: str | None = None) -> list[dict]:
    """Read every v1 page and locally enforce an optional exact label."""
    instances: list[dict] = []
    after_token: str | None = None
    seen_tokens: set[str] = set()
    for _ in range(100):
        parameters: dict[str, str | int] = {"limit": 25}
        if label is not None:
            parameters["select_filters"] = json.dumps(
                {"label": {"eq": label}}, separators=(",", ":")
            )
        if after_token is not None:
            parameters["after_token"] = after_token
        result = vast_request(
            api_key,
            "/api/v1/instances/?" + urllib.parse.urlencode(parameters),
        )
        page = result.get("instances")
        if result.get("success") is not True or not isinstance(page, list):
            raise SafeError("Vast.ai instance list returned an invalid result")
        for instance in page:
            if not isinstance(instance, dict):
                raise SafeError("Vast.ai instance list contained invalid metadata")
            if label is None or instance.get("label") == label:
                instances.append(instance)
        candidate = result.get("next_token")
        if candidate is None:
            return instances
        if (
            not isinstance(candidate, str)
            or not candidate
            or len(candidate) > 4096
            or candidate in seen_tokens
        ):
            raise SafeError("Vast.ai instance pagination returned an invalid cursor")
        seen_tokens.add(candidate)
        after_token = candidate
    raise SafeError("Vast.ai instance pagination exceeded the safety limit")


def strict_instance_inventory(api_key: str) -> list[dict]:
    """Return a complete inventory only when every instance identity is strict."""
    instances = list_instances(api_key)
    seen_ids: set[int] = set()
    for instance in instances:
        instance_id = instance.get("id")
        if (
            not isinstance(instance_id, int)
            or isinstance(instance_id, bool)
            or instance_id <= 0
            or instance_id in seen_ids
        ):
            raise SafeError("Vast.ai strict inventory contains an invalid or duplicate id")
        seen_ids.add(instance_id)
        label = instance.get("label")
        if label is not None and not isinstance(label, str):
            raise SafeError("Vast.ai strict inventory contains a non-string label")
    return instances


@contextmanager
def simready_launch_lock():
    """Serialize project launches so two local callers cannot create duplicates."""
    directory = LAUNCH_LOCK_FILE.parent
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = directory.stat()
    if (
        info.st_uid != os.getuid()
        or not stat.S_ISDIR(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        raise SafeError(f"launch lock directory has unsafe ownership or type: {directory}")
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(LAUNCH_LOCK_FILE, flags, 0o600)
    try:
        lock_info = os.fstat(descriptor)
        if (
            lock_info.st_uid != os.getuid()
            or not stat.S_ISREG(lock_info.st_mode)
            or stat.S_IMODE(lock_info.st_mode) != 0o600
        ):
            raise SafeError("SimReady launch lock has unsafe ownership, type, or permissions")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise SafeError("another SimReady launch is already in progress") from exc
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


