def heavy_offer_eligible(offer: dict) -> bool:
    price = finite_number(offer.get("dph_total", offer.get("dph")))
    reliability = finite_number(offer.get("reliability", offer.get("reliability2")))
    floors = (
        (offer.get("gpu_ram"), HEAVY_MIN_GPU_RAM_MB),
        (offer.get("cpu_cores_effective"), HEAVY_MIN_CPU_CORES),
        (offer.get("cpu_ram"), HEAVY_MIN_CPU_RAM_MB),
        (offer.get("disk_space"), HEAVY_MIN_DISK_GB),
    )
    verified_value = offer.get("verified")
    rentable_value = offer.get("rentable")
    rented_value = offer.get("rented")
    verified = (
        verified_value is True
        or verified_value == 1
        or offer.get("verification") == "verified"
    )
    rentable = rentable_value is True or rentable_value == 1
    rented = rented_value is False or rented_value == 0
    return (
        offer.get("gpu_name") == HEAVY_GPU_NAME
        and finite_number(offer.get("num_gpus")) == 1.0
        and finite_number(offer.get("gpu_frac")) == 1.0
        and all((actual := finite_number(value)) is not None and actual >= minimum for value, minimum in floors)
        and reliability is not None
        and reliability >= 0.99
        and verified
        and rentable
        and rented
        and price is not None
        and 0 <= price <= HEAVY_MAX_DPH
    )


def get_heavy_offers(api_key: str) -> list[dict]:
    result = vast_request(
        api_key,
        "/api/v0/bundles",
        method="POST",
        payload=heavy_offer_query(),
    )
    offers = result.get("offers")
    if not isinstance(offers, list):
        raise SafeError("Vast.ai heavy offer search returned an invalid result")
    eligible = []
    for offer in offers:
        if not isinstance(offer, dict):
            continue
        if heavy_offer_eligible(offer):
            eligible.append(offer)
    return sorted(
        eligible,
        key=lambda item: (
            -float(item.get("gpu_ram", 0)),
            -float(item.get("cpu_cores_effective", 0)),
            float(item.get("dph_total", item.get("dph", 999))),
        ),
    )


