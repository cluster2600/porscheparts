        "do not retry automatically and inspect F39-labelled instances first"
    )


def reconcile_uncertain_component_factory_f41_launch(
    api_key: str, attempt_label: str
) -> int:
    """Rollback only the instance correlated to this unique create attempt."""
    if not is_component_factory_f41_attempt_label(attempt_label):
        raise SafeError("component-factory F41 attempt label is invalid")
    for _ in range(30):
        try:
            existing = list_instances(api_key, label=attempt_label)
        except SafeError:
            time.sleep(1)
            continue
        if existing:
            ids = sorted(
                instance.get("id")
                for instance in existing
                if isinstance(instance.get("id"), int)
                and not isinstance(instance.get("id"), bool)
                and instance.get("label") == attempt_label
            )
            if len(existing) == 1 and len(ids) == 1:
                destroy_instance_verified(api_key, ids[0])
                return ids[0]
            raise SafeError(
                "launch outcome is uncertain and the unique F41 attempt label is "
                "not mapped to one valid instance id; inspect instances before retrying"
            )
        time.sleep(1)
    raise SafeError(
        "launch outcome remains uncertain after the reconciliation window; "
        "do not retry automatically and inspect the unique F41 attempt label first"
    )


def destroy_instance_verified(api_key: str, instance_id: int) -> None:
    result = vast_request(
        api_key,
        f"/api/v0/instances/{instance_id}/",
        method="DELETE",
    )
    if result.get("success") is not True:
        raise SafeError("Vast.ai did not confirm the destroy request")
    for _ in range(30):
        try:
            ids = {
                instance.get("id")
                for instance in list_instances(api_key)
                if isinstance(instance.get("id"), int)
            }
        except SafeError:
            time.sleep(1)
            continue
        if instance_id not in ids:
            return
        time.sleep(1)
    raise SafeError("Vast.ai paginated instance list did not verify destruction")


