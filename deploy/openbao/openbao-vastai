    reliability = finite_number(offer.get("reliability", offer.get("reliability2")))
    upload_cost = finite_number(offer.get("inet_up_cost"))
    download_cost = finite_number(offer.get("inet_down_cost"))
    verified_value = offer.get("verified")
    rentable_value = offer.get("rentable")
    rented_value = offer.get("rented")
    verified = (
        verified_value is True
        or verified_value == 1
        or offer.get("verification") == "verified"
    )
    rentable = rentable_value is True or rentable_value == 1
    rented = rented_value is False or rented_value == 0
    rental_type = (
        offer.get("rentable_type")
        or offer.get("rental_type")
        or offer.get("type")
    )
    floors = (
        (offer.get("gpu_ram"), F46_MIN_GPU_RAM_MB),
        (offer.get("cpu_cores_effective"), F46_MIN_CPU_CORES),
        (offer.get("cpu_ram"), F46_MIN_CPU_RAM_MB),
        (offer.get("disk_space"), F46_MIN_DISK_GB),
    )
    return (
        isinstance(offer_id, int)
        and not isinstance(offer_id, bool)
        and offer_id > 0
        and offer.get("gpu_name") in F46_GPU_NAMES
        and finite_number(offer.get("num_gpus")) == 1.0
        and finite_number(offer.get("gpu_frac")) == 1.0
        and all(
            (actual := finite_number(value)) is not None and actual >= minimum
            for value, minimum in floors
        )
        and reliability is not None
        and reliability >= F46_MIN_RELIABILITY
        and verified
        and rentable
        and rented
        # Vast currently returns null rental metadata for some on-demand
        # search results. Creating without a bid is still on-demand; explicit
        # interruptible/bid metadata remains rejected.
        and rental_type in (None, "on-demand", "ondemand")
        and price is not None
        and 0 <= price <= F46_MAX_DPH
        and upload_cost is not None
        and 0 <= upload_cost <= F46_MAX_INET_UP_COST_USD_PER_GB
        and download_cost is not None
        and 0 <= download_cost <= F46_MAX_INET_DOWN_COST_USD_PER_GB
    )


