def run_m64_transport(command: list[str], payload: bytes, timeout_seconds: float) -> bytes:
    """Bound both directions, runtime and process-group cleanup; do not print streams."""
    maximum = 180 * 1024 * 1024
    if len(payload) > maximum or not math.isfinite(timeout_seconds) or not 0 < timeout_seconds <= M64_MAX_PHASE_SECONDS + 30:
        raise SafeError("M64 transport exceeds fixed byte or time bounds")
    process = subprocess.Popen(
        command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        env={"LC_ALL": "C", "PATH": os.environ.get("PATH", os.defpath)}, start_new_session=True,
    )
    streams = (process.stdin, process.stdout, process.stderr)
    selector = selectors.DefaultSelector()
    output, error = bytearray(), bytearray()
    offset = 0
    deadline = time.monotonic() + timeout_seconds
    try:
        for stream in streams:
            os.set_blocking(stream.fileno(), False)
        selector.register(process.stdin, selectors.EVENT_WRITE, "input")
        selector.register(process.stdout, selectors.EVENT_READ, "output")
        selector.register(process.stderr, selectors.EVENT_READ, "error")
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise SafeError("M64 transport reached its bounded timeout")
            for key, _ in selector.select(min(remaining, 0.25)):
                stream = key.fileobj
                if key.data == "input":
                    if offset < len(payload):
                        offset += os.write(stream.fileno(), payload[offset:offset + 65536])
                    if offset == len(payload):
                        selector.unregister(stream)
                        stream.close()
                    continue
                chunk = os.read(stream.fileno(), 65536)
                if not chunk:
                    selector.unregister(stream)
                    stream.close()
                    continue
                buffer = output if key.data == "output" else error
                if len(buffer) + len(chunk) > (maximum if key.data == "output" else 65536):
                    raise SafeError("M64 transport output exceeded its fixed bound")
                buffer.extend(chunk)
        code = process.wait(timeout=max(0.001, deadline - time.monotonic()))
        if code != 0:
            raise SafeError("M64 strict SSH transport or remote contract failed; private streams withheld")
        return bytes(output)
    except BaseException as exc:
        if not terminate_component_factory_f41_probe(process):
            raise SafeError("M64 transport failed and local process-group cleanup was not verified") from exc
        if isinstance(exc, (SafeError, KeyboardInterrupt, SystemExit)):
            raise
        raise SafeError("M64 bounded transport failed; private streams withheld") from exc
    finally:
        selector.close()
        for stream in streams:
            if not stream.closed:
                stream.close()


def m64_store_results(destination: Path, manifest: dict, response: dict) -> dict:
    """Validate the complete response before creating a new 0700 private directory."""
    entries = m64_entries(manifest["outputs"], outputs=True)
    found, missing, present = response.get("files"), response.get("missing_outputs"), response.get("present_outputs")
    if (
        not isinstance(found, dict) or len(found) > M64_MAX_RESULT_FILES
        or not isinstance(missing, list) or not isinstance(present, list)
        or any(not isinstance(item, str) for item in missing + present)
        or len(set(missing)) != len(missing) or len(set(present)) != len(present)
        or set(present) & set(missing) or set(present) | set(missing) != set(entries)
    ):
        raise SafeError("M64 result inventory does not match the exact output allowlist")
    payloads = {}
    used = dict.fromkeys(present, 0)
    folded = set()
    for name, entry in found.items():
        m64_relative_path(name)
        roots = [root for root in present if name == root or name.startswith(root + "/")]
        if len(roots) != 1 or name.casefold() in folded:
            raise SafeError("M64 result inventory includes an unapproved or ambiguous path")
        folded.add(name.casefold())
        root = roots[0]
        if not isinstance(entry, dict) or set(entry) != {"size", "sha256", "base64"}:
            raise SafeError("M64 result entry has unexpected fields")
        if type(entry["size"]) is not int or not 0 <= entry["size"] <= entries[root]["max_bytes"]:
            raise SafeError("M64 result size is invalid")
        used[root] += entry["size"]
        if used[root] > entries[root]["max_bytes"]:
            raise SafeError("M64 recursive result bytes exceed their root allocation")
        try:
            data = base64.b64decode(entry["base64"], validate=True)
        except (ValueError, TypeError) as exc:
            raise SafeError("M64 result encoding is invalid") from exc
        if len(data) != entry["size"] or hashlib.sha256(data).hexdigest() != entry["sha256"]:
            raise SafeError("M64 result hash or size verification failed")
        payloads[name] = data
    for name in payloads:
        if any(str(parent).casefold() in folded for parent in Path(name).parents if str(parent) != "."):
            raise SafeError("M64 result file path cannot also be a directory")
    m64_no_symlink_path(destination.parent)
    if destination.exists() or destination.is_symlink() or destination.name in {"", ".", ".."}:
        raise SafeError("M64 collection requires a new private destination directory")
    try:
        destination.mkdir(mode=0o700)
        for name, data in payloads.items():
            path = destination / name
            path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            descriptor = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(data)
        receipt = {key: value for key, value in response.items() if key != "files"}
        receipt["files"] = {name: {key: value for key, value in found[name].items() if key != "base64"} for name in found}
        descriptor = os.open(destination / "collection-receipt.json", os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, "w") as stream:
            json.dump(receipt, stream, indent=2)
            stream.write("\n")
    except OSError as exc:
        raise SafeError("M64 private retrieval could not complete; any partial files remain private") from exc
    return {"retrieved_files": len(found), "missing_outputs": missing, "retrieval_complete": not missing, "destination": str(destination)}


def m64_operation(api_key: str, operation: list[str], bundle: tuple) -> int:
    manifest, manifest_bytes, files = bundle
    action = operation[0].removeprefix("m64-")
    collecting = action == "collect"
    ssh = m64_verified_ssh(api_key, manifest, collecting=collecting)
    seconds = M64_COLLECT_SECONDS if collecting else min(
        M64_MAX_PHASE_SECONDS if action == "phase" else M64_TRANSFER_SECONDS,
        int(m64_start_deadline(manifest)),
    )
    if seconds < 1:
        raise SafeError("M64 deadline leaves no time to start this phase")
    expected_sha = hashlib.sha256(manifest_bytes).hexdigest()
    request = {
        "operation": action, "manifest_b64": base64.b64encode(manifest_bytes).decode(),
        "manifest_sha256": expected_sha,
        "files_b64": {name: base64.b64encode(data).decode() for name, data in files.items()} if action == "transfer" else {},
        "phase": operation[3] if action == "phase" else None, "timeout_seconds": seconds,
    }
    helper = M64_REMOTE_HELPER.replace("__M64_CODE_PIN__", M64_APPROVED_CODE_MANIFEST_SHA256)
    command = ssh + [shlex.join(["/opt/simready-validation/bin/python", "-I", "-c", helper])]
    response = m64_json(run_m64_transport(command, json.dumps(request, separators=(",", ":")).encode(), seconds + 25))
    fields = {"schema_version", "job_id", "instance_id", "operation", "manifest_sha256"}
    fields |= {"files", "present_outputs", "missing_outputs"} if collecting else ({"phase", "exit_code", "timed_out"} if action == "phase" else set())
    if (
        set(response) != fields or response["schema_version"] != "1.0.0"
        or response["job_id"] != manifest["job_id"] or type(response["instance_id"]) is not int
        or response["instance_id"] != manifest["instance_id"] or response["operation"] != action
        or response["manifest_sha256"] != expected_sha
    ):
        raise SafeError("M64 remote receipt identity or manifest hash mismatch")
    summary = {"job_id": manifest["job_id"], "instance_id": manifest["instance_id"], "operation": action, "manifest_sha256": expected_sha}
    result = 0
    if collecting:
        summary.update(m64_store_results(Path(operation[3]), manifest, response))
    elif action == "phase":
        if response["phase"] != operation[3] or type(response["exit_code"]) is not int or not -255 <= response["exit_code"] <= 255 or type(response["timed_out"]) is not bool:
            raise SafeError("M64 phase result does not match the fixed invocation")
        summary.update(phase=operation[3], exit_code=response["exit_code"], timed_out=response["timed_out"])
        result = 0 if response["exit_code"] == 0 and not response["timed_out"] else 1
    print_json(summary)
    return result


def picogk_account_balance(api_key: str) -> dict:
    """Select only billing numbers; never expose the user record or identity."""
    # Official endpoint: https://docs.vast.ai/api-reference/accounts/show-user
    result = vast_request(api_key, "/api/v0/users/current/")
    balance = finite_number(result.get("balance"))
    credit = finite_number(result.get("credit"))
    if balance is None and credit is None:
        raise SafeError("Vast.ai balance response has no finite billing value")
    # Current CLI exposes prepaid credit separately from pending balance. Keep
    # both visible and subtract any negative pending balance conservatively.
    available = credit + min(balance or 0.0, 0.0) if credit is not None else balance
    return {"balance_usd": balance, "credit_usd": credit,
            "conservative_available_usd": available,
            "automatic_recharge_requested": False}


def picogk_offer_eligible(offer: dict) -> bool:
    floors = (("cpu_cores_effective", PICOGK_MIN_CPU),
              ("cpu_ram", PICOGK_MIN_RAM_MB), ("disk_space", PICOGK_DISK_GB))
    return (
        type(offer.get("id")) is int and offer["id"] > 0
        and finite_number(offer.get("num_gpus")) == 1
        and finite_number(offer.get("gpu_frac")) == 1
        and all((value := finite_number(offer.get(key))) is not None and value >= floor
                for key, floor in floors)
        and (price := finite_number(offer.get("dph_total"))) is not None
        and 0 < price <= PICOGK_MAX_DPH
        and (reliability := finite_number(offer.get("reliability", offer.get("reliability2")))) is not None
        and reliability >= 0.99
        and (offer.get("verified") is True or offer.get("verification") == "verified")
        and offer.get("rentable") in (True, 1) and offer.get("rented") in (False, 0)
        and (offer.get("rentable_type") or offer.get("rental_type") or offer.get("type"))
            in (None, "on-demand", "ondemand")
        and all((value := finite_number(offer.get(key))) is not None
                and 0 <= value <= PICOGK_MAX_TRANSFER_RATE
                for key in ("inet_up_cost", "inet_down_cost"))
    )


def get_picogk_offers(api_key: str, offer_id: int | None = None) -> list[dict]:
    query = {"allocated_storage": PICOGK_DISK_GB, "num_gpus": {"eq": 1},
             "gpu_frac": {"eq": 1}, "cpu_cores_effective": {"gte": PICOGK_MIN_CPU},
             "cpu_ram": {"gte": PICOGK_MIN_RAM_MB}, "disk_space": {"gte": PICOGK_DISK_GB},
             "dph_total": {"lte": PICOGK_MAX_DPH}, "reliability": {"gte": 0.99},
             "verified": {"eq": True}, "rentable": {"eq": True}, "rented": {"eq": False},
             "type": "on-demand", "order": [["dph_total", "asc"]], "limit": 100}
    if offer_id is not None:
        query["id"] = {"eq": offer_id}
    result = vast_request(api_key, "/api/v0/bundles", method="POST", payload=query)
    offers = result.get("offers")
    if not isinstance(offers, list):
        raise SafeError("Vast.ai PicoGK offer response is invalid")
    return sorted((offer for offer in offers if isinstance(offer, dict)
                   and picogk_offer_eligible(offer)), key=lambda offer: offer["dph_total"])


def picogk_load_manifest(path: Path, *, require_active: bool = True) -> tuple[dict, str]:
    data = m64_read_file(path, 65536)
    try:
        manifest = json.loads(data)
    except (ValueError, UnicodeError):
        raise SafeError("PicoGK manifest is not valid JSON") from None
    fields = {"schema_version", "profile", "job_id", "attempt_label", "image_ref",
              "created_epoch", "deadline_epoch", "budget_usd", "image_download_gb",
              "max_input_gb", "max_output_gb", "qualification_path", "qualification_sha256",
              "guard_ready_path"}
    if not isinstance(manifest, dict) or set(manifest) != fields:
        raise SafeError("PicoGK manifest fields differ from the fixed contract")
    if (manifest["schema_version"] != "1.0.0" or manifest["profile"] != PICOGK_PROFILE
        or not isinstance(manifest["job_id"], str)
        or not re.fullmatch(r"picogk-m64-[a-z0-9][a-z0-9-]{0,63}", manifest["job_id"])
        or not isinstance(manifest["attempt_label"], str)
        or not re.fullmatch(re.escape(PICOGK_LABEL) + r"-[0-9a-f]{20}", manifest["attempt_label"])
        or not isinstance(manifest["image_ref"], str)
        or PICOGK_IMAGE_RE.fullmatch(manifest["image_ref"]) is None):
        raise SafeError("PicoGK manifest identity or immutable image is invalid")
    created, deadline = manifest["created_epoch"], manifest["deadline_epoch"]
    if (type(created) is not int or type(deadline) is not int
        or created > time.time() or (require_active and time.time() >= deadline)
        or not 60 <= deadline - created <= PICOGK_MAX_SECONDS):
        raise SafeError("PicoGK deadline is expired or exceeds three hours")
    budget = finite_number(manifest["budget_usd"])
    if budget is None or not PICOGK_CLEANUP_RESERVE_USD < budget <= PICOGK_MAX_BUDGET_USD:
        raise SafeError("PicoGK budget must exceed reserve and cannot exceed four USD")
    for field, maximum in (("image_download_gb", 20), ("max_input_gb", 2), ("max_output_gb", 2)):
        value = finite_number(manifest[field])
        if value is None or not 0 <= value <= maximum:
            raise SafeError("PicoGK declared transfer size is invalid")
    if manifest["image_download_gb"] <= 0:
        raise SafeError("PicoGK image size must be measured before rental")
    if (not isinstance(manifest["qualification_path"], str)
        or not isinstance(manifest["qualification_sha256"], str)
        or not re.fullmatch(r"[0-9a-f]{64}", manifest["qualification_sha256"])):
        raise SafeError("PicoGK qualification path or SHA256 is invalid")
    if (not isinstance(manifest["guard_ready_path"], str)
        or Path(manifest["guard_ready_path"]).parent != path.parent
        or Path(manifest["guard_ready_path"]).name != manifest["job_id"] + ".guard-ready.json"):
        raise SafeError("PicoGK guard readiness must be the exact sibling job receipt")
    proof_data = m64_read_file(Path(manifest["qualification_path"]), 65536)
    if hashlib.sha256(proof_data).hexdigest() != manifest["qualification_sha256"]:
        raise SafeError("PicoGK qualification SHA256 does not match")
    try:
        proof = json.loads(proof_data)
    except (ValueError, UnicodeError):
        raise SafeError("PicoGK qualification is not JSON") from None
    if (not isinstance(proof, dict) or proof.get("image_ref") != manifest["image_ref"]
        or proof.get("platform") != "linux/amd64"
        or proof.get("runtime_smoke_verified") is not True
        or proof.get("anonymous_exact_digest_pull_verified") is not True
        or proof.get("manufacturing_validated") is not False
        or proof.get("engine_validated") is not False):
        raise SafeError("PicoGK image is not qualified for this software-only run")
    return manifest, hashlib.sha256(data).hexdigest()


def picogk_budget_cost(manifest: dict, price: object, up: object, down: object) -> float:
    values = [finite_number(item) for item in (price, up, down)]
    if any(item is None for item in values):
        raise SafeError("PicoGK instance cost metadata is missing")
    price, up, down = values
    if not 0 < price <= PICOGK_MAX_DPH or not all(0 <= rate <= PICOGK_MAX_TRANSFER_RATE for rate in (up, down)):
        raise SafeError("PicoGK price or transfer tariff exceeds its fixed cap")
    hours = (manifest["deadline_epoch"] - manifest["created_epoch"]) / 3600
    cost = hours * price + (manifest["image_download_gb"] + manifest["max_input_gb"]) * down
    cost += manifest["max_output_gb"] * up + PICOGK_CLEANUP_RESERVE_USD
    if cost > manifest["budget_usd"]:
        raise SafeError("PicoGK planned worst-case cost exceeds its declared budget")
    return cost


def picogk_singleton(api_key: str, instance_id: int | None, manifest: dict) -> None:
    # The small budget is account-wide: do not overlap any existing rental.
    inventory = strict_instance_inventory(api_key)
    if instance_id is None:
        if inventory:
            raise SafeError("PicoGK rental requires an empty Vast instance inventory")
    elif (len(inventory) != 1 or inventory[0].get("id") != instance_id
          or inventory[0].get("label") != manifest["attempt_label"]):
        raise SafeError("PicoGK instance is not the unique expected rental")


def picogk_contract(raw: dict, instance_id: int, manifest: dict, offer: dict | None = None) -> dict:
    instance = safe_instance(raw)
    if (type(instance["id"]) is not int or instance["id"] != instance_id
        or instance["label"] != manifest["attempt_label"]
        or instance["image"] != manifest["image_ref"]
        or instance["status"] not in {"created", "loading", "running"}
        or instance["machine_verification"] != "verified"
        or finite_number(instance["num_gpus"]) != 1
        or finite_number(instance["gpu_fraction"]) != 1):
        raise SafeError("PicoGK instance identity or hardware contract changed")
    for key, floor in (("cpu_cores_effective", PICOGK_MIN_CPU), ("cpu_ram_mb", PICOGK_MIN_RAM_MB),
                       ("disk_space_gb", PICOGK_DISK_GB)):
        value = finite_number(instance[key])
        if value is None or value < floor:
            raise SafeError("PicoGK instance resources are below the fixed minimum")
    if offer is not None and (instance["gpu"] != offer.get("gpu_name")
        or finite_number(instance["dph_total"]) != finite_number(offer.get("dph_total"))):
        raise SafeError("PicoGK instance differs from the freshly selected offer")
    picogk_budget_cost(manifest, instance["dph_total"], instance["inet_up_cost_usd_per_gb"],
                      instance["inet_down_cost_usd_per_gb"])
    return instance


def picogk_smoke_valid(output: str) -> bool:
    try:
        report = json.loads(output)
    except (ValueError, UnicodeError):
        return False
    error = finite_number(report.get("relative_volume_error")) if isinstance(report, dict) else None
    return (isinstance(report, dict) and report.get("status") == "PASS"
            and report.get("architecture") == "X64"
            and report.get("scope") == "software_geometry_witness_only"
            and type(report.get("triangles")) is int and report["triangles"] > 0
            and type(report.get("stl_roundtrip_triangles")) is int
            and report["stl_roundtrip_triangles"] == report["triangles"]
            and error is not None and 0 <= error <= 0.10
            and report.get("manufacturing_validated") is False
            and report.get("engine_validated") is False)


def picogk_remote_ready_command() -> str:
    # Runtime is .NET-only. Read exactly the fixed non-secret witness files;
    # parse its bounded JSON locally and never print remote raw streams.
    return (
        "test -f /workspace/PICOGK_READY && test ! -L /workspace/PICOGK_READY "
        "&& test \"$(wc -c </workspace/PICOGK_READY)\" -le 128 "
        "&& test \"$(cat /workspace/PICOGK_READY)\" = PICOGK_M64_READY "
        "&& test -f /workspace/picogk-smoke/report.json "
        "&& test ! -L /workspace/picogk-smoke/report.json "
        "&& test \"$(wc -c </workspace/picogk-smoke/report.json)\" -le 65536 "
        "&& head -c 65536 /workspace/picogk-smoke/report.json"
    )


def picogk_ssh_ready(api_key: str, instance_id: int, manifest: dict, offer: dict) -> dict:
    public_key = read_local_ssh_public_key()
    if not instance_lists_approved_ssh_key(api_key, instance_id, public_key):
        result = vast_request(api_key, f"/api/v0/instances/{instance_id}/ssh/", method="POST",
                              payload={"ssh_key": public_key})
        if result.get("success") is not True:
            raise SafeError("PicoGK exact instance SSH attachment was not confirmed")
        for attempt in range(3):
            if instance_lists_approved_ssh_key(api_key, instance_id, public_key):
                break
            if attempt == 2:
                raise SafeError("PicoGK approved SSH key is not listed by the provider")
            time.sleep(5)
    known_hosts = prepare_component_factory_f41_known_hosts(instance_id)
    alias = component_factory_f41_host_key_alias(instance_id)
    deadline = min(time.time() + 900, manifest["deadline_epoch"] - 300)
    while time.time() < deadline:
        result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
        raw = result.get("instances")
        if not isinstance(raw, dict):
            raise SafeError("PicoGK instance metadata is invalid")
        # Loading may expose partial resource metadata; never spend past the
        # bounded READY clock and never accept a known identity mismatch.
        safe = safe_instance(raw)
        for field, expected in (("id", instance_id), ("label", manifest["attempt_label"]),
                                ("image", manifest["image_ref"])):
            if safe[field] is not None and safe[field] != expected:
                raise SafeError("PicoGK loading identity changed")
        if safe["status"] in {"created", "loading"}:
            time.sleep(min(15, max(0, deadline - time.time())))
            continue
        instance = picogk_contract(raw, instance_id, manifest, offer)
        endpoint = m64_ssh_endpoint(raw, instance_id)
        if endpoint is None:
            time.sleep(min(15, max(0, deadline - time.time())))
            continue
        if time.time() >= deadline:
            break
        options = {"BatchMode": "yes", "IdentitiesOnly": "yes", "ForwardAgent": "no",
                   "ClearAllForwardings": "yes", "PermitLocalCommand": "no",
                   "PasswordAuthentication": "no", "KbdInteractiveAuthentication": "no",
                   "ConnectionAttempts": "1", "ConnectTimeout": "5",
                   "StrictHostKeyChecking": "accept-new", "UpdateHostKeys": "no",
                   "GlobalKnownHostsFile": "/dev/null", "HashKnownHosts": "no",
                   "HostKeyAlias": alias, "UserKnownHostsFile": str(known_hosts), "LogLevel": "ERROR"}
        command = ["ssh", "-F", "/dev/null", "-T", "-i", str(SSH_PRIVATE_KEY_FILE)]
        for key, value in options.items():
            command.extend(["-o", key + "=" + value])
        command += ["-p", str(endpoint["port"]), "root@" + endpoint["host"],
                    picogk_remote_ready_command()]
        try:
            completed = run_component_factory_f41_ssh_probe(command, {
                "LC_ALL": "C", "PATH": os.environ.get("PATH", os.defpath)})
        except ComponentFactoryF41ProbeTimeout:
            time.sleep(min(15, max(0, deadline - time.time())))
            continue
        if (completed.returncode == 0 and picogk_smoke_valid(completed.stdout)
            and not completed.stderr.strip()):
            validate_component_factory_f41_known_hosts(known_hosts, instance_id)
            picogk_singleton(api_key, instance_id, manifest)
            return {"instance": instance, "ssh_endpoint": endpoint,
                    "known_hosts_path": str(known_hosts), "host_key_alias": alias}
        lowered = completed.stderr.lower()
        if any(marker in lowered for marker in ("permission denied", "host key verification failed",
                                                "remote host identification has changed", "load key")):
            raise SafeError("PicoGK SSH identity or host-key verification failed; private streams withheld")
        time.sleep(min(15, max(0, deadline - time.time())))
    raise SafeError("PicoGK SSH and geometry witness did not become ready within fifteen minutes")


def picogk_reconcile(api_key: str, manifest: dict) -> int:
    for _ in range(6):
        matches = [item for item in strict_instance_inventory(api_key)
                   if item.get("label") == manifest["attempt_label"]]
        if matches:
            if len(matches) != 1:
                raise SafeError("PicoGK uncertain launch has ambiguous ownership; no automatic deletion")
            instance_id = matches[0]["id"]
            destroy_instance_verified(api_key, instance_id, expected_label=manifest["attempt_label"],
                                      expected_image=manifest["image_ref"])
            return instance_id
        time.sleep(5)
    raise SafeError("PicoGK launch remains uncertain; do not retry before reconciling its exact label")


def launch_picogk_m64(api_key: str, offer_id: int, manifest: dict, manifest_sha256: str) -> int:
    with simready_launch_lock():
        picogk_singleton(api_key, None, manifest)
        funds = picogk_account_balance(api_key)
        if funds["conservative_available_usd"] < manifest["budget_usd"] + 1:
            raise SafeError("PicoGK available credit does not cover the run and account reserve")
        ensure_local_ssh_registered(api_key)
        offers = [item for item in get_picogk_offers(api_key, offer_id) if item["id"] == offer_id]
        if len(offers) != 1:
            raise SafeError("PicoGK offer is unavailable or outside the fixed resource and price limits")
        offer = offers[0]
        ceiling = picogk_budget_cost(manifest, offer["dph_total"], offer["inet_up_cost"], offer["inet_down_cost"])
        if not manifest["created_epoch"] <= time.time() < manifest["deadline_epoch"] - 300:
            raise SafeError("PicoGK deadline leaves insufficient startup and cleanup time")
        picogk_verify_armed_guard(manifest, manifest_sha256)
        picogk_consume_attempt(manifest, manifest_sha256, offer_id)
        print("OPENBAO_VASTAI_PICOGK_ATTEMPT " + json.dumps({"label": manifest["attempt_label"],
              "manifest_sha256": manifest_sha256, "image_ref": manifest["image_ref"],
              "deadline_epoch": manifest["deadline_epoch"], "worst_case_planned_usd": ceiling}),
              file=sys.stderr, flush=True)
        instance_id = None
        try:
            result = vast_request(api_key, f"/api/v0/asks/{offer_id}/", method="PUT", payload={
                "image": manifest["image_ref"], "label": manifest["attempt_label"],
                "disk": PICOGK_DISK_GB, "runtype": "ssh_direct", "env": {},
                "onstart": "picogk-vast-onstart --deadline-epoch " + str(manifest["deadline_epoch"]),
                "cancel_unavail": True})
            returned = result.get("new_contract")
            if type(returned) is not int or returned <= 0:
                raise SafeError("Vast.ai did not return an exact PicoGK instance ID")
            instance_id = returned
            verified = picogk_ssh_ready(api_key, instance_id, manifest, offer)
        except BaseException:
            try:
                if instance_id is None:
                    instance_id = picogk_reconcile(api_key, manifest)
                else:
                    destroy_instance_verified(api_key, instance_id, expected_label=manifest["attempt_label"],
                                              expected_image=manifest["image_ref"])
                print("OPENBAO_VASTAI_PICOGK_CLEANUP " + json.dumps({"instance_id": instance_id,
                    "verified_absent": True, "label": manifest["attempt_label"]}), file=sys.stderr, flush=True)
            except BaseException:
                print("OPENBAO_VASTAI_PICOGK_BILLING_RISK " + manifest["attempt_label"], file=sys.stderr, flush=True)
                raise
            raise
        print_json({"profile": PICOGK_PROFILE, "instance_id": instance_id,
                    "label": manifest["attempt_label"], "image_ref": manifest["image_ref"],
                    "manifest_sha256": manifest_sha256, "deadline_epoch": manifest["deadline_epoch"],
                    "budget_usd": manifest["budget_usd"], "planned_cost_with_reserve_usd": ceiling,
                    "balance_before": funds, "approved_public_private_pair_verified": True,
                    "approved_instance_key_verified": True, "ssh_batch_mode_verified": True,
                    "runtime_smoke_verified": True, "external_destroy_watchdog_armed": True,
                    "manufacturing_validated": False, "engine_validated": False, **verified})
        return 0


def picogk_consume_attempt(manifest: dict, manifest_sha256: str, offer_id: int) -> Path:
    """Durably consume one paid attempt before PUT; uncertainty never permits replay."""
    path = Path(manifest["guard_ready_path"]).parent / (manifest["job_id"] + ".paid-attempt.json")
    m64_no_symlink_path(path.parent)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        raise SafeError("PicoGK paid attempt is already consumed; reconcile this manifest instead of replaying PUT") from None
    receipt = {"label": manifest["attempt_label"], "image_ref": manifest["image_ref"],
               "manifest_sha256": manifest_sha256, "offer_id": offer_id,
               "created_epoch": int(time.time()), "paid_outcome": "unknown_until_provider_receipt"}
    with os.fdopen(fd, "w") as stream:
        json.dump(receipt, stream, sort_keys=True)
        stream.flush()
        os.fsync(stream.fileno())
    directory = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    return path


def picogk_verify_armed_guard(manifest: dict, manifest_sha256: str) -> None:
    try:
        ready = json.loads(m64_read_file(Path(manifest["guard_ready_path"]), 4096))
    except (ValueError, UnicodeError):
        raise SafeError("PicoGK guard readiness is not valid JSON") from None
    if (not isinstance(ready, dict) or ready.get("armed") is not True
        or ready.get("manifest_sha256") != manifest_sha256
        or ready.get("deadline_epoch") != manifest["deadline_epoch"]
        or ready.get("label") != manifest["attempt_label"]
        or ready.get("image_ref") != manifest["image_ref"]
        or ready.get("wrapper_sha256") != hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
        or type(ready.get("pid")) is not int or ready["pid"] <= 0):
        raise SafeError("PicoGK external destruction guard is not armed for this exact run")
    try:
        os.kill(ready["pid"], 0)
    except OSError:
        raise SafeError("PicoGK external destruction guard is not alive") from None


def run(operation: list[str]) -> int:
    picogk_bundle = None
    if operation and operation[0] in {"launch-picogk-m64", "reconcile-picogk-m64"}:
        if len(operation) != (2 if operation[0] == "reconcile-picogk-m64" else 3):
            raise SafeError("PicoGK requires its exact local manifest")
        if operation[0] != "reconcile-picogk-m64":
            positive_id(operation[1], "PicoGK offer id")
        picogk_bundle = picogk_load_manifest(Path(operation[-1]), require_active=operation[0] == "launch-picogk-m64")
    m64_bundle = None
    if operation and operation[0].startswith("m64-"):
        name = operation[0]
        if name not in {"m64-transfer", "m64-phase", "m64-collect"} or len(operation) != (3 if name == "m64-transfer" else 4):
            raise SafeError("M64 supports only transfer, one named phase, or private collect")
        if name == "m64-phase" and operation[3] not in M64_PHASES:
            raise SafeError("M64 phase is not in the immutable registry")
        if name == "m64-collect":
            destination = Path(operation[3])
            m64_no_symlink_path(destination.parent)
            if destination.exists() or destination.is_symlink():
                raise SafeError("M64 collection requires a new private directory")
        m64_bundle = m64_load_bundle(Path(operation[2]), positive_id(operation[1], "M64 instance id"))
    token = login()
    try:
        api_key = read_vast_key(token)
        if operation == ["account-balance"]:
            print_json(picogk_account_balance(api_key))
            return 0
        if operation == ["picogk-offers"]:
            print_json([safe_offer(item) for item in get_picogk_offers(api_key)[:20]])
            return 0
        if picogk_bundle is not None:
            manifest, manifest_sha256 = picogk_bundle
            if operation[0] == "launch-picogk-m64":
                return launch_picogk_m64(api_key, int(operation[1]), manifest, manifest_sha256)
            instance_id = picogk_reconcile(api_key, manifest)
            print_json({"instance_id": instance_id, "verified_absent": True,
                        "label": manifest["attempt_label"]})
            return 0
        if m64_bundle is not None:
            return m64_operation(api_key, operation, m64_bundle)
        if operation == ["--auth-check"]:
            list_instances(api_key)
            print("OpenBao Vast.ai reader auth check OK")
            return 0
        if operation == ["offers"]:
            print_json([safe_offer(item) for item in get_offers(api_key)[:20]])
            return 0
        if operation == ["heavy-offers"]:
            print_json([safe_offer(item) for item in get_heavy_offers(api_key)[:20]])
            return 0
        if operation == ["f46-offers"]:
            print_json([safe_offer(item) for item in get_f46_offers(api_key)[:20]])
            return 0
        if operation == ["wave-offers"]:
            print_json([safe_offer(item) for item in get_wave_offers(api_key)[:20]])
            return 0
        if operation == ["component-factory-f41-offers"]:
            print_json(
                [
                    safe_offer(item)
                    for item in get_component_factory_f41_offers(api_key)[:20]
                ]
            )
            return 0
        if operation == ["mesh-offers"]:
            print_json([safe_offer(item) for item in get_mesh_offers(api_key)[:20]])
            return 0
        if operation == ["instances"]:
            items = list_instances(api_key)
            print_json([safe_instance(item) for item in items if isinstance(item, dict)])
            return 0
        if len(operation) == 2 and operation[0] == "show":
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
            instance = result.get("instances")
            if not isinstance(instance, dict):
                raise SafeError("Vast.ai instance lookup returned an invalid result")
            print_json(safe_instance(instance))
            return 0
        if len(operation) == 2 and operation[0] == "ssh-keys":
            instance_id = positive_id(operation[1], "instance id")
            approved_key_fields = read_local_ssh_public_key().split()
            approved_key_identity = " ".join(approved_key_fields[:2])
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/ssh")
            raw_keys = result.get("ssh_keys", "[]")
            try:
                keys = json.loads(raw_keys) if isinstance(raw_keys, str) else raw_keys
            except json.JSONDecodeError as exc:
                raise SafeError("Vast.ai returned invalid SSH key metadata") from exc
            if not isinstance(keys, list):
                raise SafeError("Vast.ai returned invalid SSH key metadata")
            safe_keys = []
            for item in keys:
                if not isinstance(item, dict):
                    continue
                public_key = item.get("public_key", "")
                key_type = public_key.split(" ", 1)[0] if isinstance(public_key, str) else None
                public_key_fields = public_key.split() if isinstance(public_key, str) else []
                public_key_identity = " ".join(public_key_fields[:2])
                safe_keys.append(
                    {
                        "id": item.get("id"),
                        "name": item.get("name"),
                        "type": key_type,
                        "matches_approved_local_key": (
                            bool(public_key_identity)
                            and public_key_identity == approved_key_identity
                        ),
                    }
                )
            print_json(safe_keys)
            return 0
        if len(operation) == 2 and operation[0] == "ssh-endpoints":
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
            instance = result.get("instances")
            if not isinstance(instance, dict):
                raise SafeError("Vast.ai returned invalid SSH endpoint metadata")
            print_json(safe_ssh_endpoints(instance, instance_id))
            return 0
        if len(operation) == 2 and operation[0] == "attach-local-ssh":
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(
                api_key,
                f"/api/v0/instances/{instance_id}/ssh/",
                method="POST",
                payload={"ssh_key": read_local_ssh_public_key()},
            )
            print_json({"instance_id": instance_id, "attached": bool(result.get("success", True))})
            return 0
        if len(operation) == 2 and operation[0] == "refresh-local-ssh":
            instance_id = positive_id(operation[1], "instance id")
            approved_key = read_local_ssh_public_key()
            instance_result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
            raw_instance = instance_result.get("instances")
            if not isinstance(raw_instance, dict):
                raise SafeError("Vast.ai returned invalid SSH refresh instance metadata")
            if safe_instance(raw_instance).get("status") not in {"exited", "stopped"}:
                raise SafeError("SSH key refresh requires a stopped instance")
            approved_fields = approved_key.split()
            approved_identity = " ".join(approved_fields[:2])
            keys_result = vast_request(api_key, f"/api/v0/instances/{instance_id}/ssh")
            raw_keys = keys_result.get("ssh_keys", "[]")
            try:
                keys = json.loads(raw_keys) if isinstance(raw_keys, str) else raw_keys
            except json.JSONDecodeError as exc:
                raise SafeError("Vast.ai returned invalid SSH key metadata") from exc
            if not isinstance(keys, list):
                raise SafeError("Vast.ai returned invalid SSH key metadata")
            matching_ids = []
            for item in keys:
                if not isinstance(item, dict):
                    continue
                fields = str(item.get("public_key", "")).split()
                if " ".join(fields[:2]) != approved_identity:
                    continue
                matching_ids.append(positive_id(str(item.get("id")), "SSH key id"))
            if not matching_ids:
                raise SafeError("approved local SSH key is not attached to this instance")
            for key_id in matching_ids:
                detached = vast_request(
                    api_key,
                    f"/api/v0/instances/{instance_id}/ssh/{key_id}/",
                    method="DELETE",
                )
                if detached.get("success") is not True:
                    raise SafeError("Vast.ai did not confirm exact SSH key detachment")
            attached = vast_request(
                api_key,
                f"/api/v0/instances/{instance_id}/ssh/",
                method="POST",
                payload={"ssh_key": approved_key},
            )
            if attached.get("success") is not True:
                raise SafeError("Vast.ai did not confirm approved SSH key reattachment")
            print_json(
                {
                    "instance_id": instance_id,
                    "approved_key_refreshed": True,
                    "duplicate_attachments_removed": max(0, len(matching_ids) - 1),
                }
            )
            return 0
        if operation == ["ensure-local-ssh"]:
            ensure_local_ssh_registered(api_key)
            print_json(
                {
                    "registered": True,
                    "approved_private_key_file_verified": True,
                    "approved_public_private_key_pair_verified": True,
                    "ssh_agent_required": False,
                }
            )
            return 0
        if len(operation) == 2 and operation[0] == "probe":
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(
                api_key,
                f"/api/v0/instances/command/{instance_id}",
                method="PUT",
                payload={"command": "ls -l"},
            )
            result_url = result.get("result_url")
            if not isinstance(result_url, str):
                raise SafeError("Vast.ai did not return an execution result URL")
            print(fetch_execution_result(result_url), end="")
            return 0
        if len(operation) == 2 and operation[0] in {"logs", "daemon-logs"}:
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(
                api_key,
                f"/api/v0/instances/request_logs/{instance_id}",
                method="PUT",
                payload={
                    "tail": "200",
                    "daemon_logs": "true" if operation[0] == "daemon-logs" else "false",
                },
            )
            result_url = result.get("result_url")
            if not isinstance(result_url, str):
                raise SafeError("Vast.ai did not return a log result URL")
            print(fetch_execution_result(result_url), end="")
            return 0
        if len(operation) == 2 and operation[0] == "launch":
            offer_id = positive_id(operation[1], "offer id")
            matching = [
                item
                for item in get_offers(api_key, offer_id)
                if str(item.get("id")) == str(offer_id)
            ]
            if len(matching) != 1:
                raise SafeError("offer is unavailable or outside the fixed safety and price limits")
            return launch_offer(api_key, matching[0])
        if len(operation) == 2 and operation[0] == "launch-mesh":
            offer_id = positive_id(operation[1], "offer id")
            matching = [
                item
                for item in get_mesh_offers(api_key, offer_id)
                if str(item.get("id")) == str(offer_id)
            ]
            if len(matching) != 1:
                raise SafeError("mesh offer is unavailable or outside the fixed safety and price limits")
            return launch_mesh_offer(api_key, matching[0])
        if len(operation) == 2 and operation[0] == "launch-wave-f39":
            offer_id = positive_id(operation[1], "offer id")
            matching = [
                item
                for item in get_wave_offers(api_key, offer_id)
                if item.get("id") == offer_id
            ]
            if len(matching) != 1:
                raise SafeError(
                    "wave-action offer is unavailable or outside the fixed safety and price limits"
                )
            return launch_wave_f39_offer(api_key, matching[0])
        if (
            len(operation) in {2, 4}
            and operation[0] == "launch-component-factory-f41"
        ):
            offer_id = positive_id(operation[1], "offer id")
            supervised_attempt_label = None
            if len(operation) == 4:
                if operation[2] != "--attempt-label" or not is_component_factory_f41_attempt_label(
                    operation[3]
                ):
                    raise SafeError("supervised F41 attempt label is invalid")
                supervised_attempt_label = operation[3]
            matching = [
                item
                for item in get_component_factory_f41_offers(api_key, offer_id)
                if item.get("id") == offer_id
            ]
            if len(matching) != 1:
                raise SafeError(
                    "component-factory F41 offer is unavailable or outside the "
                    "fixed safety and price limits"
                )
            return launch_component_factory_f41_offer(
                api_key,
                matching[0],
                attempt_label=supervised_attempt_label,
            )
        if len(operation) in {4, 6} and operation[0] == "launch-f46":
            offer_id = positive_id(operation[1], "offer id")
            expected_image = operation[2]
            deadline_epoch = positive_id(operation[3], "F46 deadline epoch")
            supervised_attempt_label = None
            if len(operation) == 6:
                if operation[4] != "--attempt-label" or not is_f46_attempt_label(
                    operation[5]
                ):
                    raise SafeError("supervised F46 attempt label is invalid")
                supervised_attempt_label = operation[5]
            matching = [
                item
                for item in get_f46_offers(api_key, offer_id)
                if item.get("id") == offer_id
            ]
            if len(matching) != 1:
                raise SafeError(
                    "F46 offer is unavailable or outside fixed safety and price limits"
                )
            return launch_f46_offer(
                api_key,
                matching[0],
                expected_image,
                deadline_epoch,
                attempt_label=supervised_attempt_label,
            )
        if (
            len(operation) in {2, 4}
            and operation[0] in {
                "launch-simready-heavy",
                "launch-simready-validation-only",
                "launch-m64-heavy",
            }
        ):
            offer_id = positive_id(operation[1], "offer id")
            supervised_attempt_label = None
            if len(operation) == 4:
                if operation[2] != "--attempt-label" or not is_simready_attempt_label(
                    operation[3]
                ):
                    raise SafeError("supervised SimReady attempt label is invalid")
                supervised_attempt_label = operation[3]
            matching = [
                item
                for item in get_heavy_offers(api_key)
                if str(item.get("id")) == str(offer_id)
            ]
            if len(matching) != 1:
                raise SafeError("heavy SimReady offer is unavailable or outside the fixed safety and price limits")
            return launch_simready_offer(
                api_key,
                matching[0],
                disk_gb=500,
                enforce_singleton=True,
                attempt_label=supervised_attempt_label,
                validation_only=operation[0] == "launch-simready-validation-only",
                **({"profile": M64_PROFILE} if operation[0] == "launch-m64-heavy" else {}),
            )
        if len(operation) == 2 and operation[0] in {"reconcile-simready-attempt", "reconcile-m64-attempt"}:
            attempt_label = operation[1]
            if not is_simready_attempt_label(attempt_label):
                raise SafeError("SimReady attempt label is invalid")
            instance_id = reconcile_uncertain_simready_launch(
                api_key, attempt_label
            )
            emit_simready_cleanup_attestation(
                instance_id, attempt_label,
                **({"profile": M64_PROFILE} if operation[0] == "reconcile-m64-attempt" else {}),
            )
            return 0
        if len(operation) == 3 and operation[0] == "reconcile-f46-attempt":
            attempt_label = operation[1]
            expected_image = operation[2]
            instance_id = reconcile_uncertain_f46_launch(
                api_key, attempt_label, expected_image
            )
            emit_f46_cleanup_attestation(instance_id, attempt_label, expected_image)
            return 0
        if operation == ["launch-best-eu"]:
            eu_countries = {
                "AT", "BE", "BG", "HR", "CY", "CZ", "DE", "DK", "EE", "ES",
                "FI", "FR", "GR", "HU", "IE", "IS", "IT", "LT", "LU", "LV",
                "MT", "NL", "NO", "PL", "PT", "RO", "SE", "SI", "SK", "CH",
            }
            gpu_order = {"RTX 6000Ada": 0, "RTX 5880Ada": 1, "RTX PRO 5000": 2}
            candidates = [
                item
                for item in get_offers(api_key)
                if str(item.get("geolocation", "")).rsplit(", ", 1)[-1] in eu_countries
                and item.get("gpu_name") in gpu_order
                and float(item.get("reliability", 0)) >= 0.995
            ]
            candidates.sort(
                key=lambda item: (
                    gpu_order[str(item.get("gpu_name"))],
                    float(item.get("dph_total", item.get("dph", 999))),
                )
            )
            if not candidates:
                raise SafeError("no eligible European 48 GB offer is currently available")
            return launch_offer(api_key, candidates[0])
        if len(operation) == 2 and operation[0] in {"start", "stop"}:
            instance_id = positive_id(operation[1], "instance id")
            state = "running" if operation[0] == "start" else "stopped"
            set_instance_state_verified(api_key, instance_id, state)
            print_json(
                {
                    "instance_id": instance_id,
                    "requested_state": state,
                    "success": True,
                    "final_state_verified": True,
                }
            )
            return 0
        if len(operation) == 3 and operation[0] == "destroy" and operation[2] == "--confirm":
            instance_id = positive_id(operation[1], "instance id")
            destroy_instance_verified(api_key, instance_id)
            print_json({"instance_id": instance_id, "destroyed": True, "verified_absent": True})
            return 0
        raise SafeError(
            "usage: openbao-vastai --check|--auth-check|account-balance|picogk-offers|"
            "launch-picogk-m64 <offer_id> <absolute-manifest>|reconcile-picogk-m64 <absolute-manifest>|"
            "offers|heavy-offers|f46-offers|wave-offers|"
            "component-factory-f41-offers|mesh-offers|instances|"
            "m64-transfer <id> <absolute-manifest>|m64-phase <id> <absolute-manifest> <phase>|"
            "m64-collect <id> <absolute-manifest> <new-private-directory>|"
            "show <id>|ssh-keys <id>|ssh-endpoints <id>|attach-local-ssh <id>|refresh-local-ssh <id>|ensure-local-ssh|probe <id>|logs <id>|daemon-logs <id>|"
            "launch <offer_id>|launch-mesh <offer_id>|launch-wave-f39 <offer_id>|"
            "launch-component-factory-f41 <offer_id> [--attempt-label <label>]|"
            "launch-f46 <offer_id> <image@digest> <deadline_epoch> [--attempt-label <label>]|"
            "launch-simready-heavy <offer_id> [--attempt-label <label>]|"
            "launch-simready-validation-only <offer_id> [--attempt-label <label>]|"
            "launch-m64-heavy <offer_id> [--attempt-label <label>]|"
            "reconcile-simready-attempt <label>|"
            "reconcile-m64-attempt <label>|"
            "reconcile-f46-attempt <label> <image@digest>|launch-best-eu|"
            "start <id>|stop <id>|"
            "destroy <id> --confirm"
        )
    finally:
        revoke_token(token)


def main() -> int:
    if sys.argv[1:] == ["--check"]:
        validate_bootstrap_metadata()
        check_local_service()
        print("OpenBao Vast.ai reader check OK")
        return 0
    return run(sys.argv[1:])


def cli() -> int:
    """Render safe operator-facing errors and return a process exit status."""
    try:
        return main()
    except KeyboardInterrupt:
        print("OpenBao Vast.ai: cancelled", file=sys.stderr)
        return 130
    except SafeError as exc:
        print(f"OpenBao Vast.ai error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(cli())
