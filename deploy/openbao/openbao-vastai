def ensure_local_ssh_registered(api_key: str) -> None:
    try:
        result = vast_request(
            api_key,
            "/api/v0/ssh/",
            method="POST",
            payload={"ssh_key": read_local_ssh_public_key()},
        )
    except SafeError as exc:
        if "SSH key already exists on this account" in str(exc):
            return
        raise
    if result.get("success") is not True:
        raise SafeError("Vast.ai did not accept the approved SSH key")


def instance_lists_approved_ssh_key(api_key: str, instance_id: int, public_key: str) -> bool:
    """Check one instance's public metadata, not its in-container injection."""
    result = vast_request(api_key, f"/api/v0/instances/{instance_id}/ssh")
    raw_keys = result.get("ssh_keys")
    try:
        keys = json.loads(raw_keys) if isinstance(raw_keys, str) else raw_keys
    except json.JSONDecodeError:
        raise SafeError("Vast.ai returned invalid instance SSH key metadata") from None
    if not isinstance(keys, list):
        raise SafeError("Vast.ai returned invalid instance SSH key metadata")
    approved_identity = public_key.split()[:2]
    return any(
        isinstance(item, dict)
        and isinstance(item.get("public_key"), str)
        and item["public_key"].split()[:2] == approved_identity
        for item in keys
    )


def ensure_simready_instance_ssh_key(api_key: str, instance_id: int, attempt_label: str) -> None:
    """Attach only the approved key if missing, then require metadata proof."""
    if not is_simready_attempt_label(attempt_label):
        raise SafeError("SimReady SSH preflight attempt label is invalid")
    public_key = read_local_ssh_public_key()
    listed = instance_lists_approved_ssh_key(api_key, instance_id, public_key)
    attached = False
    if not listed:
        result = vast_request(
            api_key,
            f"/api/v0/instances/{instance_id}/ssh/",
            method="POST",
            payload={"ssh_key": public_key},
        )
        if result.get("success") is not True:
            raise SafeError("Vast.ai did not confirm approved instance SSH key attachment")
        attached = True
        for attempt in range(3):
            listed = instance_lists_approved_ssh_key(api_key, instance_id, public_key)
            if listed:
                break
            if attempt < 2:
                time.sleep(5)
    if not listed:
        raise SafeError("approved SSH key attachment was not visible in instance metadata")
    print(
        "OPENBAO_VASTAI_SIMREADY_SSH_PREFLIGHT " + json.dumps({
            "instance_id": instance_id,
            "label": attempt_label,
            "public_private_pair_verified": True,
            "approved_key_listed_by_provider": True,
            "approved_key_attached_by_this_preflight": attached,
            "runtime_authorized_keys_verified": False,
            "ssh_authentication_verified": False,
        }, sort_keys=True),
        file=sys.stderr,
        flush=True,
    )


