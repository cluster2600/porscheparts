    api_key: str,
    instance_id: int,
    attempt_label: str,
    expected_image: str,
    selected_offer: dict,
) -> dict:
    """Fail closed until the F46 instance repeats the selected paid contract."""
    if not is_f46_attempt_label(attempt_label):
        raise SafeError("F46 attempt label is invalid")
    if F46_IMAGE_RE.fullmatch(expected_image) is None:
        raise SafeError("F46 image must use the fixed repository and a complete digest")
    if not f46_offer_eligible(selected_offer):
        raise SafeError("F46 selected offer is outside the fixed contract")
    required_fields = (
        "id",
        "label",
        "status",
        "gpu",
        "gpu_ram_mb",
        "num_gpus",
        "gpu_fraction",
        "machine_verification",
        "cpu_cores_effective",
        "cpu_ram_mb",
        "disk_space_gb",
        "dph_total",
        "image",
    )
    for _ in range(F46_CONTRACT_ATTEMPTS):
        try:
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
        except SafeHttpError as exc:
            if exc.status_code == 404:
                time.sleep(POLL_INTERVAL_SECONDS)
                continue
            raise
        raw_instance = result.get("instances")
        if not isinstance(raw_instance, dict):
            raise SafeError("Vast.ai returned invalid post-launch F46 metadata")
        instance = safe_instance(raw_instance)
        if any(instance.get(field) is None for field in required_fields):
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        errors = []
        exact_contract = (
            (instance["id"], instance_id, "instance id"),
            (instance["label"], attempt_label, "attempt label"),
            (instance["image"], expected_image, "image digest"),
            (instance["gpu"], selected_offer.get("gpu_name"), "GPU name"),
            (finite_number(instance["num_gpus"]), 1.0, "GPU count"),
            (finite_number(instance["gpu_fraction"]), 1.0, "GPU fraction"),
        )
        for actual, expected, label in exact_contract:
            if actual != expected:
                errors.append(label)
        if instance["status"] not in {"created", "loading", "running"}:
            errors.append("status")
        for value, minimum, label in (
            (instance["gpu_ram_mb"], F46_MIN_GPU_RAM_MB, "GPU RAM"),
            (instance["cpu_cores_effective"], F46_MIN_CPU_CORES, "CPU cores"),
            (instance["cpu_ram_mb"], F46_MIN_CPU_RAM_MB, "CPU RAM"),
            (instance["disk_space_gb"], F46_MIN_DISK_GB, "disk"),
        ):
            actual = finite_number(value)
            if actual is None or actual < minimum:
                errors.append(label)
        instance_price = finite_number(instance["dph_total"])
        selected_price = finite_number(
            selected_offer.get("dph_total", selected_offer.get("dph"))
        )
        if (
            instance_price is None
            or selected_price is None
            or instance_price != selected_price
            or not 0 <= instance_price <= F46_MAX_DPH
        ):
            errors.append("dph_total")
        for value, maximum, label in (
            (
                instance["inet_up_cost_usd_per_gb"],
                F46_MAX_INET_UP_COST_USD_PER_GB,
                "inet_up_cost",
            ),
            (
                instance["inet_down_cost_usd_per_gb"],
                F46_MAX_INET_DOWN_COST_USD_PER_GB,
                "inet_down_cost",
            ),
        ):
            if value is None:
                continue
            cost = finite_number(value)
            if cost is None or not 0 <= cost <= maximum:
                errors.append(label)
        if instance["machine_verification"] != "verified":
            errors.append("machine verification")
        if errors:
            raise SafeError(
                "post-launch F46 contract is outside fixed limits: "
                + ", ".join(errors)
            )
        if instance["status"] != "running":
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        return instance
    raise SafeError("Vast.ai did not expose a complete running F46 contract in time")


def reconcile_uncertain_simready_launch(api_key: str, attempt_label: str) -> int:
    """Rollback only the instance correlated to one unique SimReady PUT."""
    if not is_simready_attempt_label(attempt_label):
        raise SafeError("SimReady attempt label is invalid")
    for _ in range(30):
        try:
            existing = [
                instance
                for instance in strict_instance_inventory(api_key)
                if instance.get("label") == attempt_label
            ]
        except SafeError:
            time.sleep(1)
            continue
        if existing:
            ids = sorted(
                instance.get("id")
                for instance in existing
                if instance.get("label") == attempt_label
            )
            if len(existing) == 1 and len(ids) == 1:
                destroy_instance_verified(
                    api_key,
                    ids[0],
                    expected_label=attempt_label,
                )
                return ids[0]
            raise SafeError(
                "launch outcome is uncertain and the unique SimReady attempt label "
                "is not mapped to one valid instance id; inspect instances before retrying"
            )
        time.sleep(1)
    raise SafeError(
        "launch outcome remains uncertain after the reconciliation window; "
        "do not retry automatically and inspect the unique SimReady attempt label first"
    )


