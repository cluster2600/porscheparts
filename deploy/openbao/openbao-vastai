def read_vast_key(token: str) -> str:
    secret_path = read_bootstrap_value(SECRET_PATH_FILE)
    if not secret_path.startswith("secrets/data/") or any(
        character not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-/"
        for character in secret_path
    ):
        raise SafeError("OpenBao Vast.ai API path is invalid")
    result = http_json(
        f"{BAO_ADDR}/v1/{secret_path}",
        headers={"X-Vault-Token": token},
        source="OpenBao",
    )
    payload = result.get("data", {}).get("data")
    if not isinstance(payload, dict):
        raise SafeError("OpenBao Vast.ai path is missing or empty")
    for field in ("VAST_API_KEY", "api_key"):
        value = payload.get(field)
        if isinstance(value, str) and value.strip():
            return value.strip()
    raise SafeError("OpenBao Vast.ai payload is missing the API key field")


def vast_request(
    api_key: str,
    path: str,
    *,
    method: str = "GET",
    payload: dict | None = None,
) -> dict:
    return http_json(
        f"{VAST_BASE}{path}",
        method=method,
        payload=payload,
        headers={"Authorization": f"Bearer {api_key}"},
        source="Vast.ai",
    )


def fetch_execution_result(url: str) -> str:
    parsed = urllib.parse.urlparse(url)
    allowed_paths = ("/vast.ai/instance_logs/", "/public.vast.ai/instance_logs/")
    if (
        parsed.scheme != "https"
        or parsed.hostname != "s3.amazonaws.com"
        or not parsed.path.startswith(allowed_paths)
    ):
        safe_prefix = "/".join(parsed.path.split("/")[:4])
        raise SafeError(
            "Vast.ai returned an unexpected execution result location: "
            f"{parsed.hostname or 'missing'}{safe_prefix}"
        )
    tls_context = ssl.create_default_context(cafile=str(TLS_CA_FILE))
    request = urllib.request.Request(url, method="GET")
    for _ in range(8):
        try:
            with urllib.request.urlopen(
                request,
                timeout=TIMEOUT_SECONDS,
                context=tls_context,
            ) as response:
                body = response.read(MAX_RESPONSE_BYTES + 1)
            if len(body) > MAX_RESPONSE_BYTES:
                raise SafeError("Vast.ai execution result is unexpectedly large")
            return body.decode("utf-8", errors="replace")
        except urllib.error.HTTPError as exc:
            if exc.code not in {403, 404}:
                raise SafeError(f"Vast.ai execution result returned HTTP {exc.code}") from None
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            raise SafeError("Vast.ai execution result is unavailable") from exc
        time.sleep(2)
    raise SafeError("Vast.ai execution result was not ready in time")


def list_instances(api_key: str, *, label: str | None = None) -> list[dict]:
    """Read every v1 page and locally enforce an optional exact label."""
    instances: list[dict] = []
    after_token: str | None = None
    seen_tokens: set[str] = set()
    for _ in range(100):
        parameters: dict[str, str | int] = {"limit": 25}
        if label is not None:
            parameters["select_filters"] = json.dumps(
                {"label": {"eq": label}}, separators=(",", ":")
            )
        if after_token is not None:
            parameters["after_token"] = after_token
        result = vast_request(
            api_key,
            "/api/v1/instances/?" + urllib.parse.urlencode(parameters),
        )
        page = result.get("instances")
        if result.get("success") is False or not isinstance(page, list):
            raise SafeError("Vast.ai instance list returned an invalid result")
        for instance in page:
            if not isinstance(instance, dict):
                raise SafeError("Vast.ai instance list contained invalid metadata")
            if label is None or instance.get("label") == label:
                instances.append(instance)
        candidate = result.get("next_token")
        if candidate is None:
            return instances
        if (
            not isinstance(candidate, str)
            or not candidate
            or len(candidate) > 4096
            or candidate in seen_tokens
        ):
            raise SafeError("Vast.ai instance pagination returned an invalid cursor")
        seen_tokens.add(candidate)
        after_token = candidate
    raise SafeError("Vast.ai instance pagination exceeded the safety limit")


@contextmanager
def simready_launch_lock():
    """Serialize project launches so two local callers cannot create duplicates."""
    directory = LAUNCH_LOCK_FILE.parent
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = directory.stat()
    if (
        info.st_uid != os.getuid()
        or not stat.S_ISDIR(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        raise SafeError(f"launch lock directory has unsafe ownership or type: {directory}")
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(LAUNCH_LOCK_FILE, flags, 0o600)
    try:
        lock_info = os.fstat(descriptor)
        if (
            lock_info.st_uid != os.getuid()
            or not stat.S_ISREG(lock_info.st_mode)
            or stat.S_IMODE(lock_info.st_mode) != 0o600
        ):
            raise SafeError("SimReady launch lock has unsafe ownership, type, or permissions")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise SafeError("another SimReady launch is already in progress") from exc
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


