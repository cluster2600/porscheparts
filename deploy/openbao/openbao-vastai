        if not isinstance(raw_instance, dict):
            raise SafeError("Vast.ai returned invalid SimReady SSH endpoint metadata")
        instance = safe_instance(raw_instance)
        last_state = str(instance.get("status") or "unknown")
        if last_state != "running":
            if last_state not in {"created", "loading"}:
                raise SafeError(
                    "SimReady instance left running state before SSH READY verification: "
                    f"{last_state}"
