def read_local_ssh_public_key() -> str:
    validate_approved_ssh_private_key()
    try:
        info = SSH_PUBLIC_KEY_FILE.lstat()
    except FileNotFoundError as exc:
        raise SafeError(f"missing approved SSH public key: {SSH_PUBLIC_KEY_FILE}") from exc
    if (
        info.st_uid != os.getuid()
        or not stat.S_ISREG(info.st_mode)
        or info.st_size <= 0
        or info.st_size > 16384
    ):
        raise SafeError(f"approved SSH public key is invalid: {SSH_PUBLIC_KEY_FILE}")
    value = SSH_PUBLIC_KEY_FILE.read_text(encoding="utf-8").strip()
    if not value.startswith(("ssh-ed25519 ", "ssh-rsa ", "ecdsa-sha2-")):
        raise SafeError("approved SSH public key is not in OpenSSH format")
    return value


def validate_approved_ssh_private_key() -> None:
    """Validate metadata only; never read or print the private key."""
    try:
        info = SSH_PRIVATE_KEY_FILE.lstat()
    except FileNotFoundError as exc:
        raise SafeError(
            f"missing approved SSH private key: {SSH_PRIVATE_KEY_FILE}"
        ) from exc
    if (
        info.st_uid != os.getuid()
        or not stat.S_ISREG(info.st_mode)
        or stat.S_IMODE(info.st_mode) & 0o077
        or info.st_size <= 0
        or info.st_size > 1024 * 1024
    ):
        raise SafeError(
            "approved SSH private key has unsafe ownership, type, permissions, or size: "
            f"{SSH_PRIVATE_KEY_FILE}"
        )


def prepare_component_factory_f41_known_hosts(instance_id: int) -> Path:
    """Create one persistent, private TOFU file for this exact Vast instance."""
    if not isinstance(instance_id, int) or isinstance(instance_id, bool) or instance_id <= 0:
        raise SafeError("F41 instance id is invalid for scoped known_hosts")
    parent = COMPONENT_FACTORY_F41_KNOWN_HOSTS_DIR.parent
    parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    for directory in (parent, COMPONENT_FACTORY_F41_KNOWN_HOSTS_DIR):
        directory.mkdir(mode=0o700, exist_ok=True)
        info = directory.lstat()
        if (
            info.st_uid != os.getuid()
            or not stat.S_ISDIR(info.st_mode)
            or stat.S_IMODE(info.st_mode) != 0o700
        ):
            raise SafeError(f"F41 known_hosts directory is unsafe: {directory}")
    path = COMPONENT_FACTORY_F41_KNOWN_HOSTS_DIR / f"f41-{instance_id}"
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags, 0o600)
    except FileExistsError as exc:
        raise SafeError(f"F41 scoped known_hosts already exists: {path}") from exc
    try:
        info = os.fstat(descriptor)
