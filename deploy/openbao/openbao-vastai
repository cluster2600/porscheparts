def set_instance_state_verified(api_key: str, instance_id: int, state: str) -> None:
    if state not in {"running", "stopped"}:
        raise SafeError("unsupported instance target state")
    result = vast_request(
        api_key,
        f"/api/v0/instances/{instance_id}/",
        method="PUT",
        payload={"state": state},
    )
    if result.get("success") is not True:
        raise SafeError(f"Vast.ai did not confirm the {state} request")
    for _ in range(STATE_TRANSITION_ATTEMPTS):
        metadata = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
        raw_instance = metadata.get("instances")
        if not isinstance(raw_instance, dict):
            raise SafeError("Vast.ai returned invalid state-transition metadata")
        actual_state = safe_instance(raw_instance).get("status")
        if actual_state == state:
            return
        time.sleep(POLL_INTERVAL_SECONDS)
    raise SafeError(
        f"Vast.ai did not verify final instance state {state} in time"
    )


