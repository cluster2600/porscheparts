def m64_json(payload: bytes) -> dict:
    """Reject ambiguous JSON, including duplicate fields and non-finite values."""
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                raise ValueError("duplicate field")
            result[key] = value
        return result

    def invalid_constant(_):
        raise ValueError("non-finite JSON number")

    try:
        result = json.loads(payload, object_pairs_hook=pairs, parse_constant=invalid_constant)
    except (ValueError, UnicodeError, RecursionError) as exc:
        raise SafeError("M64 manifest or receipt is not strict JSON") from exc
    if not isinstance(result, dict):
        raise SafeError("M64 manifest or receipt must be an object")
    return result


def m64_relative_path(value: object) -> str:
    if (
        not isinstance(value, str) or len(value) > 240
        or not re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", value)
        or any(part in {".", ".."} or part.startswith(".") for part in value.split("/"))
    ):
        raise SafeError("M64 path is outside the fixed relative-path contract")
    return value


def m64_no_symlink_path(path: Path) -> None:
    if not path.is_absolute():
        raise SafeError("M64 local paths must be absolute")
    for component in (*reversed(path.parents), path):
        try:
            if stat.S_ISLNK(component.lstat().st_mode):
                raise SafeError("M64 symlink paths are forbidden")
        except FileNotFoundError:
            raise SafeError("M64 required local path is missing") from None


def m64_read_file(path: Path, maximum: int) -> bytes:
    m64_no_symlink_path(path)
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as stream:
            info = os.fstat(stream.fileno())
            if (
                not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or info.st_mode & 0o022
                or not 0 <= info.st_size <= maximum
            ):
                raise SafeError("M64 local file metadata or size is unsafe")
            payload = stream.read(maximum + 1)
            after = os.fstat(stream.fileno())
            if (
                len(payload) != info.st_size or len(payload) > maximum
                or (info.st_size, info.st_mtime_ns) != (after.st_size, after.st_mtime_ns)
            ):
                raise SafeError("M64 local file changed while being read")
            return payload
    except OSError as exc:
        raise SafeError("M64 local file could not be read safely") from exc


def m64_entries(items: object, *, outputs: bool = False) -> dict[str, dict]:
    if not isinstance(items, list) or not 1 <= len(items) <= (128 if outputs else 4096):
        raise SafeError("M64 file list is missing or exceeds its bound")
    result = {}
    folded = set()
    total = 0
    for entry in items:
        fields = {"path", "max_bytes"} if outputs else {"path", "size", "sha256"}
        if not isinstance(entry, dict) or set(entry) != fields:
            raise SafeError("M64 file entry has unexpected fields")
        path = m64_relative_path(entry["path"])
        size = entry["max_bytes" if outputs else "size"]
        if type(size) is not int or not 0 <= size <= M64_MAX_BUNDLE_BYTES:
            raise SafeError("M64 file size is invalid")
        if outputs:
            if not path.startswith("results/") or size == 0:
                raise SafeError("M64 outputs must be bounded files under results")
        elif not isinstance(entry["sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", entry["sha256"]):
            raise SafeError("M64 file SHA256 is invalid")
        if path.casefold() in folded:
            raise SafeError("M64 duplicate or case-ambiguous file paths are forbidden")
        folded.add(path.casefold())
        result[path] = entry
        total += size
    if total > (M64_MAX_RESULTS_BYTES if outputs else M64_MAX_BUNDLE_BYTES):
        raise SafeError("M64 total file bytes exceed the fixed limit")
    for path in result:
        if any(str(parent).casefold() in folded for parent in Path(path).parents if str(parent) != "."):
            raise SafeError("M64 a file path cannot also be a directory")
    return result


def m64_load_bundle(path: Path, instance_id: int) -> tuple[dict, bytes, dict[str, bytes]]:
    """Snapshot and hash the same bytes that will be transferred; never execute them locally."""
    payload = m64_read_file(path, M64_MAX_MANIFEST_BYTES)
    manifest = m64_json(payload)
    if set(manifest) != {
        "schema_version", "profile", "job_id", "instance_id", "label", "image",
        "created_epoch", "deadline_epoch", "max_dph", "budget_usd", "files", "outputs",
    }:
        raise SafeError("M64 transport manifest fields do not match the fixed contract")
    if manifest["schema_version"] != "1.0.0" or manifest["profile"] != M64_PROFILE:
        raise SafeError("M64 manifest schema or profile is not approved")
    if not isinstance(manifest["job_id"], str) or not re.fullmatch(r"m64-[a-z0-9][a-z0-9-]{0,63}", manifest["job_id"]):
        raise SafeError("M64 job id is invalid")
    if type(manifest["instance_id"]) is not int or manifest["instance_id"] != instance_id or instance_id <= 0:
        raise SafeError("M64 manifest is bound to a different instance")
    if not is_simready_attempt_label(manifest["label"]) or manifest["image"] != M64_SIMREADY_IMAGE:
        raise SafeError("M64 manifest label or image digest is not approved")
    created, deadline = manifest["created_epoch"], manifest["deadline_epoch"]
    if type(created) is not int or type(deadline) is not int or created <= 0 or not 0 < deadline - created <= M64_MAX_JOB_SECONDS:
        raise SafeError("M64 absolute job lifetime must be bounded to two hours")
    for key, cap in (("max_dph", HEAVY_MAX_DPH), ("budget_usd", M64_MAX_BUDGET_USD)):
        value = manifest[key]
        if type(value) not in (int, float) or not math.isfinite(value) or not 0 < value <= cap:
            raise SafeError("M64 rate or remaining budget allocation is invalid")
    entries = m64_entries(manifest["files"])
    outputs = m64_entries(manifest["outputs"], outputs=True)
    if not M64_INPUTS | {"code-manifest.json"} <= entries.keys():
        raise SafeError("M64 requires the code manifest and all four fixed inputs")
    if not isinstance(M64_APPROVED_CODE_MANIFEST_SHA256, str) or not re.fullmatch(r"[0-9a-f]{64}", M64_APPROVED_CODE_MANIFEST_SHA256):
        raise SafeError("M64 code manifest is not yet pinned by the reviewed wrapper")
    files = {}
    for relative, entry in entries.items():
        content = m64_read_file(path.parent / relative, entry["size"])
        if len(content) != entry["size"] or hashlib.sha256(content).hexdigest() != entry["sha256"]:
            raise SafeError("M64 bundle file does not match its declared size and SHA256")
        files[relative] = content
    code_bytes = files["code-manifest.json"]
    if hashlib.sha256(code_bytes).hexdigest() != M64_APPROVED_CODE_MANIFEST_SHA256:
        raise SafeError("M64 code manifest is not the approved immutable code bundle")
    code = m64_json(code_bytes)
    if set(code) != {"schema_version", "profile", "files"} or code["schema_version"] != "1.0.0" or code["profile"] != M64_PROFILE:
        raise SafeError("M64 code manifest schema or profile is invalid")
    code_entries = m64_entries(code["files"])
    if any(not name.startswith(("phases/", "skill/")) for name in code_entries):
        raise SafeError("M64 code is outside the two approved code directories")
    if not {"phases/common.py", *(f"phases/{phase}.py" for phase in M64_PHASES)} <= code_entries.keys():
        raise SafeError("M64 code manifest is missing a fixed phase or its shared helper")
    if set(entries) != set(code_entries) | M64_INPUTS | {"code-manifest.json"} or any(entries[name] != entry for name, entry in code_entries.items()):
        raise SafeError("M64 bundle contains undeclared code or divergent code hashes")
    # Allocation is a remaining, user-authorized cap, not a claim about the
    # provider's account-wide invoice. The external instance watchdog remains required.
    transfer_reserve = 2 * (sum(item["size"] for item in entries.values()) + sum(item["max_bytes"] for item in outputs.values())) / 1e9 * M64_MAX_TRANSFER_RATE_USD_PER_GB
    if manifest["max_dph"] * (deadline - created) / 3600 + transfer_reserve > manifest["budget_usd"]:
        raise SafeError("M64 lifetime and bounded transfers exceed the allocated budget")
    return manifest, payload, files


def m64_start_deadline(manifest: dict) -> float:
    now = time.time()
    if now < manifest["created_epoch"] or now >= manifest["deadline_epoch"]:
        raise SafeError("M64 start is outside the immutable job deadline")
    return manifest["deadline_epoch"] - now


def m64_verified_ssh(api_key: str, manifest: dict, *, collecting: bool) -> list[str]:
    instance_id = manifest["instance_id"]
    if not collecting:
        m64_start_deadline(manifest)
    verify_single_simready_instance(api_key, instance_id, manifest["label"])
    if not collecting:
        verify_simready_contract(api_key, instance_id, manifest["label"], profile=M64_PROFILE)
    result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
    raw = result.get("instances")
    if not isinstance(raw, dict):
        raise SafeError("M64 instance lookup returned invalid metadata")
    instance = safe_instance(raw)
    if (
        type(instance["id"]) is not int or instance["id"] != instance_id
        or instance["label"] != manifest["label"] or instance["image"] != manifest["image"]
        or instance["status"] != "running"
    ):
        raise SafeError("M64 requires its exact running instance, label and image digest")
    if not collecting:
        price = finite_number(instance["dph_total"])
        if price is None or not 0 <= price <= manifest["max_dph"]:
            raise SafeError("M64 instance rate exceeds its immutable allocation")
        for field in ("inet_up_cost_usd_per_gb", "inet_down_cost_usd_per_gb"):
            rate = finite_number(instance[field])
            if rate is None or not 0 <= rate <= M64_MAX_TRANSFER_RATE_USD_PER_GB:
                raise SafeError("M64 data transfer rate is unavailable or over its cap")
    public_key = read_local_ssh_public_key()  # Also verifies the cryptographic key pair.
    if not instance_lists_approved_ssh_key(api_key, instance_id, public_key):
        raise SafeError("M64 approved public key is not listed on this exact instance")
    known_hosts = SIMREADY_KNOWN_HOSTS_DIR / simready_host_key_alias(instance_id)
    m64_no_symlink_path(known_hosts)
    validate_simready_known_hosts(known_hosts, instance_id)
    endpoint = m64_ssh_endpoint(raw, instance_id)
    host = endpoint["host"] if endpoint else None
    port = finite_number(endpoint["port"]) if endpoint else None
    if (
        not isinstance(host, str) or len(host) > 253
        or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.:-]*", host)
        or port is None or not port.is_integer() or not 1 <= port <= 65535
    ):
        raise SafeError("M64 verified SSH endpoint is unavailable")
    if not collecting:
        m64_start_deadline(manifest)
    options = (
        "BatchMode=yes", "IdentitiesOnly=yes", "ForwardAgent=no", "ClearAllForwardings=yes",
        "PermitLocalCommand=no", "PasswordAuthentication=no", "KbdInteractiveAuthentication=no",
        "ConnectionAttempts=1", "ConnectTimeout=5", "StrictHostKeyChecking=yes",
        "UpdateHostKeys=no", "GlobalKnownHostsFile=/dev/null", "HashKnownHosts=no",
        f"HostKeyAlias={simready_host_key_alias(instance_id)}", f"UserKnownHostsFile={known_hosts}",
        "LogLevel=ERROR", "ServerAliveInterval=15", "ServerAliveCountMax=4",
    )
    command = ["ssh", "-F", "/dev/null", "-T", "-i", str(SSH_PRIVATE_KEY_FILE)]
    for option in options:
        command.extend(("-o", option))
    command.extend(("-p", str(int(port)), f"root@{host}"))
    return command


# This is a transport and single-phase guard, not an Omniverse workflow runner.
# No command, interpreter, argv, remote path or code digest comes from user input.
# The stdin document is constructed only after m64_load_bundle has validated it.
M64_REMOTE_HELPER = r'''
import base64, fcntl, hashlib, json, os, re, resource, signal, stat, subprocess, sys, time
from pathlib import Path
ROOT = Path("/workspace/jobs")
PIN = "__M64_CODE_PIN__"
PHASES = ("preflight", "context", "convert", "minimum", "material", "physics", "profile-initial", "conform", "asset-validation", "geometry-validation", "physics-validation", "profile-validation", "render")
MAX_BYTES = 128 * 1024 * 1024
MAX_WIRE = 180 * 1024 * 1024

def fail():
    raise ValueError("fixed M64 transport contract rejected")

def digest(data):
    return hashlib.sha256(data).hexdigest()

def decoded(value):
    return base64.b64decode(value, validate=True)

def checked(path, directory=False):
    for part in (*reversed(path.parents), path):
        meta = part.lstat()
        if stat.S_ISLNK(meta.st_mode):
            fail()
    meta = path.lstat()
    if meta.st_uid != os.getuid() or meta.st_mode & 0o022:
        fail()
    if directory:
        if not stat.S_ISDIR(meta.st_mode):
            fail()
    elif not stat.S_ISREG(meta.st_mode) or meta.st_nlink != 1:
        fail()

def relative(value):
    if not isinstance(value, str) or len(value) > 240 or not re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", value):
        fail()
    if any(x in (".", "..") or x.startswith(".") for x in value.split("/")):
        fail()
    return value

def read(path, maximum):
    checked(path)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > maximum:
            fail()
        value = stream.read(maximum + 1)
        after = os.fstat(stream.fileno())
        if len(value) != before.st_size or len(value) > maximum or (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
            fail()
        return value

def write(path, payload, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    checked(path.parent, directory=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "wb") as stream:
        stream.write(payload)

def main():
    os.umask(0o077)
    wire = sys.stdin.buffer.read(MAX_WIRE + 1)
    if len(wire) > MAX_WIRE:
        fail()
    request = json.loads(wire)
    if set(request) != {"operation", "manifest_b64", "manifest_sha256", "files_b64", "phase", "timeout_seconds"}:
        fail()
    operation = request["operation"]
    if operation not in ("transfer", "phase", "collect"):
        fail()
    manifest_bytes = decoded(request["manifest_b64"])
    if digest(manifest_bytes) != request["manifest_sha256"]:
        fail()
    manifest = json.loads(manifest_bytes)
    job = manifest["job_id"]
    if manifest["profile"] != "m64-omni-static-v1" or not re.fullmatch(r"m64-[a-z0-9][a-z0-9-]{0,63}", job):
        fail()
    entries = {relative(item["path"]): item for item in manifest["files"]}
    outputs = {relative(item["path"]): item for item in manifest["outputs"]}
    if len(entries) != len(manifest["files"]) or len(outputs) != len(manifest["outputs"]):
        fail()
    if any(not name.startswith("results/") for name in outputs) or sum(x["max_bytes"] for x in outputs.values()) > MAX_BYTES:
        fail()
    if entries["code-manifest.json"]["sha256"] != PIN or sum(x["size"] for x in entries.values()) > MAX_BYTES:
        fail()
    if operation != "collect" and not manifest["created_epoch"] <= time.time() < manifest["deadline_epoch"]:
        fail()
    ROOT.mkdir(exist_ok=True, mode=0o700)
    checked(ROOT, directory=True)
    root = ROOT / job
    if operation == "transfer":
        if set(request["files_b64"]) != set(entries):
            fail()
        payloads = {}
        for name, entry in entries.items():
            data = decoded(request["files_b64"][name])
            if len(data) != entry["size"] or digest(data) != entry["sha256"]:
                fail()
            payloads[name] = data
        root.mkdir(mode=0o700)  # No overwrite, merge or replacement of a prior job.
        write(root / "job-manifest.json", manifest_bytes, 0o400)
        for name, data in payloads.items():
            write(root / name, data, 0o400)
        (root / "results").mkdir(mode=0o700)
    checked(root, directory=True)
    if read(root / "job-manifest.json", 1024 * 1024) != manifest_bytes:
        fail()
    lock_path = root / ".transport.lock"
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lock_fd, "r+b") as lock:
        checked(lock_path)
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        def verify_inputs():
            for name, entry in entries.items():
                value = read(root / name, entry["size"])
                if len(value) != entry["size"] or digest(value) != entry["sha256"]:
                    fail()
            # Imports or subprocesses must not find added code in either tree.
            actual = set()
            for folder in ("phases", "skill"):
                checked(root / folder, directory=True)
                for path in (root / folder).rglob("*"):
                    checked(path, directory=path.is_dir())
                    if path.is_file():
                        actual.add(str(path.relative_to(root)))
            if actual != {name for name in entries if name.startswith(("phases/", "skill/"))}:
                fail()
        verify_inputs()
        response = {"schema_version": "1.0.0", "job_id": job, "instance_id": manifest["instance_id"], "operation": operation, "manifest_sha256": digest(manifest_bytes)}
        if operation == "phase":
            phase = request["phase"]
            seconds = request["timeout_seconds"]
            if phase not in PHASES or type(seconds) is not int or not 1 <= seconds <= 1800:
                fail()
            seconds = min(seconds, int(manifest["deadline_epoch"] - time.time()))
            if seconds < 1:
                fail()
            log_path = root / "results" / "wrapper" / (phase + ".log")
            log_path.parent.mkdir(mode=0o700, exist_ok=True)
            checked(log_path.parent, directory=True)
            fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            timed_out = False
            def limits():
                resource.setrlimit(resource.RLIMIT_FSIZE, (MAX_BYTES, MAX_BYTES))
            with os.fdopen(fd, "wb") as log:
                process = subprocess.Popen(
                    ["/opt/simready-validation/bin/python", "-B", "-E", "-s", str(root / "phases" / (phase + ".py")), "--job-root", str(root)],
                    cwd=root, env={"PATH": "/opt/simready-validation/bin:/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8", "PYTHONDONTWRITEBYTECODE": "1"},
                    stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                    start_new_session=True, preexec_fn=limits,
                )
                try:
                    code = process.wait(timeout=seconds)
                except subprocess.TimeoutExpired:
                    timed_out = True
                    os.killpg(process.pid, signal.SIGTERM)
                    try:
                        process.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        os.killpg(process.pid, signal.SIGKILL)
                        process.wait(timeout=5)
                    code = 124
            verify_inputs()
            response.update(phase=phase, exit_code=code, timed_out=timed_out)
            write(root / "results" / "wrapper" / (phase + ".json"), json.dumps(response, sort_keys=True).encode())
        elif operation == "collect":
            found, missing, present = {}, [], []
            visited = 0
            for name, entry in outputs.items():
                path = root / name
                # A missing file is reportable; dangling or parent symlinks are not.
                for part in path.relative_to(root).parents:
                    candidate = root / part
                    if candidate.is_symlink():
                        fail()
                if not path.exists() and not path.is_symlink():
                    missing.append(name)
                    continue
                checked(path, directory=path.is_dir())
                candidates = path.rglob("*") if path.is_dir() else [path]
                used = 0
                for candidate in candidates:
                    visited += 1
                    if visited > 8192:
                        fail()
                    # Every visited node is checked, including empty directories.
                    checked(candidate, directory=candidate.is_dir())
                    if candidate.is_dir():
                        continue
                    relative_name = relative(str(candidate.relative_to(root)))
                    if relative_name in found or len(found) >= 1024:
                        fail()
                    data = read(candidate, entry["max_bytes"] - used)
                    used += len(data)
                    if used > entry["max_bytes"]:
                        fail()
                    found[relative_name] = {"size": len(data), "sha256": digest(data), "base64": base64.b64encode(data).decode()}
                present.append(name)
            response.update(files=found, present_outputs=present, missing_outputs=missing)
        print(json.dumps(response, separators=(",", ":")), flush=True)

