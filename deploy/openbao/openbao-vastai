def destroy_instance_verified(
    api_key: str,
    instance_id: int,
    *,
    expected_label: str | None = None,
    expected_image: str | None = None,
) -> None:
    if (
        not isinstance(instance_id, int)
        or isinstance(instance_id, bool)
        or instance_id <= 0
    ):
        raise SafeError("refusing to destroy an invalid Vast.ai instance id")
    inventory = strict_instance_inventory(api_key)
    matches = [item for item in inventory if item.get("id") == instance_id]
    if len(matches) != 1:
        raise SafeError("Vast.ai instance identity was not observed exactly once before destroy")
    identity = safe_instance(matches[0])
    if expected_label is not None and identity.get("label") != expected_label:
        raise SafeError("refusing to destroy a Vast.ai instance with an unexpected label")
    if expected_image is not None and identity.get("image") != expected_image:
        raise SafeError("refusing to destroy a Vast.ai instance with an unexpected image")

    def request_delete() -> None:
        result = vast_request(
            api_key,
            f"/api/v0/instances/{instance_id}/",
            method="DELETE",
        )
        if set(result) != {"success"} or result.get("success") is not True:
            raise SafeError("Vast.ai did not return the exact destroy acknowledgement")

    request_delete()
    consecutive_absent = 0
    for _ in range(DESTROY_VERIFY_ATTEMPTS):
        try:
            ids = {instance.get("id") for instance in strict_instance_inventory(api_key)}
        except SafeError:
            consecutive_absent = 0
            time.sleep(1)
            continue
        if instance_id not in ids:
            consecutive_absent += 1
            if consecutive_absent >= DESTROY_ABSENCE_STABILITY_SNAPSHOTS:
                return
        else:
            consecutive_absent = 0
            request_delete()
        time.sleep(1)
    raise SafeError(
        "Vast.ai paginated instance list did not verify stable destruction"
    )


def offer_query(offer_id: int | None = None) -> dict:
    query = {
        "num_gpus": {"eq": 1},
        "gpu_ram": {"gte": 45000},
        "cpu_cores_effective": {"gte": 12},
        "cpu_ram": {"gte": 64000},
        "disk_space": {"gte": 250},
        "reliability": {"gte": 0.99},
        "verified": {"eq": True},
        "rentable": {"eq": True},
        "rented": {"eq": False},
        "type": "on-demand",
        "limit": 50,
    }
    if offer_id is not None:
        # The search endpoint does not reliably honor an id predicate. Fetch a
        # wider bounded set and match the selected offer locally instead.
        query["limit"] = 1000
    return query


def get_offers(api_key: str, offer_id: int | None = None) -> list[dict]:
    result = vast_request(
        api_key,
        "/api/v0/bundles",
        method="POST",
        payload=offer_query(offer_id),
    )
    offers = result.get("offers")
    if not isinstance(offers, list):
        raise SafeError("Vast.ai offer search returned an invalid result")
    eligible = []
    for offer in offers:
        if not isinstance(offer, dict):
            continue
        price = offer.get("dph_total", offer.get("dph"))
        if isinstance(price, (int, float)) and price <= MAX_DPH:
            eligible.append(offer)
    return sorted(eligible, key=lambda item: float(item.get("dph_total", item.get("dph", 999))))


