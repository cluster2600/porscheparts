        api_key,
        f"/api/v0/asks/{offer_id}/",
        method="PUT",
        payload={
            "image": IMAGE,
            "label": LABEL,
            "disk": 200,
            "runtype": "ssh_direct",
            "env": {"MODEL_ID": MODEL, "-p 8000:8000": "1"},
