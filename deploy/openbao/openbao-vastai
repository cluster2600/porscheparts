def verify_single_simready_instance(api_key: str, instance_id: int) -> None:
    for _ in range(30):
        ids = sorted(
            instance.get("id")
            for instance in list_instances(api_key, label=SIMREADY_LABEL)
            if isinstance(instance.get("id"), int)
        )
        if ids == [instance_id]:
            return
        if ids:
            raise SafeError("SimReady post-launch uniqueness verification failed")
        time.sleep(1)
    raise SafeError("the new SimReady instance did not appear in the paginated instance list")


def verify_single_wave_instance(api_key: str, instance_id: int) -> None:
    """Require the exact newly created id to be the sole F39-labelled instance."""
    for _ in range(30):
        existing = list_instances(api_key, label=WAVE_LABEL)
        ids = sorted(
            instance.get("id")
            for instance in existing
            if isinstance(instance.get("id"), int)
            and not isinstance(instance.get("id"), bool)
        )
        if len(existing) == 1 and ids == [instance_id]:
            return
        if existing:
            raise SafeError("wave-action F39 post-launch uniqueness verification failed")
        time.sleep(1)
    raise SafeError(
        "the new wave-action F39 instance did not appear in the paginated instance list"
    )


def verify_single_component_factory_f41_instance(
    api_key: str, instance_id: int, attempt_label: str
) -> None:
    """Require the created id to be the sole instance in the whole F41 family."""
    if not is_component_factory_f41_attempt_label(attempt_label):
        raise SafeError("component-factory F41 attempt label is invalid")
    appeared = False
    stable_snapshots = 0
    for _ in range(30):
        existing = [
            instance
            for instance in list_instances(api_key)
            if is_component_factory_f41_family_label(instance.get("label"))
        ]
        ids = sorted(
            instance.get("id")
            for instance in existing
            if isinstance(instance.get("id"), int)
            and not isinstance(instance.get("id"), bool)
            and instance.get("label") == attempt_label
        )
        if len(existing) == 1 and ids == [instance_id]:
            appeared = True
            stable_snapshots += 1
            if (
                stable_snapshots
                >= COMPONENT_FACTORY_F41_SINGLETON_STABILITY_SNAPSHOTS
            ):
                return
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        if existing:
            raise SafeError(
                "component-factory F41 post-launch uniqueness verification failed"
            )
        if appeared:
            raise SafeError(
                "component-factory F41 family changed during singleton stability window"
            )
        time.sleep(1)
    raise SafeError(
        "the new component-factory F41 instance did not appear in the "
        "paginated instance list"
    )


def verify_simready_contract(api_key: str, instance_id: int) -> None:
    """Fail closed on immutable/cost fields as soon as Vast exposes the contract."""
    required_fields = (
        "id", "label", "status", "gpu", "gpu_ram_mb", "num_gpus",
        "gpu_fraction", "machine_verification", "cpu_cores_effective",
        "cpu_ram_mb", "disk_space_gb", "dph_total", "image",
    )
    for _ in range(30):
        try:
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
        except SafeHttpError as exc:
            if exc.status_code == 404:
                time.sleep(1)
                continue
            raise
        raw_instance = result.get("instances")
        if not isinstance(raw_instance, dict):
            raise SafeError("Vast.ai returned invalid post-launch instance metadata")
        instance = safe_instance(raw_instance)
        if any(instance.get(field) is None for field in required_fields):
            time.sleep(1)
            continue
        errors = []
        if instance["id"] != instance_id:
            errors.append("instance id")
        if instance["label"] != SIMREADY_LABEL:
            errors.append("label")
        if instance["image"] != SIMREADY_IMAGE:
            errors.append("image digest")
        if instance["status"] not in {"created", "loading", "running"}:
            errors.append("status")
        if instance["gpu"] != HEAVY_GPU_NAME:
            errors.append("GPU name")
        numeric_contract = (
            (instance["num_gpus"], 1, "GPU count", True),
            (instance["gpu_fraction"], 1, "GPU fraction", True),
            (instance["gpu_ram_mb"], HEAVY_MIN_GPU_RAM_MB, "GPU RAM", False),
            (instance["cpu_cores_effective"], HEAVY_MIN_CPU_CORES, "CPU cores", False),
            (instance["cpu_ram_mb"], HEAVY_MIN_CPU_RAM_MB, "CPU RAM", False),
            (instance["disk_space_gb"], HEAVY_MIN_DISK_GB, "disk", False),
        )
        for value, limit, label, exact in numeric_contract:
            number = finite_number(value)
            if number is None or (number != limit if exact else number < limit):
                errors.append(label)
        price = finite_number(instance["dph_total"])
        if price is None or not 0 <= price <= HEAVY_MAX_DPH:
            errors.append("dph_total")
        if instance["machine_verification"] != "verified":
            errors.append("machine verification")
        if errors:
            raise SafeError(
                "post-launch contract is outside the fixed SimReady limits: "
                + ", ".join(errors)
            )
        return
    raise SafeError("Vast.ai did not expose complete post-launch contract metadata in time")


def verify_wave_contract(api_key: str, instance_id: int) -> dict:
    """Fail closed until the complete immutable F39 contract is running."""
    required_fields = (
        "id",
        "label",
        "status",
        "machine_verification",
        "cpu_cores_effective",
        "cpu_ram_mb",
        "disk_space_gb",
        "dph_total",
        "image",
    )
    for _ in range(WAVE_CONTRACT_ATTEMPTS):
        try:
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
        except SafeHttpError as exc:
            if exc.status_code == 404:
                time.sleep(POLL_INTERVAL_SECONDS)
                continue
            raise
        raw_instance = result.get("instances")
        if not isinstance(raw_instance, dict):
            raise SafeError("Vast.ai returned invalid post-launch F39 instance metadata")
        instance = safe_instance(raw_instance)
        if any(instance.get(field) is None for field in required_fields):
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        errors = []
        if instance["id"] != instance_id:
            errors.append("instance id")
        if instance["label"] != WAVE_LABEL:
            errors.append("label")
        if instance["image"] != WAVE_IMAGE:
            errors.append("image digest")
        if instance["status"] not in {"created", "loading", "running"}:
            errors.append("status")
        numeric_contract = (
            (
                instance["cpu_cores_effective"],
                WAVE_MIN_CPU_THREADS,
                "effective CPU threads",
            ),
            (instance["cpu_ram_mb"], WAVE_MIN_CPU_RAM_MB, "CPU RAM"),
            (instance["disk_space_gb"], WAVE_DISK_GB, "disk"),
        )
        for value, minimum, label in numeric_contract:
            number = finite_number(value)
            if number is None or number < minimum:
                errors.append(label)
        price = finite_number(instance["dph_total"])
        if price is None or not 0 <= price <= WAVE_MAX_DPH:
            errors.append("dph_total")
        if instance["machine_verification"] != "verified":
            errors.append("machine verification")
        if errors:
            raise SafeError(
                "post-launch contract is outside the fixed wave-action F39 limits: "
                + ", ".join(errors)
            )
        if instance["status"] != "running":
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        return instance
    raise SafeError(
        "Vast.ai did not expose a complete running post-launch F39 contract in time"
    )


