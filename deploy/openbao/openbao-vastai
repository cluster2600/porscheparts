            raise
        except SafeError:
            reconcile_uncertain_wave_launch(api_key)
            raise
        instance_id = result.get("new_contract")
        if not isinstance(instance_id, int) or isinstance(instance_id, bool):
            reconcile_uncertain_wave_launch(api_key)
            raise SafeError("Vast.ai did not return a new wave-action instance id")
        try:
            verify_single_wave_instance(api_key, instance_id)
            verify_wave_contract(api_key, instance_id)
            verify_wave_ssh_ready(api_key, instance_id)
        except SafeError:
            try:
                destroy_instance_verified(api_key, instance_id)
            except SafeError as cleanup_error:
                raise SafeError(
                    "post-launch F39 verification failed and rollback was not "
                    f"verified for instance {instance_id}"
                ) from cleanup_error
            raise
        print_json(
            {
                "instance_id": instance_id,
                "image": WAVE_IMAGE,
                "label": WAVE_LABEL,
                "selected_offer": safe_offer(offer),
                "offer_contract_verified": True,
                "singleton_preflight_verified": True,
                "singleton_verified": True,
                "contract_verified": True,
                "running_state_verified": True,
                "ssh_batch_mode_verified": True,
                "runtime_smoke_verified": True,
            }
        )
        return 0


def launch_component_factory_f41_offer(
    api_key: str, offer: dict, *, attempt_label: str | None = None
) -> int:
    # Revalidate every paid resource field immediately before the create call.
    if not component_factory_f41_offer_eligible(offer):
        raise SafeError(
            "component-factory F41 offer is outside the fixed safety and price limits"
        )
    if COMPONENT_FACTORY_F41_IMAGE in COMPONENT_FACTORY_F41_REVOKED_IMAGES:
        raise SafeError(
            "component-factory F41 runtime image is revoked after a failed real "
            "Vast SSH command path; publish and qualify a corrected digest before "
            "any paid launch"
        )
    with simready_launch_lock():
        require_no_component_factory_f41_instance(api_key)
        ensure_local_ssh_registered(api_key)
        offer_id = positive_id(str(offer.get("id")), "offer id")
        if attempt_label is None:
            attempt_label = component_factory_f41_attempt_label()
        if not is_component_factory_f41_attempt_label(attempt_label):
            raise SafeError("component-factory F41 attempt label generation failed")
        # Emit the non-secret ownership handle before the paid request. A
        # supervisor can reconcile only this attempt if this child is killed
        # after Vast accepts the create call.
        print(
            f"OpenBao Vast.ai F41 paid launch attempt label: {attempt_label}",
            file=sys.stderr,
            flush=True,
        )
        try:
            result = vast_request(
                api_key,
                f"/api/v0/asks/{offer_id}/",
                method="PUT",
                payload={
                    "image": COMPONENT_FACTORY_F41_IMAGE,
                    "label": attempt_label,
                    "disk": COMPONENT_FACTORY_F41_DISK_GB,
                    "runtype": "ssh_direct",
                    "env": {},
                    "onstart": component_factory_f41_onstart_command(),
                    "cancel_unavail": True,
                },
            )
        except BaseException as launch_error:
            try:
                reconciled_id = reconcile_uncertain_component_factory_f41_launch(
                    api_key, attempt_label
                )
            except BaseException as cleanup_error:
                report_component_factory_f41_billing_risk(attempt_label)
                if isinstance(cleanup_error, Exception):
                    add_exception_note(
                        launch_error,
                        "F41 paid create outcome is uncertain and rollback was not verified"
                    )
                    raise launch_error from cleanup_error
                raise
            add_exception_note(
                launch_error,
                f"F41 instance {reconciled_id} was automatically destroyed and "
                "verified absent after the interrupted or uncertain create call"
            )
            emit_component_factory_f41_cleanup_attestation(
                reconciled_id, attempt_label
            )
            raise
        instance_id = result.get("new_contract")
        if not isinstance(instance_id, int) or isinstance(instance_id, bool):
            try:
                reconciled_id = reconcile_uncertain_component_factory_f41_launch(
                    api_key, attempt_label
                )
            except BaseException as cleanup_error:
                report_component_factory_f41_billing_risk(attempt_label)
                if isinstance(cleanup_error, Exception):
                    raise SafeError(
                        "Vast.ai did not return a new component-factory F41 instance "
                        "id; rollback was not verified and an instance may still be "
                        "running and billed"
                    ) from cleanup_error
                raise
            emit_component_factory_f41_cleanup_attestation(
                reconciled_id, attempt_label
            )
            raise SafeError(
                "Vast.ai did not return a new component-factory F41 instance id; "
                f"F41 instance {reconciled_id} was automatically destroyed and "
                "verified absent"
            )
        try:
            verify_single_component_factory_f41_instance(
                api_key, instance_id, attempt_label
            )
            verify_component_factory_f41_contract(api_key, instance_id, attempt_label)
            known_hosts_path = verify_component_factory_f41_ssh_ready(
                api_key, instance_id
            )
            print_json(
                {
                    "instance_id": instance_id,
                    "image": COMPONENT_FACTORY_F41_IMAGE,
                    "label": attempt_label,
                    "selected_offer": safe_offer(offer),
                    "offer_contract_verified": True,
                    "singleton_preflight_verified": True,
                    "singleton_verified": True,
                    "contract_verified": True,
                    "running_state_verified": True,
                    "ssh_batch_mode_verified": True,
                    "image_transport_smoke_verified": True,
                    "host_key_alias": component_factory_f41_host_key_alias(
                        instance_id
                    ),
                    "known_hosts_path": str(known_hosts_path),
                    "f41_component_factory_executed": False,
                    "physical_claims_validated": False,
                    "manufacturing_authorized": False,
                }
            )
        except BaseException as post_create_error:
            try:
                reconciled_id = reconcile_uncertain_component_factory_f41_launch(
                    api_key, attempt_label
                )
            except BaseException as cleanup_error:
                report_component_factory_f41_billing_risk(attempt_label)
                if isinstance(cleanup_error, Exception):
                    add_exception_note(
                        post_create_error,
                        "post-launch F41 failure occurred and rollback ownership or "
                        f"destruction was not verified for instance {instance_id}"
                    )
                    raise post_create_error from cleanup_error
                raise
            emit_component_factory_f41_cleanup_attestation(
                reconciled_id, attempt_label
            )
            try:
                remove_component_factory_f41_known_hosts_after_destroy(reconciled_id)
            except Exception as local_cleanup_error:
                add_exception_note(
                    post_create_error,
                    "F41 remote destruction was verified but its local scoped "
                    "known_hosts file could not be removed",
                )
                raise post_create_error from local_cleanup_error
            add_exception_note(
                post_create_error,
                f"F41 instance {reconciled_id} was automatically destroyed and "
                "verified absent after the post-create failure"
            )
            raise
        return 0


def launch_f46_offer(
    api_key: str,
    offer: dict,
    expected_image: str,
    deadline_epoch: int,
    *,
    attempt_label: str | None = None,
) -> int:
    """Create one F46 instance only after all immutable paid fields are bounded."""
    if F46_IMAGE_RE.fullmatch(expected_image) is None:
        raise SafeError("F46 image must use the fixed GHCR repository and digest")
    if not f46_offer_eligible(offer):
        raise SafeError("F46 offer is outside the fixed safety and price limits")
    now_epoch = int(time.time())
    if (
        not isinstance(deadline_epoch, int)
        or isinstance(deadline_epoch, bool)
        or deadline_epoch <= now_epoch
        or deadline_epoch > now_epoch + F46_MAX_DEADLINE_SECONDS
    ):
        raise SafeError("F46 remote deadline is invalid or outside eight hours")
    with simready_launch_lock():
        require_no_f46_instance(api_key)
        ensure_local_ssh_registered(api_key)
        offer_id = positive_id(str(offer.get("id")), "offer id")
        if attempt_label is None:
            attempt_label = f46_attempt_label()
        if not is_f46_attempt_label(attempt_label):
            raise SafeError("F46 attempt label is invalid")
        print(
            f"OpenBao Vast.ai F46 paid launch attempt label: {attempt_label}",
            file=sys.stderr,
            flush=True,
        )
        try:
            result = vast_request(
                api_key,
                f"/api/v0/asks/{offer_id}/",
                method="PUT",
                payload={
                    "image": expected_image,
                    "label": attempt_label,
                    "disk": F46_MIN_DISK_GB,
                    "runtype": "ssh_direct",
                    "env": {},
                    "onstart": (
                        "f46-vast-onstart --deadline-epoch "
                        f"{deadline_epoch}"
                    ),
                    "cancel_unavail": True,
                },
            )
        except BaseException as launch_error:
            try:
                reconciled_id = reconcile_uncertain_f46_launch(
                    api_key, attempt_label, expected_image
                )
            except BaseException as cleanup_error:
                report_f46_billing_risk(attempt_label)
                if isinstance(cleanup_error, Exception):
                    add_exception_note(
                        launch_error,
                        "F46 paid create outcome is uncertain and rollback was not verified",
                    )
                    raise launch_error from cleanup_error
                raise
            add_exception_note(
                launch_error,
                f"F46 instance {reconciled_id} was destroyed and verified absent",
            )
            emit_f46_cleanup_attestation(
                reconciled_id, attempt_label, expected_image
            )
            raise
        instance_id = result.get("new_contract")
        if (
            not isinstance(instance_id, int)
            or isinstance(instance_id, bool)
            or instance_id <= 0
        ):
            try:
                reconciled_id = reconcile_uncertain_f46_launch(
                    api_key, attempt_label, expected_image
                )
            except BaseException as cleanup_error:
                report_f46_billing_risk(attempt_label)
                if isinstance(cleanup_error, Exception):
                    raise SafeError(
                        "Vast.ai did not return a valid F46 instance id; rollback "
                        "was not verified"
                    ) from cleanup_error
                raise
            emit_f46_cleanup_attestation(
                reconciled_id, attempt_label, expected_image
            )
            raise SafeError(
                "Vast.ai did not return a valid F46 instance id; instance "
                f"{reconciled_id} was destroyed and verified absent"
            )
        try:
            verify_single_f46_instance(api_key, instance_id, attempt_label)
            verify_f46_contract(
                api_key,
                instance_id,
                attempt_label,
                expected_image,
                offer,
            )
        except BaseException as post_create_error:
            try:
                reconciled_id = reconcile_uncertain_f46_launch(
                    api_key, attempt_label, expected_image
                )
            except BaseException as cleanup_error:
                report_f46_billing_risk(attempt_label)
                if isinstance(cleanup_error, Exception):
                    add_exception_note(
                        post_create_error,
                        "post-launch F46 failure occurred and rollback was not verified",
                    )
                    raise post_create_error from cleanup_error
                raise
            emit_f46_cleanup_attestation(
                reconciled_id, attempt_label, expected_image
            )
            add_exception_note(
                post_create_error,
                f"F46 instance {reconciled_id} was destroyed and verified absent",
            )
            raise
        print_json(
            {
                "instance_id": instance_id,
                "image": expected_image,
                "label": attempt_label,
                "selected_offer": safe_offer(offer),
                "offer_contract_verified": True,
                "singleton_preflight_verified": True,
                "singleton_verified": True,
                "contract_verified": True,
                "running_state_verified": True,
                "remote_deadline_epoch": deadline_epoch,
                "remote_watchdog_armed": True,
                "simulation_validated": False,
                "manufacturing_authorized": False,
            }
        )
        return 0


def launch_simready_offer(
    api_key: str,
    offer: dict,
    disk_gb: int = 300,
    *,
    enforce_singleton: bool = False,
    attempt_label: str | None = None,
    validation_only: bool = False,
) -> int:
    if SIMREADY_IMAGE in SIMREADY_REVOKED_IMAGES:
        raise SafeError(
            "the pinned SimReady image is revoked; publish and pin the corrected image first"
        )
    if (
        not enforce_singleton
        or disk_gb != HEAVY_MIN_DISK_GB
        or not heavy_offer_eligible(offer)
    ):
        raise SafeError(
            "SimReady launch requires the supervised heavy offer contract"
        )
    with simready_launch_lock():
        require_no_simready_instance(api_key)
        ensure_local_ssh_registered(api_key)
        if attempt_label is None:
            attempt_label = simready_attempt_label()
        if not is_simready_attempt_label(attempt_label):
            raise SafeError("SimReady attempt label is invalid")
        print(
            f"OpenBao Vast.ai SimReady paid launch attempt label: {attempt_label}",
            file=sys.stderr,
            flush=True,
        )
        offer_id = positive_id(str(offer.get("id")), "offer id")
        try:
            result = vast_request(
                api_key,
                f"/api/v0/asks/{offer_id}/",
                method="PUT",
                payload={
                    "image": SIMREADY_IMAGE,
                    "label": attempt_label,
                    "disk": disk_gb,
                    "runtype": "ssh_direct",
                    "env": {},
                    "onstart": (
                        simready_validation_only_onstart_command()
                        if validation_only
                        else "simready-vast-onstart"
                    ),
                    "cancel_unavail": True,
                },
            )
        except BaseException as launch_error:
            try:
                reconciled_id = reconcile_uncertain_simready_launch(
                    api_key, attempt_label
                )
            except BaseException as cleanup_error:
                report_simready_billing_risk(attempt_label)
                if isinstance(cleanup_error, Exception):
                    add_exception_note(
                        launch_error,
                        "interrupted or uncertain SimReady create was not reconciled; "
                        f"inspect the unique attempt label {attempt_label} before retrying",
                    )
                    raise launch_error from cleanup_error
                raise
            add_exception_note(
                launch_error,
                f"SimReady instance {reconciled_id} was automatically destroyed "
                "and verified stably absent after the interrupted create call",
            )
            emit_simready_cleanup_attestation(reconciled_id, attempt_label)
            raise
        instance_id = result.get("new_contract")
        if (
            not isinstance(instance_id, int)
            or isinstance(instance_id, bool)
            or instance_id <= 0
        ):
            try:
                reconciled_id = reconcile_uncertain_simready_launch(
                    api_key, attempt_label
                )
            except BaseException as cleanup_error:
                report_simready_billing_risk(attempt_label)
                if isinstance(cleanup_error, Exception):
                    raise SafeError(
                        "Vast.ai did not return a valid SimReady instance id; "
                        "rollback was not verified and the unique attempt label "
                        f"{attempt_label} must be inspected before retrying"
                    ) from cleanup_error
                raise
            emit_simready_cleanup_attestation(reconciled_id, attempt_label)
            raise SafeError(
                "Vast.ai did not return a valid SimReady instance id; instance "
                f"{reconciled_id} was automatically destroyed and verified stably absent"
            )
        try:
            verify_single_simready_instance(api_key, instance_id, attempt_label)
            verify_simready_contract(api_key, instance_id, attempt_label)
            if validation_only:
                known_hosts_path = verify_simready_ssh_ready(
                    api_key, instance_id, validation_only=True
                )
            else:
                known_hosts_path = verify_simready_ssh_ready(api_key, instance_id)
            print_json(
                {
                    "instance_id": instance_id,
                    "image": SIMREADY_IMAGE,
                    "label": attempt_label,
                    "selected_offer": safe_offer(offer),
                    "offer_contract_verified": True,
                    "singleton_preflight_verified": True,
                    "singleton_verified": True,
                    "contract_verified": True,
                    "running_state_verified": True,
                    "ssh_batch_mode_verified": True,
                    "runtime_ready_verified": True,
                    "validation_only": validation_only,
                    "property_assignment_intent": (
                        "skip" if validation_only else "run"
                    ),
                    "content_agents_started": not validation_only,
                    "physicsnemo_gpu_runtime_verified": True,
                    "host_key_alias": simready_host_key_alias(instance_id),
                    "known_hosts_path": str(known_hosts_path),
                    "simulation_validated": False,
                    "manufacturing_authorized": False,
                    "target_1600_ch_validated": False,
                }
            )
        except BaseException as post_create_error:
            try:
                reconciled_id = reconcile_uncertain_simready_launch(
                    api_key, attempt_label
                )
            except BaseException as cleanup_error:
                report_simready_billing_risk(attempt_label)
                if isinstance(cleanup_error, Exception):
                    add_exception_note(
                        post_create_error,
                        "post-launch SimReady verification failed and rollback of "
                        f"attempt {attempt_label} was not verified",
                    )
                    raise post_create_error from cleanup_error
                raise
            try:
                remove_simready_known_hosts_after_destroy(reconciled_id)
            except Exception as local_cleanup_error:
                add_exception_note(
                    post_create_error,
                    "SimReady remote destruction was verified but its local scoped "
                    "known_hosts file could not be removed",
                )
                raise post_create_error from local_cleanup_error
            add_exception_note(
                post_create_error,
                f"SimReady instance {reconciled_id} was automatically destroyed and "
                "verified stably absent after the post-create failure",
            )
            emit_simready_cleanup_attestation(reconciled_id, attempt_label)
            raise
        return 0


def run(operation: list[str]) -> int:
    token = login()
    try:
        api_key = read_vast_key(token)
        if operation == ["--auth-check"]:
            list_instances(api_key)
            print("OpenBao Vast.ai reader auth check OK")
            return 0
        if operation == ["offers"]:
            print_json([safe_offer(item) for item in get_offers(api_key)[:20]])
            return 0
        if operation == ["heavy-offers"]:
            print_json([safe_offer(item) for item in get_heavy_offers(api_key)[:20]])
            return 0
        if operation == ["f46-offers"]:
            print_json([safe_offer(item) for item in get_f46_offers(api_key)[:20]])
            return 0
        if operation == ["wave-offers"]:
            print_json([safe_offer(item) for item in get_wave_offers(api_key)[:20]])
            return 0
        if operation == ["component-factory-f41-offers"]:
            print_json(
                [
                    safe_offer(item)
                    for item in get_component_factory_f41_offers(api_key)[:20]
                ]
            )
            return 0
        if operation == ["mesh-offers"]:
            print_json([safe_offer(item) for item in get_mesh_offers(api_key)[:20]])
            return 0
        if operation == ["instances"]:
            items = list_instances(api_key)
            print_json([safe_instance(item) for item in items if isinstance(item, dict)])
            return 0
        if len(operation) == 2 and operation[0] == "show":
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
            instance = result.get("instances")
            if not isinstance(instance, dict):
                raise SafeError("Vast.ai instance lookup returned an invalid result")
            print_json(safe_instance(instance))
            return 0
        if len(operation) == 2 and operation[0] == "ssh-keys":
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/ssh")
            raw_keys = result.get("ssh_keys", "[]")
            try:
                keys = json.loads(raw_keys) if isinstance(raw_keys, str) else raw_keys
            except json.JSONDecodeError as exc:
                raise SafeError("Vast.ai returned invalid SSH key metadata") from exc
            if not isinstance(keys, list):
                raise SafeError("Vast.ai returned invalid SSH key metadata")
            safe_keys = []
            for item in keys:
                if not isinstance(item, dict):
                    continue
                public_key = item.get("public_key", "")
                key_type = public_key.split(" ", 1)[0] if isinstance(public_key, str) else None
                safe_keys.append({"id": item.get("id"), "name": item.get("name"), "type": key_type})
            print_json(safe_keys)
            return 0
        if len(operation) == 2 and operation[0] == "attach-local-ssh":
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(
                api_key,
                f"/api/v0/instances/{instance_id}/ssh/",
                method="POST",
                payload={"ssh_key": read_local_ssh_public_key()},
            )
            print_json({"instance_id": instance_id, "attached": bool(result.get("success", True))})
            return 0
        if operation == ["ensure-local-ssh"]:
            ensure_local_ssh_registered(api_key)
            print_json(
                {
                    "registered": True,
                    "approved_private_key_file_verified": True,
                    "ssh_agent_required": False,
                }
            )
            return 0
        if len(operation) == 2 and operation[0] == "probe":
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(
                api_key,
                f"/api/v0/instances/command/{instance_id}",
                method="PUT",
                payload={"command": "ls -l"},
            )
            result_url = result.get("result_url")
            if not isinstance(result_url, str):
                raise SafeError("Vast.ai did not return an execution result URL")
            print(fetch_execution_result(result_url), end="")
            return 0
        if len(operation) == 2 and operation[0] in {"logs", "daemon-logs"}:
            instance_id = positive_id(operation[1], "instance id")
            result = vast_request(
                api_key,
                f"/api/v0/instances/request_logs/{instance_id}",
                method="PUT",
                payload={
                    "tail": "200",
                    "daemon_logs": "true" if operation[0] == "daemon-logs" else "false",
                },
            )
            result_url = result.get("result_url")
            if not isinstance(result_url, str):
                raise SafeError("Vast.ai did not return a log result URL")
            print(fetch_execution_result(result_url), end="")
            return 0
        if len(operation) == 2 and operation[0] == "launch":
            offer_id = positive_id(operation[1], "offer id")
            matching = [
                item
                for item in get_offers(api_key, offer_id)
                if str(item.get("id")) == str(offer_id)
            ]
            if len(matching) != 1:
                raise SafeError("offer is unavailable or outside the fixed safety and price limits")
            return launch_offer(api_key, matching[0])
        if len(operation) == 2 and operation[0] == "launch-mesh":
            offer_id = positive_id(operation[1], "offer id")
            matching = [
                item
                for item in get_mesh_offers(api_key, offer_id)
                if str(item.get("id")) == str(offer_id)
            ]
            if len(matching) != 1:
                raise SafeError("mesh offer is unavailable or outside the fixed safety and price limits")
            return launch_mesh_offer(api_key, matching[0])
        if len(operation) == 2 and operation[0] == "launch-wave-f39":
            offer_id = positive_id(operation[1], "offer id")
            matching = [
                item
                for item in get_wave_offers(api_key, offer_id)
                if item.get("id") == offer_id
            ]
            if len(matching) != 1:
                raise SafeError(
                    "wave-action offer is unavailable or outside the fixed safety and price limits"
                )
            return launch_wave_f39_offer(api_key, matching[0])
        if (
            len(operation) in {2, 4}
            and operation[0] == "launch-component-factory-f41"
        ):
            offer_id = positive_id(operation[1], "offer id")
            supervised_attempt_label = None
            if len(operation) == 4:
                if operation[2] != "--attempt-label" or not is_component_factory_f41_attempt_label(
                    operation[3]
                ):
                    raise SafeError("supervised F41 attempt label is invalid")
                supervised_attempt_label = operation[3]
            matching = [
                item
                for item in get_component_factory_f41_offers(api_key, offer_id)
                if item.get("id") == offer_id
            ]
            if len(matching) != 1:
                raise SafeError(
                    "component-factory F41 offer is unavailable or outside the "
                    "fixed safety and price limits"
                )
            return launch_component_factory_f41_offer(
                api_key,
                matching[0],
                attempt_label=supervised_attempt_label,
            )
        if len(operation) in {4, 6} and operation[0] == "launch-f46":
            offer_id = positive_id(operation[1], "offer id")
            expected_image = operation[2]
            deadline_epoch = positive_id(operation[3], "F46 deadline epoch")
            supervised_attempt_label = None
            if len(operation) == 6:
                if operation[4] != "--attempt-label" or not is_f46_attempt_label(
                    operation[5]
                ):
                    raise SafeError("supervised F46 attempt label is invalid")
                supervised_attempt_label = operation[5]
            matching = [
                item
                for item in get_f46_offers(api_key, offer_id)
                if item.get("id") == offer_id
            ]
            if len(matching) != 1:
                raise SafeError(
                    "F46 offer is unavailable or outside fixed safety and price limits"
                )
            return launch_f46_offer(
                api_key,
                matching[0],
                expected_image,
                deadline_epoch,
                attempt_label=supervised_attempt_label,
            )
        if (
            len(operation) in {2, 4}
            and operation[0] in {
                "launch-simready-heavy",
                "launch-simready-validation-only",
            }
        ):
            offer_id = positive_id(operation[1], "offer id")
            supervised_attempt_label = None
            if len(operation) == 4:
                if operation[2] != "--attempt-label" or not is_simready_attempt_label(
                    operation[3]
                ):
                    raise SafeError("supervised SimReady attempt label is invalid")
                supervised_attempt_label = operation[3]
            matching = [
                item
                for item in get_heavy_offers(api_key)
                if str(item.get("id")) == str(offer_id)
            ]
            if len(matching) != 1:
                raise SafeError("heavy SimReady offer is unavailable or outside the fixed safety and price limits")
            return launch_simready_offer(
                api_key,
                matching[0],
                disk_gb=500,
                enforce_singleton=True,
                attempt_label=supervised_attempt_label,
                validation_only=operation[0] == "launch-simready-validation-only",
            )
        if len(operation) == 2 and operation[0] == "reconcile-simready-attempt":
            attempt_label = operation[1]
            if not is_simready_attempt_label(attempt_label):
                raise SafeError("SimReady attempt label is invalid")
            instance_id = reconcile_uncertain_simready_launch(
                api_key, attempt_label
            )
            emit_simready_cleanup_attestation(instance_id, attempt_label)
            return 0
        if len(operation) == 3 and operation[0] == "reconcile-f46-attempt":
            attempt_label = operation[1]
            expected_image = operation[2]
            instance_id = reconcile_uncertain_f46_launch(
                api_key, attempt_label, expected_image
            )
            emit_f46_cleanup_attestation(instance_id, attempt_label, expected_image)
            return 0
        if operation == ["launch-best-eu"]:
            eu_countries = {
                "AT", "BE", "BG", "HR", "CY", "CZ", "DE", "DK", "EE", "ES",
                "FI", "FR", "GR", "HU", "IE", "IS", "IT", "LT", "LU", "LV",
                "MT", "NL", "NO", "PL", "PT", "RO", "SE", "SI", "SK", "CH",
            }
            gpu_order = {"RTX 6000Ada": 0, "RTX 5880Ada": 1, "RTX PRO 5000": 2}
            candidates = [
                item
                for item in get_offers(api_key)
                if str(item.get("geolocation", "")).rsplit(", ", 1)[-1] in eu_countries
                and item.get("gpu_name") in gpu_order
                and float(item.get("reliability", 0)) >= 0.995
            ]
            candidates.sort(
                key=lambda item: (
                    gpu_order[str(item.get("gpu_name"))],
                    float(item.get("dph_total", item.get("dph", 999))),
                )
            )
            if not candidates:
                raise SafeError("no eligible European 48 GB offer is currently available")
            return launch_offer(api_key, candidates[0])
        if len(operation) == 2 and operation[0] in {"start", "stop"}:
            instance_id = positive_id(operation[1], "instance id")
            state = "running" if operation[0] == "start" else "stopped"
            set_instance_state_verified(api_key, instance_id, state)
            print_json(
                {
                    "instance_id": instance_id,
                    "requested_state": state,
                    "success": True,
                    "final_state_verified": True,
                }
            )
            return 0
        if len(operation) == 3 and operation[0] == "destroy" and operation[2] == "--confirm":
            instance_id = positive_id(operation[1], "instance id")
            destroy_instance_verified(api_key, instance_id)
            print_json({"instance_id": instance_id, "destroyed": True, "verified_absent": True})
            return 0
        raise SafeError(
            "usage: openbao-vastai --check|--auth-check|offers|heavy-offers|f46-offers|wave-offers|"
            "component-factory-f41-offers|mesh-offers|instances|"
            "show <id>|ssh-keys <id>|attach-local-ssh <id>|ensure-local-ssh|probe <id>|logs <id>|daemon-logs <id>|"
            "launch <offer_id>|launch-mesh <offer_id>|launch-wave-f39 <offer_id>|"
            "launch-component-factory-f41 <offer_id> [--attempt-label <label>]|"
            "launch-f46 <offer_id> <image@digest> <deadline_epoch> [--attempt-label <label>]|"
            "launch-simready-heavy <offer_id> [--attempt-label <label>]|"
            "launch-simready-validation-only <offer_id> [--attempt-label <label>]|"
            "reconcile-simready-attempt <label>|"
            "reconcile-f46-attempt <label> <image@digest>|launch-best-eu|"
            "start <id>|stop <id>|"
            "destroy <id> --confirm"
        )
    finally:
        revoke_token(token)


def main() -> int:
    if sys.argv[1:] == ["--check"]:
        validate_bootstrap_metadata()
        check_local_service()
        print("OpenBao Vast.ai reader check OK")
        return 0
    return run(sys.argv[1:])


def cli() -> int:
    """Render safe operator-facing errors and return a process exit status."""
    try:
        return main()
    except KeyboardInterrupt:
        print("OpenBao Vast.ai: cancelled", file=sys.stderr)
        return 130
    except SafeError as exc:
        print(f"OpenBao Vast.ai error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(cli())
