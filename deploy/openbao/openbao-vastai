        "geolocation": offer.get("geolocation"),
        "inet_down_mbps": offer.get("inet_down"),
        "inet_up_mbps": offer.get("inet_up"),
        "inet_down_cost_usd_per_gb": offer.get("inet_down_cost"),
        "inet_up_cost_usd_per_gb": offer.get("inet_up_cost"),
    }


def normalized_ssh_port(value: object) -> int | None:
    """Accept provider numeric ports or strict decimal HostPort strings only."""
    if isinstance(value, str) and re.fullmatch(r"[0-9]{1,5}", value):
        value = int(value)
    number = finite_number(value)
    if number is None or not number.is_integer() or not 1 <= number <= 65535:
        return None
    return int(number)


def safe_instance(instance: dict) -> dict:
    ports = instance.get("ports")
    ssh_port = None
    api_port = None
    if isinstance(ports, dict):
        mappings = ports.get("22/tcp")
        if isinstance(mappings, list) and mappings and isinstance(mappings[0], dict):
            ssh_port = normalized_ssh_port(mappings[0].get("HostPort"))
        api_mappings = ports.get("8000/tcp")
        if (
            isinstance(api_mappings, list)
            and api_mappings
            and isinstance(api_mappings[0], dict)
        ):
            api_port = api_mappings[0].get("HostPort")
    # Proxy host/port and direct public-IP/mapped-port are separate endpoint
    # pairs. Never combine a proxy host with a container's mapped host port.
    proxy_host = instance.get("ssh_host")
    proxy_port = instance.get("ssh_port")
    if proxy_host and proxy_port is not None:
        selected_ssh_host, selected_ssh_port = proxy_host, proxy_port
    elif instance.get("public_ipaddr") and ssh_port is not None:
        selected_ssh_host = instance["public_ipaddr"]
        selected_ssh_port = ssh_port
    else:
        selected_ssh_host, selected_ssh_port = None, None
    return {
        "id": instance.get("id"),
        "label": instance.get("label"),
        "status": instance.get("actual_status", instance.get("cur_state")),
        "gpu": instance.get("gpu_name"),
        "gpu_ram_mb": instance.get(
            "gpu_ram", instance.get("gpu_totalram", instance.get("gpu_total_ram"))
        ),
        "num_gpus": instance.get("num_gpus"),
        "gpu_fraction": instance.get("gpu_frac"),
        "machine_verification": instance.get("verification"),
        "cpu_cores_effective": instance.get("cpu_cores_effective"),
        "cpu_ram_mb": instance.get("cpu_ram"),
        "disk_space_gb": instance.get("disk_space"),
        "dph_total": instance.get("dph_total"),
        "inet_up_cost_usd_per_gb": instance.get("inet_up_cost"),
        "inet_down_cost_usd_per_gb": instance.get("inet_down_cost"),
        "ssh_host": selected_ssh_host,
        "ssh_port": selected_ssh_port,
        "api_host": instance.get("public_ipaddr"),
        "api_port": api_port,
        "status_msg": instance.get("status_msg"),
        "image": instance.get("image_uuid"),
    }


def safe_ssh_endpoints(instance: dict, instance_id: int) -> dict:
    """Expose the two provider endpoint pairs without selecting or connecting."""
    if instance.get("id") != instance_id or isinstance(instance.get("id"), bool):
        raise SafeError("Vast.ai SSH endpoint metadata does not match the requested instance")

    def endpoint(host: object, port: object, source: str, *, ip_only: bool = False):
        number = normalized_ssh_port(port)
        if (
            not isinstance(host, str)
            or not re.fullmatch(r"[A-Za-z0-9.:-]{1,253}", host)
            or number is None
        ):
            return None
        if ip_only:
            try:
                ipaddress.ip_address(host)
            except ValueError:
                return None
        return {"host": host, "port": number, "source": source}

    proxy = endpoint(instance.get("ssh_host"), instance.get("ssh_port"), "ssh_host+ssh_port")
    ports = instance.get("ports")
    mappings = ports.get("22/tcp") if isinstance(ports, dict) else None
    mapped_port = (
        mappings[0].get("HostPort")
        if isinstance(mappings, list) and mappings and isinstance(mappings[0], dict)
        else None
    )
    direct = endpoint(
        instance.get("public_ipaddr"), mapped_port,
        "public_ipaddr+ports[22/tcp][0].HostPort", ip_only=True,
    )
    return {
        "instance_id": instance_id,
        "proxy": proxy,
        "direct": direct,
        "evidence_scope": "provider_metadata_only",
        "ssh_connection_tested": False,
        "endpoint_selection_changed": False,
    }


def m64_ssh_endpoint(instance: dict, instance_id: int) -> dict | None:
    """M64 uses the provider's direct pair; legacy safe_instance stays unchanged.

    Unallocated direct mappings wait without using the proxy. Multiple Docker
    bindings must resolve to one port for the public address's IP family.
    """
    ports = instance.get("ports")
    mappings = ports.get("22/tcp") if isinstance(ports, dict) else None
    diagnostic = {
        "schema_version": "1.0.0", "instance_id": instance_id,
        "ports_type": type(ports).__name__, "mappings_type": type(mappings).__name__,
        "mapping_count": len(mappings) if isinstance(mappings, list) else None,
        "mapping_summaries": [], "public_ip_family": None,
        "public_ip_global_verified": False, "candidate_ports": [],
        "ssh_connection_tested": False,
    }

    def report(reason: str) -> None:
        print("OPENBAO_VASTAI_M64_ENDPOINT_DIAGNOSTIC " + json.dumps(
            {**diagnostic, "reason": reason}, sort_keys=True), file=sys.stderr, flush=True)

    def reject(reason: str, message: str) -> None:
        report(reason)
        raise SafeError(message)

    if type(instance.get("id")) is not int or instance["id"] != instance_id:
        reject("instance_id_mismatch", "M64 SSH endpoint instance id does not match")
    if ports is not None and not isinstance(ports, dict):
        reject("ports_type_invalid", "M64 SSH port mappings are malformed")
    if isinstance(ports, dict) and "22/tcp" in ports:
        if mappings is None or mappings == []:
            report("direct_mapping_not_allocated")
            return None
        if not isinstance(mappings, list) or len(mappings) > 64:
            reject("mapping_list_invalid", "M64 published direct SSH endpoint is malformed")
        bindings = {}
        malformed = False
        for index, item in enumerate(mappings):
            port = normalized_ssh_port(item.get("HostPort")) if isinstance(item, dict) else None
            summary = {"index": index, "entry_type": type(item).__name__, "port": port,
                       "source": f"ports[22/tcp][{index}].HostPort", "host_ip_family": None,
                       "host_ip_state": "absent"}
            binding = None
            if isinstance(item, dict) and "HostIp" in item:
                value = item["HostIp"]
                try:
                    if not isinstance(value, str) or not re.fullmatch(r"[A-Fa-f0-9.:]{1,45}", value):
                        raise ValueError("invalid bind address")
                    binding = ipaddress.ip_address(value)
                    summary.update(host_ip_family=binding.version, host_ip_state="parsed")
                except ValueError:
                    summary["host_ip_state"] = "invalid"
                    malformed = True
            diagnostic["mapping_summaries"].append(summary)
            if port is None:
                malformed = True
            key = (str(binding) if binding is not None else None, port)
            bindings.setdefault(key, []).append(index)
        if malformed:
            reject("mapping_entry_invalid", "M64 published direct SSH endpoint is malformed")
        value = instance.get("public_ipaddr")
        try:
            if not isinstance(value, str) or not re.fullmatch(r"[A-Fa-f0-9.:]{1,45}", value):
                raise ValueError("invalid public address")
            address = ipaddress.ip_address(value)
        except ValueError:
            reject("public_ip_invalid", "M64 published direct SSH endpoint is malformed")
        diagnostic["public_ip_family"] = address.version
        if (
            not address.is_global or address.is_multicast or address.is_loopback
            or address.is_private or address.is_link_local or address.is_unspecified
            or address.is_reserved
        ):
            reject("public_ip_not_global_unicast", "M64 direct SSH endpoint must be a global unicast IP address")
        diagnostic["public_ip_global_verified"] = True
        if any(host is None for host, port in bindings) and len(bindings) != 1:
            reject("missing_bind_ip_ambiguous", "M64 direct SSH bindings without HostIp are ambiguous")
        matches = {(host, port): indices for (host, port), indices in bindings.items()
                   if host is None or ipaddress.ip_address(host).version == address.version}
        candidates = {port for host, port in matches}
        diagnostic["candidate_ports"] = sorted(candidates)
        if len(candidates) != 1:
            reject("no_unique_family_port", "M64 direct SSH bindings have no unique port for the public IP family")
        indices = sorted(index for group in matches.values() for index in group)
        # Every candidate has the same port; provenance names all matching
        # indices instead of choosing an arbitrary first mapping.
        source = "public_ipaddr+" + "+".join(f"ports[22/tcp][{i}].HostPort" for i in indices)
        return {"kind": "direct", "host": str(address), "port": next(iter(candidates)), "source": source}
    endpoints = safe_ssh_endpoints(instance, instance_id)
    host, port = instance.get("ssh_host"), instance.get("ssh_port")
    if host is None and port is None:
        return None
    if (
        endpoints["proxy"] is None or not isinstance(host, str)
        or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.:-]{0,252}", host)
    ):
        reject("proxy_endpoint_invalid", "M64 published proxy SSH endpoint is malformed")
    return {"kind": "proxy", **endpoints["proxy"]}


