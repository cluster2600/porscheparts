def terminate_component_factory_f41_probe(
    process: subprocess.Popen[bytes],
) -> bool:
    """Terminate and prove absence of the isolated SSH process group."""
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError:
        try:
            process.terminate()
        except OSError:
            pass
    try:
        process.wait(timeout=COMPONENT_FACTORY_F41_SSH_PROBE_TERMINATE_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        pass
    except OSError:
        pass
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except OSError:
        if process.poll() is None:
            try:
                process.kill()
            except OSError:
                pass
    try:
        process.wait(timeout=COMPONENT_FACTORY_F41_SSH_PROBE_TERMINATE_GRACE_SECONDS)
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        parent_reaped = process.poll() is not None
    except OSError:
        parent_reaped = False
    try:
        os.killpg(process.pid, 0)
    except ProcessLookupError:
        group_gone = True
    except OSError:
        group_gone = False
    else:
        group_gone = False
    return parent_reaped and group_gone


def run_component_factory_f41_ssh_probe(
    command: list[str], environment: dict[str, str]
) -> subprocess.CompletedProcess[str]:
    """Run SSH with an absolute deadline and bounded progressive pipe drains."""
    selector: selectors.BaseSelector | None = None
    stdout = None
    stderr = None
    try:
        process = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            start_new_session=True,
        )
    except FileNotFoundError:
        raise
    except OSError as exc:
        raise ComponentFactoryF41ProbeSpawnError() from exc
    try:
        stdout = process.stdout
        stderr = process.stderr
        if stdout is None or stderr is None:
            raise ComponentFactoryF41ProbeLocalIoError()
        streams = {stdout: "stdout", stderr: "stderr"}
        buffers = {"stdout": bytearray(), "stderr": bytearray()}
        selector = selectors.DefaultSelector()
        deadline = (
            time.monotonic() + COMPONENT_FACTORY_F41_SSH_PROBE_TIMEOUT_SECONDS
        )
        for stream, name in streams.items():
            os.set_blocking(stream.fileno(), False)
            selector.register(stream, selectors.EVENT_READ, name)
        while selector.get_map():
            remaining_seconds = deadline - time.monotonic()
            if remaining_seconds <= 0:
                raise ComponentFactoryF41ProbeTimeout()
            events = selector.select(min(remaining_seconds, 0.25))
            for key, _ in events:
                stream = key.fileobj
                name = key.data
                remaining_bytes = (
                    COMPONENT_FACTORY_F41_SSH_PROBE_MAX_BYTES_PER_STREAM
                    + 1
                    - len(buffers[name])
                )
                if remaining_bytes <= 0:
                    raise ComponentFactoryF41ProbeOutputLimit()
                try:
                    chunk = os.read(stream.fileno(), min(16 * 1024, remaining_bytes))
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(stream)
                    continue
                if (
                    len(buffers[name]) + len(chunk)
                    > COMPONENT_FACTORY_F41_SSH_PROBE_MAX_BYTES_PER_STREAM
                ):
                    raise ComponentFactoryF41ProbeOutputLimit()
                buffers[name].extend(chunk)
        remaining_seconds = deadline - time.monotonic()
        if remaining_seconds <= 0:
            raise ComponentFactoryF41ProbeTimeout()
        try:
            returncode = process.wait(timeout=remaining_seconds)
        except subprocess.TimeoutExpired:
            raise ComponentFactoryF41ProbeTimeout()
    except OSError as exc:
        if not terminate_component_factory_f41_probe(process):
            raise ComponentFactoryF41ProbeCleanupError() from exc
        raise ComponentFactoryF41ProbeLocalIoError() from exc
    except BaseException as exc:
        if not terminate_component_factory_f41_probe(process) and isinstance(
            exc, Exception
        ):
            raise ComponentFactoryF41ProbeCleanupError() from exc
        raise
    finally:
        if selector is not None:
            try:
                selector.close()
            except Exception:
                pass
        if stdout is not None:
            try:
                stdout.close()
            except Exception:
                pass
        if stderr is not None:
            try:
                stderr.close()
            except Exception:
                pass
    return subprocess.CompletedProcess(
        args=command,
        returncode=returncode,
        stdout=bytes(buffers["stdout"]).decode("utf-8", errors="replace"),
        stderr=bytes(buffers["stderr"]).decode("utf-8", errors="replace"),
    )


def classify_component_factory_f41_ssh_probe(
    completed: subprocess.CompletedProcess[str],
) -> str:
    """Map SSH failures to fixed non-secret diagnostic categories."""
    stderr = completed.stderr if isinstance(completed.stderr, str) else ""
    if completed.returncode == 41:
        return "ready_marker_missing"
    if completed.returncode == 42:
        return "image_smoke_report_missing"
    if completed.returncode == 43:
        return "remote_ready_contract_rejected"
    if completed.returncode == 44:
        return "onstart_status_missing"
    if completed.returncode == 45:
        return "onstart_running"
    if completed.returncode == 46:
        return "onstart_failed"
    if completed.returncode != 255:
        return "remote_command_rejected"
    lowered = stderr.lower()
    if "permission denied" in lowered or "publickey" in lowered:
        return "ssh_authentication_failed"
    if "connection refused" in lowered:
        return "ssh_connection_refused"
    if "connection timed out" in lowered or "operation timed out" in lowered:
        return "ssh_connection_timeout"
    if (
        "host key verification failed" in lowered
        or "remote host identification has changed" in lowered
    ):
        return "ssh_host_key_rejected"
    if "connection closed" in lowered or "closed by" in lowered:
        return "ssh_connection_closed"
    if any(
        marker in lowered
        for marker in (
            "no route to host",
            "network is unreachable",
            "could not resolve hostname",
        )
    ):
        return "ssh_network_unreachable"
    return "ssh_transport_failed"


def classify_simready_ssh_probe(
    completed: subprocess.CompletedProcess[str],
) -> str:
    if completed.returncode == 41:
        return "ready_marker_missing"
    if completed.returncode == 42:
        return "physicsnemo_gpu_report_missing"
    if completed.returncode == 43:
        return "remote_ready_contract_rejected"
    return classify_component_factory_f41_ssh_probe(completed)


def verify_component_factory_f41_ssh_ready(api_key: str, instance_id: int) -> Path:
    """Prove BatchMode SSH and the exact F41 image READY contract."""
    validate_approved_ssh_private_key()
    known_hosts_path = prepare_component_factory_f41_known_hosts(instance_id)
    host_key_alias = component_factory_f41_host_key_alias(instance_id)
    last_state = "unknown"
    last_probe = "provider_metadata_not_ready"
    for _ in range(COMPONENT_FACTORY_F41_SSH_READY_ATTEMPTS):
        try:
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
        except SafeError:
            last_probe = "provider_metadata_unavailable"
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        raw_instance = result.get("instances")
        if not isinstance(raw_instance, dict):
            raise SafeError("Vast.ai returned invalid F41 SSH endpoint metadata")
        instance = safe_instance(raw_instance)
        last_state = str(instance.get("status") or "unknown")
        if last_state != "running":
            if last_state not in {"created", "loading"}:
                raise SafeError(
                    "F41 instance left running state before SSH READY verification: "
                    f"{last_state}"
                )
            last_probe = "instance_not_running_yet"
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        host = instance.get("ssh_host")
        port = finite_number(instance.get("ssh_port"))
        if (
            not isinstance(host, str)
            or not host
            or len(host) > 253
            or any(
                character
                not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.:-"
                for character in host
            )
            or port is None
            or not port.is_integer()
            or not 1 <= port <= 65535
        ):
            last_probe = "ssh_endpoint_unavailable"
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        command = [
            "ssh",
            "-F",
            "/dev/null",
            "-T",
            "-i",
            str(SSH_PRIVATE_KEY_FILE),
            "-o",
            "BatchMode=yes",
            "-o",
            "IdentitiesOnly=yes",
            "-o",
            "ForwardAgent=no",
            "-o",
            "ClearAllForwardings=yes",
            "-o",
            "PermitLocalCommand=no",
            "-o",
            "PasswordAuthentication=no",
            "-o",
            "KbdInteractiveAuthentication=no",
            "-o",
            "ConnectionAttempts=1",
            "-o",
            "ConnectTimeout=5",
            "-o",
            "StrictHostKeyChecking=accept-new",
            "-o",
            "UpdateHostKeys=no",
            "-o",
            "GlobalKnownHostsFile=/dev/null",
            "-o",
            "HashKnownHosts=no",
            "-o",
            f"HostKeyAlias={host_key_alias}",
            "-o",
            f"UserKnownHostsFile={known_hosts_path}",
            "-o",
            "LogLevel=ERROR",
            "-p",
            str(int(port)),
            f"root@{host}",
            component_factory_f41_remote_smoke_command(),
        ]
        try:
            ssh_environment = {
                "LC_ALL": "C",
                "PATH": os.environ.get("PATH", os.defpath),
            }
            completed = run_component_factory_f41_ssh_probe(
                command, ssh_environment
            )
        except FileNotFoundError as exc:
            raise SafeError("OpenSSH client is unavailable for F41 verification") from exc
        except ComponentFactoryF41ProbeTimeout:
            last_probe = "ssh_probe_timeout"
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        except (
            ComponentFactoryF41ProbeOutputLimit,
            ComponentFactoryF41ProbeSpawnError,
            ComponentFactoryF41ProbeLocalIoError,
            ComponentFactoryF41ProbeCleanupError,
            OSError,
            subprocess.SubprocessError,
        ) as exc:
            if isinstance(exc, ComponentFactoryF41ProbeOutputLimit):
                fixed_probe = "ssh_probe_output_limit"
            elif isinstance(exc, ComponentFactoryF41ProbeSpawnError):
                fixed_probe = "ssh_probe_spawn_failed"
            elif isinstance(exc, ComponentFactoryF41ProbeCleanupError):
                fixed_probe = "ssh_probe_cleanup_failed"
            else:
                fixed_probe = "ssh_probe_local_io_failed"
            raise SafeError(
                "F41 SSH /workspace/READY and image smoke verification failed "
                f"(last state: {last_state}; last probe: {fixed_probe}); do not "
                "treat the instance as ready"
            ) from exc
        if completed.returncode == 0 and completed.stdout.strip() == "F41_REMOTE_READY":
            validate_component_factory_f41_known_hosts(known_hosts_path, instance_id)
            return known_hosts_path
        last_probe = classify_component_factory_f41_ssh_probe(completed)
        if last_probe in {
            "ssh_authentication_failed",
            "ssh_host_key_rejected",
            "image_smoke_report_missing",
            "remote_ready_contract_rejected",
            "onstart_failed",
            "remote_command_rejected",
        }:
            raise SafeError(
                "F41 SSH /workspace/READY and image smoke verification failed "
                f"(last state: {last_state}; last probe: {last_probe}); do not "
                "treat the instance as ready"
            )
        time.sleep(POLL_INTERVAL_SECONDS)
    raise SafeError(
        "F41 SSH /workspace/READY and image smoke verification did not pass in time "
        f"(last state: {last_state}; last probe: {last_probe}); do not treat the "
        "instance as ready"
    )


