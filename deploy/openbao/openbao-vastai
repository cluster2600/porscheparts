        "status",
        "machine_verification",
        "cpu_cores_effective",
        "cpu_ram_mb",
        "disk_space_gb",
        "dph_total",
        "image",
    )
    for _ in range(COMPONENT_FACTORY_F41_CONTRACT_ATTEMPTS):
        try:
            result = vast_request(api_key, f"/api/v0/instances/{instance_id}/")
        except SafeHttpError as exc:
            if exc.status_code == 404:
                time.sleep(POLL_INTERVAL_SECONDS)
                continue
            raise
        raw_instance = result.get("instances")
        if not isinstance(raw_instance, dict):
            raise SafeError("Vast.ai returned invalid post-launch F41 instance metadata")
        instance = safe_instance(raw_instance)
        if any(instance.get(field) is None for field in required_fields):
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        errors = []
        if instance["id"] != instance_id:
            errors.append("instance id")
        if instance["label"] != attempt_label:
            errors.append("label")
        if instance["image"] != COMPONENT_FACTORY_F41_IMAGE:
            errors.append("image digest")
        if instance["status"] not in {"created", "loading", "running"}:
            errors.append("status")
        numeric_contract = (
            (
                instance["cpu_cores_effective"],
                COMPONENT_FACTORY_F41_MIN_CPU_THREADS,
                "effective CPU threads",
            ),
            (
                instance["cpu_ram_mb"],
                COMPONENT_FACTORY_F41_MIN_CPU_RAM_MB,
                "CPU RAM",
            ),
            (instance["disk_space_gb"], COMPONENT_FACTORY_F41_DISK_GB, "disk"),
        )
        for value, minimum, label in numeric_contract:
            number = finite_number(value)
            if number is None or number < minimum:
                errors.append(label)
        price = finite_number(instance["dph_total"])
        if price is None or not 0 <= price <= COMPONENT_FACTORY_F41_MAX_DPH:
            errors.append("dph_total")
        bandwidth_contract = (
            (
                instance["inet_up_cost_usd_per_gb"],
                COMPONENT_FACTORY_F41_MAX_INET_UP_COST_USD_PER_GB,
                "inet_up_cost",
            ),
            (
                instance["inet_down_cost_usd_per_gb"],
                COMPONENT_FACTORY_F41_MAX_INET_DOWN_COST_USD_PER_GB,
                "inet_down_cost",
            ),
        )
        for value, maximum, label in bandwidth_contract:
            # Vast does not expose these fields on every instance response. The
            # offer is always checked immediately before create; when the
            # instance response repeats a tariff, it must still fit the cap.
            if value is None:
                continue
            cost = finite_number(value)
            if cost is None or not 0 <= cost <= maximum:
                errors.append(label)
        if instance["machine_verification"] != "verified":
            errors.append("machine verification")
        if errors:
            raise SafeError(
                "post-launch contract is outside the fixed component-factory "
                "F41 limits: " + ", ".join(errors)
            )
        if instance["status"] != "running":
            time.sleep(POLL_INTERVAL_SECONDS)
            continue
        return instance
    raise SafeError(
        "Vast.ai did not expose a complete running post-launch F41 contract in time"
    )


def reconcile_uncertain_simready_launch(api_key: str) -> None:
    """Rollback the sole project instance when a create response is uncertain."""
    for _ in range(30):
        try:
            existing = list_instances(api_key, label=SIMREADY_LABEL)
        except SafeError:
            time.sleep(1)
            continue
        if existing:
            ids = sorted(
                instance.get("id")
                for instance in existing
                if isinstance(instance.get("id"), int)
            )
            if len(ids) == 1:
                destroy_instance_verified(api_key, ids[0])
                raise SafeError(
                    "launch outcome was uncertain; the sole SimReady instance "
                    f"{ids[0]} was automatically destroyed and verified absent"
                )
            raise SafeError(
                "launch outcome is uncertain and multiple SimReady instances exist; "
                "inspect instances before retrying"
            )
        time.sleep(1)
    raise SafeError(
        "launch outcome remains uncertain after the reconciliation window; "
        "do not retry automatically and inspect SimReady instances first"
    )


def reconcile_uncertain_wave_launch(api_key: str) -> None:
    """Rollback the sole F39-labelled instance after an uncertain create call."""
    for _ in range(30):
