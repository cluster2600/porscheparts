def read_local_ssh_public_key() -> str:
    validate_approved_ssh_private_key()
    try:
        info = SSH_PUBLIC_KEY_FILE.lstat()
    except FileNotFoundError as exc:
        raise SafeError(f"missing approved SSH public key: {SSH_PUBLIC_KEY_FILE}") from exc
    if (
        info.st_uid != os.getuid()
        or not stat.S_ISREG(info.st_mode)
        or info.st_size <= 0
        or info.st_size > 16384
    ):
        raise SafeError(f"approved SSH public key is invalid: {SSH_PUBLIC_KEY_FILE}")
    value = SSH_PUBLIC_KEY_FILE.read_text(encoding="utf-8").strip()
    if not value.startswith(("ssh-ed25519 ", "ssh-rsa ", "ecdsa-sha2-")):
        raise SafeError("approved SSH public key is not in OpenSSH format")
    return value


def validate_approved_ssh_private_key() -> None:
    """Validate metadata only; never read or print the private key."""
    try:
        info = SSH_PRIVATE_KEY_FILE.lstat()
    except FileNotFoundError as exc:
        raise SafeError(
            f"missing approved SSH private key: {SSH_PRIVATE_KEY_FILE}"
        ) from exc
    if (
        info.st_uid != os.getuid()
        or not stat.S_ISREG(info.st_mode)
        or stat.S_IMODE(info.st_mode) & 0o077
        or info.st_size <= 0
        or info.st_size > 1024 * 1024
    ):
        raise SafeError(
            "approved SSH private key has unsafe ownership, type, permissions, or size: "
            f"{SSH_PRIVATE_KEY_FILE}"
        )


def ensure_local_ssh_registered(api_key: str) -> None:
    try:
        result = vast_request(
            api_key,
            "/api/v0/ssh/",
            method="POST",
            payload={"ssh_key": read_local_ssh_public_key()},
        )
    except SafeError as exc:
        if "SSH key already exists on this account" in str(exc):
            return
        raise
    if result.get("success") is not True:
        raise SafeError("Vast.ai did not accept the approved SSH key")


