class SafeError(Exception):
    """An error safe to print without secret material."""


class RejectRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Never replay a request, including its credentials, after a redirect."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def validate_pinned_digest() -> None:
    if re.fullmatch(r"sha256:[0-9a-f]{64}", GHCR_DIGEST) is None:
        raise SafeError("GHCR pinned SimReady digest is invalid")
    if GHCR_DIGEST in GHCR_REVOKED_DIGESTS:
        raise SafeError(
            "GHCR pinned SimReady digest is revoked; publish and pin the corrected image first"
        )


def validate_private_file(path: Path) -> None:
    try:
        info = path.stat()
    except FileNotFoundError as exc:
        raise SafeError(f"missing bootstrap file: {path}") from exc
    if info.st_uid != os.getuid() or not stat.S_ISREG(info.st_mode):
        raise SafeError(f"bootstrap file has unsafe ownership or type: {path}")
    if stat.S_IMODE(info.st_mode) != 0o600 or not 0 < info.st_size <= 4096:
        raise SafeError(f"bootstrap file has unsafe permissions or size: {path}")


def validate_bootstrap_metadata() -> None:
    try:
        info = CONFIG_DIR.stat()
    except FileNotFoundError as exc:
        raise SafeError(f"missing bootstrap directory: {CONFIG_DIR}") from exc
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise SafeError(f"bootstrap directory must be owned by this user with mode 0700: {CONFIG_DIR}")
    for path in (ROLE_ID_FILE, SECRET_ID_FILE, SECRET_PATH_FILE):
        validate_private_file(path)


def read_bootstrap_value(path: Path) -> str:
    value = path.read_text(encoding="utf-8").strip()
    if not value or len(value) > 4096:
        raise SafeError(f"bootstrap value is invalid: {path}")
    return value


def decode_json(body: bytes, source: str) -> dict:
    if len(body) > MAX_RESPONSE_BYTES:
        raise SafeError(f"{source} returned an unexpectedly large response")
    try:
        value = json.loads(body)
    except json.JSONDecodeError as exc:
        raise SafeError(f"{source} returned invalid JSON") from exc
    if not isinstance(value, dict):
        raise SafeError(f"{source} returned invalid JSON")
    return value


def request(
    url: str,
    *,
    method: str = "GET",
    payload: dict | None = None,
    headers: dict[str, str] | None = None,
    source: str,
) -> tuple[dict, dict[str, str]]:
    data = None if payload is None else json.dumps(payload, separators=(",", ":")).encode("utf-8")
    request_headers = {"Accept": "application/json", "Content-Type": "application/json"}
    request_headers.update(headers or {})
    web_request = urllib.request.Request(url, data=data, headers=request_headers, method=method)
    if not TLS_CA_FILE.is_file():
        raise SafeError(f"missing system CA bundle: {TLS_CA_FILE}")
    context = ssl.create_default_context(cafile=str(TLS_CA_FILE))
    opener = urllib.request.build_opener(
        RejectRedirectHandler(),
        urllib.request.HTTPSHandler(context=context),
    )
    try:
        with opener.open(web_request, timeout=TIMEOUT_SECONDS) as response:
            if (
                300 <= response.getcode() < 400
                or response.geturl() != web_request.full_url
            ):
                raise SafeError(f"{source} returned an unsafe redirect")
            body = response.read(MAX_RESPONSE_BYTES + 1)
            response_headers = {key.lower(): value for key, value in response.headers.items()}
    except SafeError:
        raise
    except urllib.error.HTTPError as exc:
        status_code = exc.code
        exc.close()
        raise SafeError(f"{source} rejected the request with HTTP {status_code}") from None
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise SafeError(f"{source} is unavailable") from exc
    return (decode_json(body, source) if body else {}, response_headers)


def check_local_service() -> None:
    try:
        with socket.create_connection(("127.0.0.1", 8200), timeout=2):
            pass
    except OSError as exc:
        raise SafeError("OpenBao is not listening on 127.0.0.1:8200") from exc


def login() -> str:
    validate_bootstrap_metadata()
    check_local_service()
    result, _ = request(
        f"{BAO_ADDR}/v1/{BAO_AUTH_PATH}",
        method="POST",
        payload={
            "role_id": read_bootstrap_value(ROLE_ID_FILE),
            "secret_id": read_bootstrap_value(SECRET_ID_FILE),
        },
        source="OpenBao",
    )
    token = result.get("auth", {}).get("client_token")
    if not isinstance(token, str) or not token:
        raise SafeError("OpenBao AppRole login did not return a session token")
    return token


def revoke_token(token: str) -> None:
    try:
        request(
            f"{BAO_ADDR}/v1/auth/token/revoke-self",
            method="POST",
            payload={},
            headers={"X-Vault-Token": token},
            source="OpenBao",
        )
    except SafeError:
        pass


def read_credential(session_token: str) -> tuple[str, str]:
    if read_bootstrap_value(SECRET_PATH_FILE) != ALLOWED_SECRET_PATH:
        raise SafeError("OpenBao GHCR path is outside the fixed allowlist")
    result, _ = request(
        f"{BAO_ADDR}/v1/{ALLOWED_SECRET_PATH}",
        headers={"X-Vault-Token": session_token},
        source="OpenBao",
    )
    payload = result.get("data", {}).get("data")
    if not isinstance(payload, dict):
        raise SafeError("OpenBao GHCR path is missing or empty")
    token = next(
        (
            payload.get(field)
            for field in ("GITHUB_TOKEN", "GH_TOKEN", "github_token", "token")
            if payload.get(field)
        ),
        None,
    )
    if not isinstance(token, str) or not 20 <= len(token) <= 4096 or any(c.isspace() for c in token):
        raise SafeError("OpenBao GitHub payload is missing a supported token field")
    return GHCR_USERNAME, token


def registry_auth_check(username: str, password: str) -> None:
    basic = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
    token_result, _ = request(
        GHCR_TOKEN_URL,
        headers={"Authorization": f"Basic {basic}"},
        source="GHCR token service",
    )
    registry_token = token_result.get("token", token_result.get("access_token"))
    if not isinstance(registry_token, str) or not registry_token:
        raise SafeError("GHCR token service did not grant repository pull access")
    _, headers = request(
        f"https://ghcr.io/v2/{GHCR_REPOSITORY}/manifests/{GHCR_DIGEST}",
        headers={
            "Authorization": f"Bearer {registry_token}",
            "Accept": "application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json",
        },
        source="GHCR manifest",
    )
    if headers.get("docker-content-digest") != GHCR_DIGEST:
        raise SafeError("GHCR returned an unexpected image digest")


def f46_registry_proof(username: str, password: str, immutable_ref: str) -> dict:
    """Verify one fixed-repository F46 index and its sole linux/amd64 child."""
    match = F46_IMAGE_RE.fullmatch(immutable_ref)
    if match is None:
        raise SafeError("F46 image must use the fixed repository and a complete digest")
    index_digest = match.group("digest")
    token_url = (
        "https://ghcr.io/token?service=ghcr.io&scope="
        + urllib.parse.quote(f"repository:{F46_REPOSITORY}:pull", safe="")
    )
    basic = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode(
        "ascii"
    )
    token_result, _ = request(
        token_url,
        headers={"Authorization": f"Basic {basic}"},
        source="GHCR F46 token service",
    )
    registry_token = token_result.get("token", token_result.get("access_token"))
    if not isinstance(registry_token, str) or not registry_token:
        raise SafeError("GHCR F46 token service did not grant pull access")
    index, index_headers = request(
        f"https://ghcr.io/v2/{F46_REPOSITORY}/manifests/{index_digest}",
        headers={
            "Authorization": f"Bearer {registry_token}",
            "Accept": (
                "application/vnd.oci.image.index.v1+json,"
                "application/vnd.docker.distribution.manifest.list.v2+json"
            ),
        },
        source="GHCR F46 index",
    )
    if index_headers.get("docker-content-digest") != index_digest:
        raise SafeError("GHCR F46 returned an unexpected index digest")
    manifests = index.get("manifests")
    if not isinstance(manifests, list):
        raise SafeError("GHCR F46 reference is not a multi-platform index")
    matching = [
        item
        for item in manifests
        if isinstance(item, dict)
        and isinstance(item.get("platform"), dict)
        and item["platform"].get("os") == "linux"
        and item["platform"].get("architecture") == "amd64"
        and item["platform"].get("variant") in (None, "")
    ]
    if len(matching) != 1:
        raise SafeError("GHCR F46 must expose exactly one linux/amd64 manifest")
    platform_digest = matching[0].get("digest")
    if (
        not isinstance(platform_digest, str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", platform_digest) is None
    ):
        raise SafeError("GHCR F46 linux/amd64 platform digest is invalid")
    _, platform_headers = request(
        f"https://ghcr.io/v2/{F46_REPOSITORY}/manifests/{platform_digest}",
        headers={
            "Authorization": f"Bearer {registry_token}",
            "Accept": (
                "application/vnd.oci.image.manifest.v1+json,"
                "application/vnd.docker.distribution.manifest.v2+json"
            ),
        },
        source="GHCR F46 linux/amd64 manifest",
    )
    if platform_headers.get("docker-content-digest") != platform_digest:
        raise SafeError("GHCR F46 returned an unexpected platform digest")
    return {
        "classification": "production_wrapper_evidence",
        "immutable_ref": immutable_ref,
        "index_digest": index_digest,
        "platform_manifest_digest": platform_digest,
        "os": "linux",
        "architecture": "amd64",
        "registry_digest_verified": True,
        "platform_manifest_verified": True,
        "runtime_smoke_verified": False,
        "scope": "registry_and_platform_only_runtime_smoke_still_required",
    }


def validate_qualification_evidence(path: Path) -> tuple[dict, bytes]:
    """Read one tracked public qualification record without following a link."""
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
    except OSError as exc:
        raise SafeError("runtime qualification evidence is unavailable") from exc
    try:
        with os.fdopen(descriptor, "rb") as handle:
            info = os.fstat(handle.fileno())
            if not stat.S_ISREG(info.st_mode):
                raise SafeError("runtime qualification evidence must be a regular file")
            data = handle.read(1024 * 1024 + 1)
    except SafeError:
        raise
    except OSError as exc:
        raise SafeError("runtime qualification evidence is unavailable") from exc
    if not data or len(data) > 1024 * 1024:
        raise SafeError("runtime qualification evidence has an unsafe size")
    try:
        payload = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SafeError("runtime qualification evidence is invalid") from exc
    if not isinstance(payload, dict):
        raise SafeError("runtime qualification evidence is invalid")
    expected_ref = f"ghcr.io/{GHCR_REPOSITORY}@{GHCR_DIGEST}"
    run_id = payload.get("github_run_id")
    checks = payload.get("checks")
    source_revision = payload.get("source_revision")
    source_branch = payload.get("source_branch")
    workflow_git_blob = payload.get("workflow_git_blob")
    if (
        payload.get("schema_version") != "1.0.0"
        or payload.get("status") != QUALIFIED_STATUS
        or payload.get("image_ref") != expected_ref
        or payload.get("image_repository") != f"ghcr.io/{GHCR_REPOSITORY}"
        or payload.get("manifest_digest") != GHCR_DIGEST
        or payload.get("platform") != "linux/amd64"
        or type(run_id) is not int
        or run_id <= 0
        or payload.get("github_run_url")
        != f"https://github.com/{GITHUB_REPOSITORY}/actions/runs/{run_id}"
        or type(source_revision) is not str
        or re.fullmatch(r"[0-9a-f]{40}", source_revision) is None
        or type(source_branch) is not str
        or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]{0,127}", source_branch)
        is None
        or type(payload.get("run_attempt")) is not int
        or payload["run_attempt"] <= 0
        or payload.get("workflow_path") != WORKFLOW_PATH
        or type(workflow_git_blob) is not str
        or re.fullmatch(r"[0-9a-f]{40}", workflow_git_blob) is None
        or not isinstance(checks, dict)
        or set(checks) != QUALIFICATION_CHECKS
        or any(value is not True for value in checks.values())
    ):
        raise SafeError("runtime qualification evidence does not match the pinned image")
    return payload, data


def anonymous_runtime_check(source_revision: str) -> None:
    """Verify the public single-platform digest and both publication tags."""
    validate_pinned_digest()
    if (
        type(source_revision) is not str
        or re.fullmatch(r"[0-9a-f]{40}", source_revision) is None
    ):
        raise SafeError("public GHCR source revision tag is invalid")
    token_result, _ = request(GHCR_TOKEN_URL, source="public GHCR token service")
    registry_token = token_result.get("token", token_result.get("access_token"))
    if not isinstance(registry_token, str) or not registry_token:
        raise SafeError("public GHCR token service did not grant pull access")
    manifest_headers = {
        "Authorization": f"Bearer {registry_token}",
        "Accept": (
            "application/vnd.oci.image.manifest.v1+json,"
            "application/vnd.docker.distribution.manifest.v2+json"
        ),
    }
    manifest, headers = request(
        f"https://ghcr.io/v2/{GHCR_REPOSITORY}/manifests/{GHCR_DIGEST}",
        headers=manifest_headers,
        source="public GHCR manifest",
    )
    if headers.get("docker-content-digest") != GHCR_DIGEST:
        raise SafeError("public GHCR returned an unexpected image digest")
    if manifest.get("mediaType") not in {
        "application/vnd.oci.image.manifest.v1+json",
        "application/vnd.docker.distribution.manifest.v2+json",
    }:
        raise SafeError("public GHCR digest is not a single-platform image manifest")
    for tag in (source_revision, "latest"):
        _, tag_headers = request(
            f"https://ghcr.io/v2/{GHCR_REPOSITORY}/manifests/{tag}",
            headers=manifest_headers,
            source=f"public GHCR {tag} tag",
        )
        if tag_headers.get("docker-content-digest") != GHCR_DIGEST:
            raise SafeError(f"public GHCR {tag} tag does not resolve to the pinned digest")
    config = manifest.get("config")
    if not isinstance(config, dict):
        raise SafeError("public GHCR manifest has no image config")
    config_digest = config.get("digest")
    if (
        re.fullmatch(r"sha256:[0-9a-f]{64}", str(config_digest)) is None
        or config.get("mediaType")
        not in {
            "application/vnd.oci.image.config.v1+json",
            "application/vnd.docker.container.image.v1+json",
        }
        or type(config.get("size")) is not int
        or not 0 < config["size"] <= MAX_RESPONSE_BYTES
    ):
        raise SafeError("public GHCR manifest has an invalid image config digest")


def git_blob_sha1(data: bytes) -> str:
    """Return the Git SHA-1 object id for exact blob bytes."""
    header = f"blob {len(data)}\0".encode("ascii")
    return hashlib.sha1(header + data).hexdigest()


def decode_github_workflow_blob(workflow: dict, expected_blob: str) -> bytes:
    """Decode and hash the exact workflow bytes returned by GitHub."""
    content = workflow.get("content")
    size = workflow.get("size")
    if (
        workflow.get("type") != "file"
        or workflow.get("path") != WORKFLOW_PATH
        or workflow.get("sha") != expected_blob
        or workflow.get("encoding") != "base64"
        or type(content) is not str
        or type(size) is not int
        or not 0 < size <= 1024 * 1024
    ):
        raise SafeError("GitHub Actions workflow source does not match its qualified blob")
    compact_content = content.replace("\n", "").replace("\r", "")
    try:
        data = base64.b64decode(compact_content, validate=True)
    except (ValueError, base64.binascii.Error) as exc:
        raise SafeError("GitHub Actions workflow source content is invalid") from exc
    if len(data) != size or git_blob_sha1(data) != expected_blob:
        raise SafeError("GitHub Actions workflow source content does not match its qualified blob")
    return data


def github_runtime_check(evidence: dict) -> tuple[int, str]:
    """Bind the attestation to one successful public workflow job and its steps."""
    run_id = evidence["github_run_id"]
    request_headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": "3dprinting993-runtime-attestor",
    }
    run, _ = request(
        f"{GITHUB_API_URL}/actions/runs/{run_id}",
        headers=request_headers,
        source="GitHub Actions run",
    )
    if (
        run.get("id") != run_id
        or not isinstance(run.get("repository"), dict)
        or run["repository"].get("full_name") != GITHUB_REPOSITORY
        or run.get("name") != "Build compute images"
        or run.get("path") != WORKFLOW_PATH
        or run.get("status") != "completed"
        or run.get("conclusion") != "success"
        or run.get("head_sha") != evidence["source_revision"]
        or run.get("head_branch") != evidence["source_branch"]
        or run.get("run_attempt") != evidence["run_attempt"]
        or run.get("html_url") != evidence["github_run_url"]
        or run.get("event") != "workflow_dispatch"
    ):
        raise SafeError("GitHub Actions qualification run is not the expected success")
    workflow, _ = request(
        f"{GITHUB_API_URL}/contents/{WORKFLOW_PATH}?ref={evidence['source_revision']}",
        headers=request_headers,
        source="GitHub Actions workflow source",
    )
    decode_github_workflow_blob(workflow, evidence["workflow_git_blob"])
    jobs_payload, _ = request(
        f"{GITHUB_API_URL}/actions/runs/{run_id}/jobs?per_page=100",
        headers=request_headers,
        source="GitHub Actions jobs",
    )
    jobs = jobs_payload.get("jobs")
    if not isinstance(jobs, list):
        raise SafeError("GitHub Actions jobs response is invalid")
    candidates = [job for job in jobs if isinstance(job, dict) and job.get("name") == REQUIRED_JOB_NAME]
    if len(candidates) != 1:
        raise SafeError("GitHub Actions qualification job is missing or ambiguous")
    job = candidates[0]
    job_id = job.get("id")
    if (
        type(job_id) is not int
        or job_id <= 0
        or job.get("status") != "completed"
        or job.get("conclusion") != "success"
    ):
        raise SafeError("GitHub Actions qualification job is not successful")
    steps = job.get("steps")
    if not isinstance(steps, list):
        raise SafeError("GitHub Actions qualification steps are missing")
    selected_steps = [
        step
        for step in steps
        if isinstance(step, dict) and step.get("name") in REQUIRED_STEPS
    ]
    actual = {step.get("name"): step.get("conclusion") for step in selected_steps}
    if len(selected_steps) != len(REQUIRED_STEPS) or actual != REQUIRED_STEPS:
        raise SafeError("GitHub Actions qualification steps are incomplete")
    expected_url = f"https://github.com/{GITHUB_REPOSITORY}/actions/runs/{run_id}/job/{job_id}"
    if job.get("html_url") != expected_url:
        raise SafeError("GitHub Actions qualification job URL is invalid")
    return job_id, expected_url


def self_git_blob() -> str:
    """Return the SHA-1 Git blob id of the installed, attesting wrapper bytes."""
    try:
        data = Path(__file__).read_bytes()
    except OSError as exc:
        raise SafeError("cannot hash the installed GHCR wrapper") from exc
    return git_blob_sha1(data)


def write_private_attestation(path: Path, payload: dict) -> None:
    if not path.name or path.name in {".", ".."}:
        raise SafeError("runtime attestation output path is invalid")
    parent_flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    try:
        parent_descriptor = os.open(path.parent, parent_flags)
    except OSError as exc:
        raise SafeError("runtime attestation output parent must be a private non-symlink directory") from exc
    try:
        parent_info = os.fstat(parent_descriptor)
        if (
            not stat.S_ISDIR(parent_info.st_mode)
            or parent_info.st_uid != os.getuid()
            or stat.S_IMODE(parent_info.st_mode) != 0o700
        ):
            raise SafeError(
                "runtime attestation output parent must be a private non-symlink directory"
            )
        flags = (
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0)
        )
        try:
            descriptor = os.open(path.name, flags, 0o600, dir_fd=parent_descriptor)
        except OSError as exc:
            raise SafeError("runtime attestation output must be a new private file") from exc
        try:
            data = (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")
            with os.fdopen(descriptor, "wb") as handle:
                os.fchmod(handle.fileno(), 0o600)
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())
                output_info = os.fstat(handle.fileno())
                if (
                    not stat.S_ISREG(output_info.st_mode)
                    or output_info.st_uid != os.getuid()
                    or stat.S_IMODE(output_info.st_mode) != 0o600
                    or output_info.st_nlink != 1
                ):
                    raise SafeError("runtime attestation output permissions are unsafe")
        except Exception:
            try:
                os.unlink(path.name, dir_fd=parent_descriptor)
            except OSError:
                pass
            raise
    finally:
        os.close(parent_descriptor)


def attest_runtime(
    qualification_path: Path,
    output_path: Path,
    job_id: str,
    nonce: str,
) -> None:
    validate_pinned_digest()
    if (
        type(job_id) is not str
        or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", job_id) is None
    ):
        raise SafeError("runtime attestation job id is invalid")
    if type(nonce) is not str or re.fullmatch(r"[0-9a-f]{32}", nonce) is None:
        raise SafeError("runtime attestation invocation nonce is invalid")
    evidence, evidence_bytes = validate_qualification_evidence(qualification_path)
    anonymous_runtime_check(evidence["source_revision"])
    github_job_id, github_job_url = github_runtime_check(evidence)
    payload = {
        "schema_version": "1.0.0",
        "status": "verified_public_runtime",
        "verified_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "image_ref": evidence["image_ref"],
        "manifest_digest": evidence["manifest_digest"],
        "platform": "linux/amd64",
        "source_revision": evidence["source_revision"],
        "source_branch": evidence["source_branch"],
        "github_run_id": evidence["github_run_id"],
        "github_run_url": evidence["github_run_url"],
        "run_attempt": evidence["run_attempt"],
        "workflow_path": evidence["workflow_path"],
        "workflow_git_blob": evidence["workflow_git_blob"],
        "github_job_id": github_job_id,
        "github_job_url": github_job_url,
        "qualification_evidence_sha256": hashlib.sha256(evidence_bytes).hexdigest(),
        "verified_steps": dict(REQUIRED_STEPS),
        "attestor": {
            "path": ATTESTOR_REPOSITORY_PATH,
            "command": ATTESTOR_COMMAND,
            "git_blob": self_git_blob(),
        },
        "invocation": {
            "job_id": job_id,
            "nonce": nonce,
            "authenticity_scope": ATTESTATION_AUTHENTICITY_SCOPE,
        },
    }
    write_private_attestation(output_path, payload)


def run_vast(operation: list[str]) -> int:
    if len(operation) == 2 and operation[0] == "launch-vast-simready-heavy" and operation[1].isdigit():
        vast_operation = ["launch-simready-heavy", operation[1]]
    elif (
        len(operation) == 6
        and operation[0] == "launch-vast-f46"
        and operation[1].isdigit()
        and F46_IMAGE_RE.fullmatch(operation[2]) is not None
        and operation[3].isdigit()
        and operation[4] == "--attempt-label"
        and F46_ATTEMPT_LABEL_RE.fullmatch(operation[5]) is not None
    ):
        vast_operation = [
            "launch-f46",
            operation[1],
            operation[2],
            operation[3],
            operation[4],
            operation[5],
        ]
    else:
        raise SafeError(
            "usage: openbao-ghcr --check|--auth-check|"
            "attest-simready-runtime <qualification.json> <new-output.json> <job_id> <nonce>|"
            "verify-f46 <image@digest>|launch-vast-simready-heavy <offer_id>|"
            "launch-vast-f46 <offer_id> <image@digest> <deadline_epoch> "
            "--attempt-label <label>"
        )
    if not VAST_WRAPPER.is_file() or not os.access(VAST_WRAPPER, os.X_OK):
        raise SafeError(f"missing approved Vast.ai wrapper: {VAST_WRAPPER}")
    result = subprocess.run(
        [str(VAST_WRAPPER), *vast_operation],
        check=False,
    )
    return result.returncode


def main() -> int:
    operation = sys.argv[1:]
    try:
        validate_bootstrap_metadata()
        validate_pinned_digest()
        if operation == ["--check"]:
            if read_bootstrap_value(SECRET_PATH_FILE) != ALLOWED_SECRET_PATH:
                raise SafeError("OpenBao GHCR path is outside the fixed allowlist")
            print("OpenBao GHCR reader check OK")
            return 0
        session_token = login()
        try:
            username, password = read_credential(session_token)
            registry_auth_check(username, password)
            if operation == ["--auth-check"]:
                print(f"GHCR read access OK for {username} and pinned SimReady image")
                return 0
            if len(operation) == 5 and operation[0] == ATTESTOR_COMMAND:
                attest_runtime(
                    Path(operation[1]), Path(operation[2]), operation[3], operation[4]
                )
                print("GHCR public runtime attestation written")
                return 0
            if len(operation) == 2 and operation[0] == "verify-f46":
                print(
                    json.dumps(
                        f46_registry_proof(username, password, operation[1]),
                        indent=2,
                        sort_keys=True,
                    )
                )
                return 0
            if len(operation) == 6 and operation[0] == "launch-vast-f46":
                f46_registry_proof(username, password, operation[2])
            return run_vast(operation)
        finally:
            revoke_token(session_token)
    except SafeError as exc:
        print(f"OpenBao GHCR error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
