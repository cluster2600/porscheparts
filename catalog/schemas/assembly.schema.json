{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cluster2600/porscheparts/schemas/assembly.schema.json",
  "title": "porscheparts sourced assembly relationship",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assembly_id", "name", "vehicle", "status", "instances", "physical_summary", "relationship_sources", "known_limits"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "assembly_id": { "type": "string", "pattern": "^ASM-[A-Z0-9][A-Z0-9._-]{2,79}$" },
    "name": { "type": "string", "minLength": 3 },
    "vehicle": { "type": "object", "required": ["generation", "variants"], "properties": { "generation": { "const": "993" }, "variants": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "status": { "enum": ["logical", "positioned", "interface_checked"] },
    "instances": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["instance_id", "component_id", "quantity", "frame", "transform", "relationship_source_id"], "properties": { "instance_id": { "type": "string" }, "component_id": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 }, "frame": { "type": "string" }, "transform": { "type": ["array", "null"], "minItems": 16, "maxItems": 16, "items": { "type": "number" } }, "relationship_source_id": { "type": "string" } } } },
    "physical_summary": { "type": "object", "required": ["mass_g", "basis"], "properties": { "mass_g": { "type": "number", "exclusiveMinimum": 0 }, "basis": { "const": "sum_of_component_records" } } },
    "relationship_sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["source_id", "url", "accessed_on", "claim"], "properties": { "source_id": { "type": "string" }, "url": { "type": "string" }, "accessed_on": { "type": "string" }, "claim": { "type": "string" } } } },
    "known_limits": { "type": "array", "items": { "type": "string" } },
    "mounting_relations": {
      "description": "Optional. Fastening relations confirmed by a source. A relation names its instances, the counterpart, the fastener and the tightening torque; every value cites a relationship source, and a count or a torque that is not sourced stays null.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation_id", "instance_ids", "counterpart", "fastener", "tightening_torque", "source_ids", "limits"],
        "properties": {
          "relation_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_]{2,79}$" },
          "instance_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "counterpart": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "enum": ["component", "named_interface"] },
              "ref": { "type": "string", "minLength": 1 },
              "twin_interfaces": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["twin_id", "interface_id"], "properties": { "twin_id": { "type": "string" }, "interface_id": { "type": "string" } } } }
            }
          },
          "fastener": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "thread", "seat", "count_per_unit", "count_parameter_id", "source_id"],
            "properties": {
              "description": { "type": "string", "minLength": 3 },
              "thread": { "type": ["string", "null"], "pattern": "^M[0-9]+(\\.[0-9]+)?x[0-9]+(\\.[0-9]+)?$" },
              "seat": { "type": ["string", "null"] },
              "count_per_unit": { "description": "Fasteners per unit of each instance (per wheel, not per instance quantity); null when no source gives it.", "type": ["integer", "null"], "minimum": 1 },
              "count_parameter_id": { "type": ["string", "null"] },
              "source_id": { "type": "string" }
            }
          },
          "tightening_torque": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["value", "unit", "source_id", "measurement_refs", "corroborated_by"],
            "properties": {
              "value": { "type": "number", "exclusiveMinimum": 0 },
              "unit": { "const": "Nm" },
              "source_id": { "type": "string" },
              "measurement_refs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["measurement_id", "value_id"], "properties": { "measurement_id": { "type": "string" }, "value_id": { "type": "string" } } } },
              "corroborated_by": { "type": "array", "items": { "type": "string" } }
            }
          },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "limits": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
