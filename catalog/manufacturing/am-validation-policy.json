{
  "schema_version": "1.0.0",
  "policy_id": "METAL-AM-VALIDATION-PIPELINE-0001",
  "scope": {
    "catalog_directory": "catalog/parts",
    "trigger_candidate_processes": ["LPBF", "DMLS"],
    "rule": "Toute pièce proposant LPBF ou DMLS reste suivie par cette politique, même si son procédé préféré est encore undecided ou conventionnel."
  },
  "stage_definitions": [
    {
      "stage_id": "01_source_and_geometry_authority",
      "required_for_release": true,
      "acceptance": "Provenance, variante, révision CAO, cotes mesurées et hypothèses sont séparées et liées par empreinte."
    },
    {
      "stage_id": "02_cad_brep_and_mesh_integrity",
      "required_for_release": true,
      "acceptance": "Le master éditable, le STEP/BREP et le maillage dérivé sont valides, à l'échelle, fermés et reliés par SHA-256."
    },
    {
      "stage_id": "03_full_layer_slicing_and_supports",
      "required_for_release": true,
      "acceptance": "Toutes les couches de la pièce sont réellement sectionnées et les îlots, overhangs, supports et évacuations de poudre sont contrôlés."
    },
    {
      "stage_id": "04_material_machine_process_card",
      "required_for_release": true,
      "acceptance": "Alliage, poudre, machine, orientation, paramètres, traitements et propriétés dépendantes de la température appartiennent à une même route qualifiée."
    },
    {
      "stage_id": "05_local_melt_pool_thermal",
      "required_for_release": true,
      "acceptance": "Le bain de fusion local est calculé avec la carte cible, converge en espace/temps et est corrélé à des coupons de la route retenue."
    },
    {
      "stage_id": "06_full_build_thermomechanical_distortion",
      "required_for_release": true,
      "acceptance": "La construction complète, les supports, la plaque, la détente et la distorsion sont simulés avec convergence et carte constitutive calibrée."
    },
    {
      "stage_id": "07_recoater_and_support_removal",
      "required_for_release": true,
      "acceptance": "Le jeu au recoater sur forme déformée et l'accès au retrait des supports sont validés avec le projet fournisseur."
    },
    {
      "stage_id": "08_omniverse_simready_asset",
      "required_for_release": true,
      "acceptance": "Le USD final passe Asset Validator, Geometry, Physics et le profil SimReady cible, sans propriété physique inventée."
    },
    {
      "stage_id": "09_omniverse_assembly_function",
      "required_for_release": true,
      "acceptance": "La pièce est testée avec ses interfaces, tolérances, mouvements, contacts, charges et scénarios de défaillance dans l'assemblage."
    },
    {
      "stage_id": "10_physical_correlation_and_inspection",
      "required_for_release": true,
      "acceptance": "Coupons, première pièce, CT/CND, métrologie, essais fonctionnels et corrélation simulation-mesure sont approuvés."
    },
    {
      "stage_id": "11_engineering_release",
      "required_for_release": true,
      "acceptance": "Une revue d'ingénierie signée autorise explicitement la fabrication et l'usage visés sur une révision précise."
    }
  ],
  "allowed_stage_statuses": [
    "not_started",
    "completed_screening",
    "passed",
    "blocked_missing_input",
    "not_applicable"
  ],
  "default_stage_statuses": {
    "01_source_and_geometry_authority": "not_started",
    "02_cad_brep_and_mesh_integrity": "not_started",
    "03_full_layer_slicing_and_supports": "not_started",
    "04_material_machine_process_card": "not_started",
    "05_local_melt_pool_thermal": "not_started",
    "06_full_build_thermomechanical_distortion": "not_started",
    "07_recoater_and_support_removal": "not_started",
    "08_omniverse_simready_asset": "not_started",
    "09_omniverse_assembly_function": "not_started",
    "10_physical_correlation_and_inspection": "not_started",
    "11_engineering_release": "not_started"
  },
  "tracked_part_ids": [
