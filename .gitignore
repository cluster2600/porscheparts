.DS_Store
.venv/
.venv-check/
.venv-check-cad/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local exports and manufacturing artefacts
build/
exports/
quotes/
*.gcode
*.bgcode
*.sl1
*.ctb

# Raw scans are large and may have restricted licences.
raw-scans/
*.e57
*.las
*.laz

# Container work directories mounted at /workspace
work/
workspace/
containers/downloads/

# OpenFOAM-generated meshes, processor partitions and time directories
simulation/**/constant/polyMesh/
simulation/**/processor*/
simulation/*/[1-9][0-9][0-9]*/

# Sorties d'execution du modele coque 964 : maillages, jeux CalculiX, resultats.
twins/964-chassis/fea/*.npz
twins/964-chassis/fea/*.inp
twins/964-chassis/fea/*.frd
twins/964-chassis/fea/*.dat
twins/964-chassis/fea/*.sta
twins/964-chassis/fea/*.cvg
twins/964-chassis/fea/*.12d
twins/964-chassis/fea/spooles.out
# Corpus de plan d'experiences : volumineux et regenerable depuis son manifeste.
# Le motif ne vise que les repertoires et les journaux : `corpus*` sans plus
# masquait aussi corpus_audit.py et corpus_repair.py, qui doivent etre versionnes.
twins/964-chassis/fea/corpus*/
twins/964-chassis/fea/corpus*.log
# Repertoires de travail des campagnes : fichiers du solveur, regenerables.
twins/964-chassis/fea/work_*

# .NET build artefacts (never versioned; rebuilt in the PicoGK station container)
bin/
obj/

# M64 wave-2 PicoGK station build artefacts (2026-09-29, lane head-4v)
parts/*/source/picogk/bin/
parts/*/source/picogk/obj/

# Reviewed research reports, distinct from local manufacturing exports.
!docs/research/993-turbo-20261002/exports/
!docs/research/993-turbo-20261002/exports/**

# Regenerable keep-in meshes for bionic topology runs (source/bionic_keepins.py)
parts/*/source/bionic-keepins/

# Gyroid-core variants: tens of MB per part, regenerated from source/gyroid.json
# (provenance and SHA-256 in derived/*-picogk-gyroid.json).
parts/*/derived/*-picogk-gyroid.stl

# Tracked simulation case decks live in models/simulation/ (moved from
# work/simulation/ on 2026-11-09); solver output stays out of Git there too.
# scripts/validate_work_tree_outputs.py refuses any that is committed anyway.
models/simulation/**/postProcessing/
models/simulation/**/processor*/
models/simulation/**/polyMesh/
models/simulation/**/log.*
models/simulation/**/*.log
