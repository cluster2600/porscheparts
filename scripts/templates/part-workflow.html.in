<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>La chaîne de fabrication</title>
<style>
:root{--ink:#192c38;--muted:#58656c;--paper:#f6f5ef;--line:#d8ddda;--accent:#bd4a26;--green:#227451;--amber:#966306}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,a{touch-action:manipulation}button:focus-visible,a:focus-visible{outline:3px solid var(--accent);outline-offset:4px}a{color:inherit;text-underline-offset:3px}button{font:inherit;cursor:pointer}header,main,footer{max-width:1180px;margin:auto;padding:32px}header{padding-top:52px;border-bottom:1px solid var(--line)}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:750;color:var(--accent)}h1{font-size:clamp(32px,5vw,56px);line-height:1.08;letter-spacing:-.04em;max-width:920px;margin:14px 0}h2{font-size:27px;line-height:1.2;margin:0 0 16px}h3{font-size:18px;margin:24px 0 10px}.intro{max-width:800px;color:var(--muted);font-size:18px}.topline{display:flex;justify-content:space-between;gap:24px;align-items:center}.mark{font-weight:800;letter-spacing:-.03em}.small{font-size:13px;color:var(--muted)}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin:30px 0 4px}.metric{border-top:2px solid var(--ink);padding-top:12px}.metric strong{display:block;font-size:26px;letter-spacing:-.04em}.metric span{font-size:13px;color:var(--muted)}.input-row{display:flex;gap:10px;flex-wrap:wrap}.source-button{border:1px solid var(--line);background:transparent;border-radius:4px;padding:10px 16px;min-height:44px;color:var(--ink)}.source-button[aria-pressed=true]{border-color:var(--ink);background:var(--ink);color:var(--paper)}.source-note{min-height:78px;max-width:830px;color:var(--muted);margin-top:14px}.route{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;padding:0;list-style:none;margin:36px 0}.route li{position:relative}.route li:not(:last-child):after{content:"→";position:absolute;right:-16px;top:20px;color:var(--muted)}.stage-button{width:100%;text-align:left;padding:12px 8px 12px 0;border:0;border-top:3px solid var(--line);background:transparent;color:var(--ink);min-height:104px}.stage-button[aria-pressed=true]{border-color:var(--accent)}.stage-number{font-size:12px;color:var(--accent);font-weight:750}.stage-title{display:block;font-size:15px;font-weight:750;margin:5px 0}.state{font-size:11px;letter-spacing:.03em;text-transform:uppercase;color:var(--muted)}.state[data-state=passed]{color:var(--green)}.state[data-state=review]{color:var(--amber)}.stage-panel{border-top:1px solid var(--line);padding-top:28px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:42px}.purpose{font-size:18px;color:var(--muted)}ul{padding-left:20px}li{margin:6px 0}figure{margin:0}figure img{width:100%;height:auto;display:block;background:#eaece7}figcaption{font-size:12px;color:var(--muted);margin-top:9px}.checks{border-collapse:collapse;width:100%;margin:18px 0}.checks td{padding:11px 0;border-bottom:1px solid var(--line);vertical-align:top}.checks td:last-child{text-align:right;font-weight:650;padding-left:18px}.tool-list{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.tool{font-size:12px;padding:3px 8px;background:#e8ece8;border-radius:3px}details{border-top:1px solid var(--line);margin-top:24px;padding-top:12px}summary{cursor:pointer;font-weight:650;min-height:32px}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#e8ece8;padding:16px;font-size:12px;line-height:1.55;border-radius:3px}.deliver{margin-top:52px;padding-top:30px;border-top:1px solid var(--line)}.deliver-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.file-list a{font-size:14px}.action{display:inline-block;padding:10px 16px;background:var(--accent);color:white;text-decoration:none;border-radius:4px;font-weight:650;min-height:44px}.note{color:var(--muted);max-width:850px}footer{border-top:1px solid var(--line);font-size:12px;color:var(--muted);display:flex;justify-content:space-between;gap:30px}.print-only{display:none}@media(max-width:760px){header,main,footer{padding:24px}.metrics{grid-template-columns:repeat(2,1fr)}.route{grid-template-columns:repeat(3,1fr);gap:12px}.route li:nth-child(3):after{content:""}.stage-panel,.deliver-grid{grid-template-columns:1fr;gap:24px}.stage-button{min-height:112px}.topline{align-items:flex-start}.source-note{min-height:105px}}@media print{body{background:white;color:#152733;font-size:10pt}header,main,footer{padding:14px 0;max-width:none}h1{font-size:30pt}.source-button,.route,details{display:none}.source-note{min-height:0}.stage-panel{break-inside:avoid}.print-only{display:block}.metrics{margin-top:20px}.action{background:none;color:inherit;padding:0}footer{font-size:8pt}@page{size:A4;margin:16mm}}
</style>
</head>
<body>
<header>
<div class="topline"><span class="mark">PORSCHEPARTS / ATELIER NUMÉRIQUE</span><span class="small" id="revision"></span></div>
<p class="eyebrow">Un parcours, des fichiers, des résultats</p><h1 id="title"></h1><p class="intro" id="subtitle"></p>
<div class="metrics" id="metrics"></div>
</header>
<main>
<section aria-labelledby="entry-heading"><p class="eyebrow">Le point de départ</p><h2 id="entry-heading">Choisir la référence disponible</h2><div class="input-row" id="input-buttons"></div><p class="source-note" id="source-note"></p></section>
<nav aria-label="Les étapes de fabrication"><ol class="route" id="route"></ol></nav>
<section class="stage-panel" id="stage-panel" aria-live="polite"></section>
<section class="deliver" aria-labelledby="deliver-heading"><p class="eyebrow">La remise</p><h2 id="deliver-heading">Un dossier qui suit la pièce</h2><div class="deliver-grid"><div><p class="note" id="delivery-note"></p><ul class="file-list" id="files"></ul></div><div><h3>Pour le mécanicien</h3><p class="note">La révision, les dimensions de travail, les zones de fixation et les résultats de calcul accompagnent la pièce. Le retour de pose est relié à cette même révision.</p><a class="action" href="guide-atelier.pdf">Ouvrir le guide imprimable</a><p class="small">Les logiciels, commandes et versions sont détaillés dans chaque étape.</p></div></div></section>
</main>
<footer><span id="footer-note"></span><a href="manifest.json">Empreintes des fichiers du dossier</a></footer>
<script id="workflow-data" type="application/json">__WORKFLOW_DATA__</script>
<script>
(() => {
const data=JSON.parse(document.getElementById('workflow-data').textContent);
const element=(tag,text,cls)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e;};
document.title=data.title;document.getElementById('title').textContent=data.title;document.getElementById('subtitle').textContent=data.subtitle;document.getElementById('revision').textContent=data.revision;document.getElementById('delivery-note').textContent=data.delivery_note;document.getElementById('footer-note').textContent=data.footer_note;
for(const metric of data.metrics){const box=element('div',undefined,'metric');box.append(element('strong',metric.value),element('span',metric.label));document.getElementById('metrics').append(box);}
for(const source of data.inputs){const button=element('button',source.title,'source-button');button.type='button';button.setAttribute('aria-pressed','false');button.onclick=()=>{for(const item of document.querySelectorAll('.source-button'))item.setAttribute('aria-pressed',String(item===button));document.getElementById('source-note').textContent=source.description;};document.getElementById('input-buttons').append(button);}
const stageButtons=[];
function showStage(index){const stage=data.stages[index],panel=document.getElementById('stage-panel');panel.replaceChildren();stageButtons.forEach((b,i)=>b.setAttribute('aria-pressed',String(i===index)));const text=element('div');text.append(element('p',`ÉTAPE ${index+1} / ${data.stages.length}`,'eyebrow'),element('h2',stage.title),element('p',stage.purpose,'purpose'));const tools=element('div',undefined,'tool-list');for(const tool of stage.tools)tools.append(element('span',tool,'tool'));text.append(tools);const checks=element('table',undefined,'checks');checks.setAttribute('aria-label','Résultats de cette étape');for(const check of stage.checks){const row=element('tr');row.append(element('td',check.label),element('td',check.value));checks.append(row);}text.append(checks);if(stage.commands.length){const details=element('details'),summary=element('summary','Logiciels et commandes');details.append(summary,element('pre',stage.commands.join('\n\n')));text.append(details);}const visual=element('div');if(stage.image){const figure=element('figure'),image=element('img');image.src=stage.image.path;image.alt=stage.image.alt;figure.append(image,element('figcaption',stage.image.alt));visual.append(figure);}visual.append(element('h3','Ce qui sort de cette étape'));const list=element('ul',undefined,'file-list');for(const file of stage.files){const li=element('li'),link=element('a',file.label);link.href=file.href;li.append(link);list.append(li);}visual.append(list);panel.append(text,visual);}
data.stages.forEach((stage,index)=>{const li=element('li'),button=element('button',undefined,'stage-button');button.type='button';button.append(element('span',String(index+1).padStart(2,'0'),'stage-number'),element('span',stage.title,'stage-title'));const state=element('span',stage.state_label,'state');state.dataset.state=stage.state;button.append(state);button.onclick=()=>showStage(index);button.setAttribute('aria-pressed','false');stageButtons.push(button);li.append(button);document.getElementById('route').append(li);});
for(const file of data.files){const li=element('li'),link=element('a',file.label);link.href=file.href;li.append(link);document.getElementById('files').append(li);}
document.querySelector('.source-button').click();showStage(0);
})();
</script>
</body></html>
