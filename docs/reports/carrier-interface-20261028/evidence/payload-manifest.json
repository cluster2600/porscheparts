{
  "schema_version": 1,
  "recorded_on": "2026-10-29",
  "why": "These derived fields were produced by the committed sources and were going to be committed with them, 76.5 MB in all. Git retains every blob it is given, so they would have stayed in history permanently. Each one's SHA-256 is already recorded in the assessment that uses it, and the producing sources are committed beside it, so the hash and the source carry the provenance the bytes would have carried. The repository keeps the hashes, the array shapes and the results; it does not keep the bytes.",
  "not_withheld": [
    "every assessment, contract, receipt and provenance JSON",
    "every producing and checking source file",
    "the published figures",
    "evidence/geometry/fixed-r24.step.gz, which is editable source geometry rather than a derived field"
  ],
  "reproduction": "evidence/finite-gyroid-001/REPRODUCE.md pins the dependencies, commands and input hashes for the finite-region networks. For the powder-route candidate, evidence/powder-ports-001/replay-receipt.json records a replay whose regenerated archive matched the published SHA-256, so the candidate is reproducible from the committed runner rather than retrievable from git.",
  "total_bytes_withheld": 78631781,
