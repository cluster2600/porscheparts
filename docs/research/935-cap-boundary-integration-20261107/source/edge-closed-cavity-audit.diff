+            extra[start:start+len(part)] |= np.any(part == a, axis=1) & np.any(part == b, axis=1)
+    expected = np.flatnonzero(selected | extra)
+    with np.load(job['closed_selection'], allow_pickle=False) as data:
+        ids = data['cell_ids']
+    assert np.array_equal(ids, expected) and len(ids) > len(initial_ids)
+    selected[:] = False; selected[ids] = True
+    local_cells = cells[ids]
