+/* SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception */
+#ifndef RESEARCH_BUILD_PROFILE_HH
+#define RESEARCH_BUILD_PROFILE_HH
+
+#include <stdexcept>
+#include <string>
+
+namespace adamantine
+{
+inline void require_research_build_profile(
+    int dim, int n_materials, int polynomial_order,
+    std::string const &property_format, std::string const &memory_space,
+    bool ensemble)
+{
+  if (dim != 3 || n_materials != 1 || polynomial_order != 0 ||
+      property_format != "polynomial" || memory_space != "host" || ensemble)
+    throw std::invalid_argument(
+        "Unsupported research build profile: require 3D, one constant "
+        "polynomial material, host memory, and no ensemble simulation.");
+}
+} // namespace adamantine
+#endif
