{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cluster2600/3dprinting993/schemas/part.schema.json",
  "title": "3dprinting993 part record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "part_id",
    "name",
    "description",
    "vehicle",
    "classification",
    "geometry",
    "provenance",
    "manufacturing",
    "titanium",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "part_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "name": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 10 },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "variants", "model_years", "porsche_part_numbers"],
      "properties": {
        "generation": { "const": "993" },
        "variants": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "model_years": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "integer", "minimum": 1993, "maximum": 1998 },
            "to": { "type": "integer", "minimum": 1993, "maximum": 1998 }
          }
        },
        "porsche_part_numbers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "safety_class", "intended_use"],
      "properties": {
        "category": { "type": "string", "minLength": 2 },
        "safety_class": {
          "enum": ["non_critical", "functional", "safety_critical", "prohibited_pending_engineering"]
        },
        "intended_use": { "type": "string", "minLength": 5 }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "master_format", "master_file", "units", "accuracy_mm", "derived_files"],
      "properties": {
        "source_type": { "enum": ["measured", "scan", "reverse_engineered", "public_model", "estimated", "mixed"] },
        "master_format": { "enum": ["FCStd", "OpenSCAD", "STEP", "none"] },
        "master_file": { "type": "string" },
        "units": { "const": "mm" },
        "accuracy_mm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "derived_files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_license", "sources"],
      "properties": {
        "record_license": { "type": "string", "minLength": 3 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url", "source_type", "license", "accessed_on", "notes"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "url": { "type": "string", "format": "uri" },
              "source_type": { "enum": ["official", "manufacturer", "measured", "community", "public_model", "estimated"] },
              "license": { "type": "string", "minLength": 3 },
              "accessed_on": { "type": "string", "format": "date" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "manufacturing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_processes", "preferred_process", "material", "post_processing", "supplier_requirements"],
      "properties": {
        "candidate_processes": {
          "type": "array",
          "items": { "enum": ["FFF", "SLA", "SLS", "MJF", "LPBF", "DMLS", "CNC", "sheet_metal", "casting"] },
          "minItems": 1
        },
        "preferred_process": { "enum": ["FFF", "SLA", "SLS", "MJF", "LPBF", "DMLS", "CNC", "sheet_metal", "casting", "undecided"] },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "grade", "standard"],
          "properties": {
            "family": { "type": "string" },
            "grade": { "type": "string" },
            "standard": { "type": "string" }
          }
        },
        "post_processing": { "type": "array", "items": { "type": "string" } },
        "supplier_requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "titanium": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "alloy", "heat_treatment", "hip_required", "machined_surfaces", "inspection", "galvanic_isolation"],
      "properties": {
        "applicable": { "type": "boolean" },
        "alloy": { "type": "string" },
        "heat_treatment": { "type": "string" },
        "hip_required": { "enum": ["yes", "no", "to_be_determined", "not_applicable"] },
        "machined_surfaces": { "type": "array", "items": { "type": "string" } },
        "inspection": { "type": "array", "items": { "type": "string" } },
        "galvanic_isolation": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "vehicle_tested", "evidence", "reviewed_by", "reviewed_on", "known_limits"],
      "properties": {
        "status": { "enum": ["concept", "dimensionally_reviewed", "prototype_fitted", "functionally_tested", "engineering_reviewed", "released"] },
        "vehicle_tested": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "reviewed_by": { "type": "string" },
        "reviewed_on": { "type": ["string", "null"], "format": "date" },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
