{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cluster2600/3dprinting993/schemas/component.schema.json",
  "title": "3dprinting993 documented physical component",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_id", "name", "kind", "vehicle", "identifiers", "physical", "geometry", "sources", "eligibility"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "component_id": { "type": "string", "pattern": "^COMP-[A-Z0-9][A-Z0-9._-]{2,79}$" },
    "name": { "type": "string", "minLength": 3 },
    "kind": { "enum": ["oem", "aftermarket", "standard", "measured_original"] },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "variants", "model_years", "positions"],
      "properties": {
        "generation": { "const": "993" },
        "variants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "model_years": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "integer" }, "to": { "type": "integer" } } },
        "positions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "identifiers": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["system", "value"], "properties": { "system": { "type": "string" }, "value": { "type": "string" } } } },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_parameters", "mass", "material"],
      "properties": {
        "size_parameters": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["parameter_id", "name", "value", "unit", "source_id"], "properties": { "parameter_id": { "type": "string" }, "name": { "type": "string" }, "value": { "type": "number" }, "unit": { "enum": ["mm", "in", "deg", "count"] }, "source_id": { "type": "string" } } } },
        "mass": { "type": "object", "required": ["value_g", "tolerance_g", "basis", "source_id"], "properties": { "value_g": { "type": "number", "exclusiveMinimum": 0 }, "tolerance_g": { "type": ["number", "null"] }, "basis": { "enum": ["manufacturer", "measured", "official_document"] }, "source_id": { "type": "string" } } },
        "material": { "type": "object", "required": ["family", "grade", "process", "source_id"], "properties": { "family": { "type": "string" }, "grade": { "type": ["string", "null"] }, "process": { "type": "string" }, "source_id": { "type": "string" } } }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "master_format", "master_file", "derived_files", "interface_accuracy_mm", "limitations"],
      "properties": {
        "representation": { "enum": ["interface_proxy", "envelope", "detailed_solid", "scan"] },
        "master_format": { "enum": ["build123d", "FCStd", "STEP", "OpenSCAD", "none"] },
        "master_file": { "type": "string" },
        "derived_files": { "type": "array", "items": { "type": "string" } },
        "interface_accuracy_mm": { "type": ["number", "null"] },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["source_id", "title", "url", "accessed_on", "license", "supports"], "properties": { "source_id": { "type": "string" }, "title": { "type": "string" }, "url": { "type": "string" }, "accessed_on": { "type": "string" }, "license": { "type": "string" }, "supports": { "type": "array", "items": { "type": "string" } } } } },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete_physical_record", "logical_assembly", "spatial_check", "reason"],
      "properties": {
        "complete_physical_record": { "type": "boolean" },
        "logical_assembly": { "type": "boolean" },
        "spatial_check": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    }
  }
}
