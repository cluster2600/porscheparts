{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cluster2600/3dprinting993/schemas/assembly.schema.json",
  "title": "3dprinting993 sourced assembly relationship",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assembly_id", "name", "vehicle", "status", "instances", "physical_summary", "relationship_sources", "known_limits"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "assembly_id": { "type": "string", "pattern": "^ASM-[A-Z0-9][A-Z0-9._-]{2,79}$" },
    "name": { "type": "string", "minLength": 3 },
    "vehicle": { "type": "object", "required": ["generation", "variants"], "properties": { "generation": { "const": "993" }, "variants": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "status": { "enum": ["logical", "positioned", "interface_checked"] },
    "instances": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["instance_id", "component_id", "quantity", "frame", "transform", "relationship_source_id"], "properties": { "instance_id": { "type": "string" }, "component_id": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 }, "frame": { "type": "string" }, "transform": { "type": ["array", "null"], "minItems": 16, "maxItems": 16, "items": { "type": "number" } }, "relationship_source_id": { "type": "string" } } } },
    "physical_summary": { "type": "object", "required": ["mass_g", "basis"], "properties": { "mass_g": { "type": "number", "exclusiveMinimum": 0 }, "basis": { "const": "sum_of_component_records" } } },
    "relationship_sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["source_id", "url", "accessed_on", "claim"], "properties": { "source_id": { "type": "string" }, "url": { "type": "string" }, "accessed_on": { "type": "string" }, "claim": { "type": "string" } } } },
    "known_limits": { "type": "array", "items": { "type": "string" } }
  }
}
