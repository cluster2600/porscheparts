{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cluster2600/3dprinting993/schemas/documentary-specification.schema.json",
  "title": "3dprinting993 documentary specification set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specification_set_id",
    "title",
    "kind",
    "source",
    "records",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "specification_set_id": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "title": { "type": "string", "minLength": 3 },
    "kind": { "enum": ["technical_data", "tightening_torque"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "publisher",
        "retrieved_on",
        "upstream_reviewed_on",
        "method"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9._-]{2,63}$" },
        "url": { "type": "string", "format": "uri" },
        "publisher": { "type": "string", "minLength": 2 },
        "retrieved_on": { "type": "string", "format": "date" },
        "upstream_reviewed_on": { "type": "string", "format": "date" },
        "method": { "const": "derived_facts_from_ocr_transcription" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["record_id", "page", "verification_status"],
        "properties": {
          "record_id": { "type": "string", "pattern": "^[A-Z]{2}-[A-F0-9]{12}$" },
          "page": { "type": "integer", "minimum": 1 },
          "verification_status": { "const": "ocr_transcription_unverified" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}

